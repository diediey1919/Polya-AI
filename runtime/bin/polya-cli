#!/usr/bin/env python3
import sys
import os

# Resolve real path in case called via symlink
real_script = os.path.realpath(__file__)
runtime_dir = os.path.abspath(os.path.join(os.path.dirname(real_script), ".."))
if runtime_dir not in sys.path:
    sys.path.insert(0, runtime_dir)

from polya_runtime.control import main

if __name__ == "__main__":
    main()
