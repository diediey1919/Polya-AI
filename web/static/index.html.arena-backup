    // 2. High-Performance Client-Side Image Compression (HTML5 Canvas)
    function compressImageFile(file, maxWidth = 1280, maxHeight = 1280, quality = 0.82) {
      return new Promise((resolve, reject) => {
        if (!file.type.startsWith('image/')) {
          return reject(new Error('Bukan file gambar'));
        }
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (e) => {
          const img = new Image();
          img.src = e.target.result;
          img.onload = () => {
            let width = img.width;
            let height = img.height;

            if (width > height) {
              if (width > maxWidth) {
                height = Math.round((height * maxWidth) / width);
                width = maxWidth;
              }
            } else {
              if (height > maxHeight) {
                width = Math.round((width * maxHeight) / height);
                height = maxHeight;
              }
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob((blob) => {
              if (!blob) {
                return reject(new Error('Gagal mengompresi gambar'));
              }
              const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                type: 'image/jpeg',
                lastModified: Date.now()
              });
              resolve({
                file: compressedFile,
                originalSize: file.size,
                compressedSize: compressedFile.size,
                previewUrl: canvas.toDataURL('image/jpeg', quality)
              });
            }, 'image/jpeg', quality);
          };
          img.onerror = (err) => reject(err);
        };
        reader.onerror = (err) => reject(err);
      });
    }

    function formatFileSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
    }

    // 3. Post Creation Modal Handling
    function openCreatePostModal(type = 'photo') {
      ensureUser();
      setPostType(type);
      document.getElementById('create-post-modal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeCreatePostModal() {
      document.getElementById('create-post-modal').classList.add('hidden');
      // Reset inputs
      rawSelectedFile = null;
      preparedUploadFile = null;
      document.getElementById('post-file-input').value = '';
      document.getElementById('post-caption-input').value = '';
      document.getElementById('post-tags-input').value = '';
      document.getElementById('post-file-empty-preview').classList.remove('hidden');
      document.getElementById('post-file-preview-wrap').classList.add('hidden');
      document.getElementById('post-image-preview').classList.add('hidden');
      document.getElementById('post-video-preview').classList.add('hidden');
    }

    function setPostType(type) {
      currentPostTypeChoice = type;
      const btnPhoto = document.getElementById('post-type-btn-photo');
      const btnVideo = document.getElementById('post-type-btn-video');
      const btnText = document.getElementById('post-type-btn-text');
      const uploadBox = document.getElementById('post-upload-container');
      const fileInput = document.getElementById('post-file-input');
      const fileLabel = document.getElementById('post-file-label');

      [btnPhoto, btnVideo, btnText].forEach(b => {
        b.className = "py-1.5 rounded-lg font-medium text-gray-400 hover:text-white flex items-center justify-center gap-1 transition cursor-pointer";
      });

      if (type === 'photo') {
        btnPhoto.className = "py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center justify-center gap-1 transition cursor-pointer";
        uploadBox.classList.remove('hidden');
        fileInput.accept = "image/*";
        fileLabel.innerText = "Pilih Foto Naskah / Gambar (Kompresi Otomatis):";
      } else if (type === 'video') {
        btnVideo.className = "py-1.5 rounded-lg font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30 flex items-center justify-center gap-1 transition cursor-pointer";
        uploadBox.classList.remove('hidden');
        fileInput.accept = "video/mp4,video/webm,video/ogg";
        fileLabel.innerText = "Pilih Video / Reels Debat (MP4/WebM):";
      } else {
        btnText.className = "py-1.5 rounded-lg font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 flex items-center justify-center gap-1 transition cursor-pointer";
        uploadBox.classList.add('hidden');
      }
    }

    async function handlePostFileSelected(event) {
      const file = event.target.files[0];
      if (!file) return;

      rawSelectedFile = file;
      const emptyPreview = document.getElementById('post-file-empty-preview');
      const previewWrap = document.getElementById('post-file-preview-wrap');
      const imgPreview = document.getElementById('post-image-preview');
      const vidPreview = document.getElementById('post-video-preview');
      const compInfo = document.getElementById('post-compression-info');

      emptyPreview.classList.add('hidden');
      previewWrap.classList.remove('hidden');

      if (file.type.startsWith('image/')) {
        vidPreview.classList.add('hidden');
        imgPreview.classList.remove('hidden');
        compInfo.innerText = "⏳ Sedang mengompres gambar...";

        try {
          const compResult = await compressImageFile(file);
          preparedUploadFile = compResult.file;
          imgPreview.src = compResult.previewUrl;
          const origStr = formatFileSize(compResult.originalSize);
          const compStr = formatFileSize(compResult.compressedSize);
          const ratio = Math.round((1 - compResult.compressedSize / compResult.originalSize) * 100);
          compInfo.innerText = `⚡ Asli: ${origStr} ➔ Kompres: ${compStr} (Hemat ${ratio > 0 ? ratio : 0}%)`;
        } catch (err) {
          console.error("Compression fallback:", err);
          preparedUploadFile = file;
          imgPreview.src = URL.createObjectURL(file);
          compInfo.innerText = `📁 Ukuran: ${formatFileSize(file.size)}`;
        }
      } else if (file.type.startsWith('video/')) {
        imgPreview.classList.add('hidden');
        vidPreview.classList.remove('hidden');
        preparedUploadFile = file;
        vidPreview.src = URL.createObjectURL(file);
        compInfo.innerText = `🎥 Video Siap Diunggah (${formatFileSize(file.size)})`;
      }
    }

    async function submitCreatePost() {
      ensureUser();
      const caption = document.getElementById('post-caption-input').value.trim();
      const musicSelect = document.getElementById('post-music-select').value;
      const tags = document.getElementById('post-tags-input').value.trim();
      const submitBtn = document.getElementById('post-submit-btn');

      if (!caption && !preparedUploadFile) {
        alert("Harap tulis caption atau pilih file foto/video terlebih dahulu.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i><span>Sedang Membagikan Postingan...</span>';
      lucide.createIcons();

      let mediaUrl = null;
      let mediaType = currentPostTypeChoice;

      try {
        // Upload media file if attached
        if (preparedUploadFile && currentPostTypeChoice !== 'text') {
          const formData = new FormData();
          formData.append('file', preparedUploadFile);
          const uploadRes = await fetch('/api/feed/upload', {
            method: 'POST',
            body: formData
          });
          const uploadData = await uploadRes.json();
          if (uploadData.success && uploadData.url) {
            mediaUrl = uploadData.url;
            mediaType = uploadData.media_type;
          } else {
            throw new Error(uploadData.detail || "Gagal mengunggah media");
          }
        }

        // Parse Music
        let musicTitle = null;
        let musicUrl = null;
        if (musicSelect) {
          const parts = musicSelect.split('|');
          musicTitle = parts[0];
          musicUrl = parts[1] || null;
        }

        // Create Post
        const payload = {
          user_id: currentUser.user_id,
          author_name: currentUser.name,
          author_avatar: currentUser.avatar_url,
          author_badge: 'Debater Komunitas',
          content: caption,
          media_type: mediaType,
          media_url: mediaUrl,
          music_title: musicTitle,
          music_url: musicUrl,
          tags: tags
        };

        const postRes = await fetch('/api/feed/post', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const postData = await postRes.json();

        if (postData.success) {
          closeCreatePostModal();
          await loadSocialFeed(currentFeedTab);
          alert("✨ Postingan berhasil dibagikan ke komunitas!");
        } else {
          alert("Gagal membuat postingan: " + (postData.detail || "Unknown error"));
        }
      } catch (err) {
        console.error("Submit post error:", err);
        alert("Gagal membagikan postingan: " + err.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i data-lucide="send" class="w-4 h-4"></i><span>Bagikan Postingan Sekarang</span>';
        lucide.createIcons();
      }
    }

    // 4. Stories / Status Modal & Viewer Logic
    function openCreateStoryModal() {
      ensureUser();
      document.getElementById('create-story-modal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeCreateStoryModal() {
      document.getElementById('create-story-modal').classList.add('hidden');
      document.getElementById('story-text-input').value = '';
      document.getElementById('story-preview-text').innerText = 'Ketik status Anda di bawah ini...';
    }

    function setStoryGradient(gradientClass) {
      currentStoryBgClass = gradientClass;
      const previewCard = document.getElementById('story-preview-card');
      previewCard.className = `h-56 rounded-2xl bg-gradient-to-tr ${gradientClass} p-5 flex items-center justify-center text-center text-white font-bold text-sm shadow-inner transition-all`;
    }

    async function submitCreateStory() {
      ensureUser();
      const content = document.getElementById('story-text-input').value.trim();
      if (!content) {
        alert("Tulis teks status cerita terlebih dahulu.");
        return;
      }

      try {
        const payload = {
          user_id: currentUser.user_id,
          author_name: currentUser.name,
          author_avatar: currentUser.avatar_url,
          content: content,
          bg_gradient: currentStoryBgClass
        };
        const res = await fetch('/api/feed/stories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          closeCreateStoryModal();
          await loadStories();
          alert("✨ Cerita status berhasil dibagikan!");
        }
      } catch (err) {
        alert("Gagal membagikan cerita: " + err);
      }
    }

    let loadedStoriesList = [];

    async function loadStories() {
      try {
        const res = await fetch('/api/feed/stories');
        const data = await res.json();
        const container = document.getElementById('stories-container');
        if (!container) return;

        loadedStoriesList = data.stories || [];

        // Retain "Tambah Cerita" first button
        const userAvatar = currentUser ? currentUser.avatar_url : 'https://api.dicebear.com/7.x/avataaars/svg?seed=user';
        let html = `
          <div onclick="openCreateStoryModal()" class="flex flex-col items-center gap-1 flex-shrink-0 cursor-pointer group">
            <div class="relative w-14 h-14 rounded-full p-0.5 bg-gradient-to-tr from-purple-500 via-pink-500 to-amber-400 flex items-center justify-center">
              <div class="w-full h-full rounded-full bg-[#10141E] p-0.5 flex items-center justify-center relative overflow-hidden">
                <img id="my-story-avatar" src="${userAvatar}" class="w-full h-full rounded-full object-cover">
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition">
                  <i data-lucide="plus" class="w-5 h-5 text-white font-bold"></i>
                </div>
              </div>
            </div>
            <span class="text-[10px] text-gray-400 font-medium truncate w-14 text-center">Cerita Anda</span>
          </div>
        `;

        loadedStoriesList.forEach((st, idx) => {
          html += `
            <div onclick="openStoryViewer(${idx})" class="flex flex-col items-center gap-1 flex-shrink-0 cursor-pointer group">
              <div class="relative w-14 h-14 rounded-full p-0.5 bg-gradient-to-tr from-pink-500 via-rose-500 to-amber-400 flex items-center justify-center transform group-hover:scale-105 transition shadow-md">
                <div class="w-full h-full rounded-full bg-[#10141E] p-0.5 flex items-center justify-center overflow-hidden">
                  <img src="${st.author_avatar}" class="w-full h-full rounded-full object-cover">
                </div>
              </div>
              <span class="text-[10px] text-gray-300 font-medium truncate w-14 text-center">${st.author_name}</span>
            </div>
          `;
        });

        container.innerHTML = html;
        lucide.createIcons();
      } catch (err) {
        console.warn("Load stories error:", err);
      }
    }

    function openStoryViewer(idx) {
      const story = loadedStoriesList[idx];
      if (!story) return;

      const modal = document.getElementById('story-viewer-modal');
      const card = document.getElementById('story-viewer-card');
      const avatar = document.getElementById('story-viewer-avatar');
      const name = document.getElementById('story-viewer-name');
      const time = document.getElementById('story-viewer-time');
      const content = document.getElementById('story-viewer-content');
      const progFill = document.getElementById('story-progress-fill');

      card.className = `relative w-full max-w-sm h-[80vh] rounded-3xl overflow-hidden shadow-2xl flex flex-col justify-between p-6 bg-gradient-to-tr ${story.bg_gradient || 'from-purple-600 to-indigo-600'}`;
      avatar.src = story.author_avatar;
      name.innerText = story.author_name;
      time.innerText = story.timestamp;
      content.innerText = `"${story.content}"`;

      modal.classList.remove('hidden');
      lucide.createIcons();

      // Animate progress bar (5s duration)
      progFill.style.transition = 'none';
      progFill.style.width = '0%';
      setTimeout(() => {
        progFill.style.transition = 'width 5000ms linear';
        progFill.style.width = '100%';
      }, 50);

      if (storyAutoCloseTimer) clearTimeout(storyAutoCloseTimer);
      storyAutoCloseTimer = setTimeout(() => {
        closeStoryViewer();
      }, 5200);
    }

    function closeStoryViewer() {
      if (storyAutoCloseTimer) clearTimeout(storyAutoCloseTimer);
      document.getElementById('story-viewer-modal').classList.add('hidden');
    }

    // 5. Social Feed Rendering & Filter Tabs
    function switchFeedTab(tab) {
      currentFeedTab = tab;
      const tabs = ['all', 'media', 'video', 'status'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        if (btn) {
          if (t === tab) {
            btn.className = "feed-tab-btn px-3 py-1 rounded-full text-xs font-bold transition bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 cursor-pointer";
          } else {
            btn.className = "feed-tab-btn px-3 py-1 rounded-full text-xs font-medium text-gray-400 hover:text-gray-200 transition bg-white/5 border border-white/5 cursor-pointer";
          }
        }
      });
      loadSocialFeed(tab);
    }

    async function loadSocialFeed(tab = currentFeedTab) {
      const container = document.getElementById('feed-posts-container');
      if (!container) return;

      const dict = i18nDict[currentLanguage] || i18nDict['en'];
      const userIdParam = currentUser ? currentUser.user_id : '';
      try {
        const res = await fetch(`/api/feed?tab=${tab}&user_id=${userIdParam}`);
        const data = await res.json();
        const posts = data.posts || [];

        if (posts.length === 0) {
          container.innerHTML = `
            <div class="glass-panel p-8 rounded-2xl border border-white/5 text-center flex flex-col items-center gap-3">
              <i data-lucide="message-square" class="w-10 h-10 text-gray-600"></i>
              <p class="text-sm font-bold text-gray-400">${dict.no_posts_in_cat || 'No posts in this category yet'}</p>
              <button onclick="openCreatePostModal()" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-gray-950 font-bold text-xs transition cursor-pointer">
                ${dict.be_first_share || 'Be the First to Share'}
              </button>
            </div>
          `;
          lucide.createIcons();
          return;
        }

        container.innerHTML = posts.map(p => renderFeedPostCard(p)).join('');
        lucide.createIcons();
      } catch (err) {
        console.error("Load social feed error:", err);
      }
    }

    function renderFeedPostCard(rawPost) {
      const dict = i18nDict[currentLanguage] || i18nDict['en'];
      const post = {
        post_id: rawPost.post_id || rawPost.id,
        user_id: rawPost.user_id || 'user',
        author_name: rawPost.author_name || rawPost.user_name || 'Debater',
        author_avatar: rawPost.author_avatar || rawPost.user_avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=debater',
        author_badge: rawPost.author_badge || rawPost.user_badge || '🎙️ Debater',
        media_type: rawPost.media_type || 'photo',
        media_url: rawPost.media_url || '',
        content: rawPost.content || rawPost.caption || '',
        music_title: rawPost.music_title || '',
        music_url: rawPost.music_url || '',
        tags: rawPost.tags || '',
        like_count: rawPost.like_count !== undefined ? rawPost.like_count : (rawPost.likes_count || 0),
        comment_count: rawPost.comment_count !== undefined ? rawPost.comment_count : (rawPost.comments_count || 0),
        timestamp: rawPost.timestamp || rawPost.created_at || 'Just now',
        has_liked: Boolean(rawPost.has_liked),
        top_comments: rawPost.top_comments || rawPost.recent_comments || []
      };

      const hasLiked = post.has_liked;
      const likeCount = post.like_count || 0;
      const commentCount = post.comment_count || 0;
      const hasMusic = Boolean(post.music_url && post.music_title);
      const isMusicPlaying = activeFeedMusicPostId === post.post_id;

      // Scripture verse highlight (Multi-lingual)
      let formattedCaption = post.content ? post.content.replace(
        /(Yohanes\s+\d+:\d+|John\s+\d+:\d+|1\s+Korintus\s+\d+:\d+|1\s+Corinthians\s+\d+:\d+|Yesaya\s+\d+:\d+|Isaiah\s+\d+:\d+|Matius\s+\d+:\d+|Matthew\s+\d+:\d+|1\s+Timotius\s+\d+:\d+|1\s+Timothy\s+\d+:\d+|Roma\s+\d+:\d+|Romans\s+\d+:\d+|Ibrani\s+\d+:\d+|Hebrews\s+\d+:\d+|Keluaran\s+\d+:\d+|Exodus\s+\d+:\d+)/gi,
        '<span class="font-bold text-emerald-400 bg-emerald-500/10 px-1 py-0.5 rounded border border-emerald-500/20">$1</span>'
      ) : '';

      return `
        <article class="glass-panel rounded-2xl border border-white/10 overflow-hidden shadow-xl flex flex-col transition hover:border-white/20" id="post-card-${post.post_id}">
          <!-- Post Author Header -->
          <div class="p-3.5 flex items-center justify-between border-b border-white/5 bg-[#0B0E14]/40">
            <div class="flex items-center gap-2.5 cursor-pointer" onclick="openUserProfile('${post.user_id}', '${post.author_name}', '${post.author_avatar}', 'debater')">
              <div class="relative">
                <img src="${post.author_avatar}" class="w-9 h-9 rounded-full border border-emerald-400/50 object-cover">
                <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-400 rounded-full border border-[#10141E]"></span>
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <h4 class="text-xs font-bold text-white hover:underline">${post.author_name}</h4>
                  <span class="px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-300 text-[9px] font-semibold">${post.author_badge}</span>
                </div>
                <p class="text-[10px] text-gray-500">${post.timestamp}</p>
              </div>
            </div>

            <!-- Follow / More Option -->
            <button onclick="openUserProfile('${post.user_id}', '${post.author_name}', '${post.author_avatar}', 'debater')" class="text-gray-400 hover:text-white p-1 rounded-lg">
              <i data-lucide="more-horizontal" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Post Media Container (Double-tap to like) -->
          ${post.media_url ? `
            <div class="relative w-full bg-black/90 flex items-center justify-center overflow-hidden cursor-pointer select-none group" ondblclick="handlePostDoubleTap('${post.post_id}')">
              ${post.media_type === 'video' ? `
                <video src="${post.media_url}" controls playsinline class="w-full max-h-[480px] object-contain"></video>
              ` : `
                <img src="${post.media_url}" class="w-full max-h-[480px] object-contain transition duration-200">
              `}

              <!-- Double-tap Heart Burst Animation Overlay -->
              <div id="heart-burst-${post.post_id}" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 scale-50 transition-all duration-300">
                <i data-lucide="heart" class="w-24 h-24 text-rose-500 fill-rose-500 drop-shadow-2xl"></i>
              </div>
            </div>
          ` : ''}

          <!-- Background Music Bar (Instagram Reels & TikTok Style) -->
          ${hasMusic ? `
            <div class="px-3.5 py-2 bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-transparent border-y border-white/5 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2 overflow-hidden">
                <!-- Rotating Vinyl Disc -->
                <div class="w-6 h-6 rounded-full bg-gray-900 border border-amber-400/50 flex items-center justify-center flex-shrink-0 ${isMusicPlaying ? 'animate-spin' : ''}" style="animation-duration: 4s;">
                  <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                </div>
                <div class="flex items-center gap-1.5 overflow-hidden">
                  <i data-lucide="music-2" class="w-3.5 h-3.5 text-amber-400 flex-shrink-0"></i>
                  <span class="text-[11px] font-medium text-amber-200 truncate">${post.music_title}</span>
                </div>
              </div>
              <button onclick="togglePostMusic('${post.post_id}', '${post.music_url}', '${post.music_title}')" class="flex-shrink-0 px-2.5 py-1 rounded-full bg-amber-400/20 hover:bg-amber-400/30 text-amber-300 font-bold text-[10px] transition cursor-pointer flex items-center gap-1">
                <i data-lucide="${isMusicPlaying ? 'pause' : 'play'}" class="w-3 h-3"></i>
                <span>${isMusicPlaying ? (dict.pause_music || 'Pause') : (dict.play_music || 'Play')}</span>
              </button>
            </div>
          ` : ''}

          <!-- Action Buttons Bar (Like, Comment, Share, Sawer) -->
          <div class="p-3.5 pb-2 flex items-center justify-between text-gray-300">
            <div class="flex items-center gap-3">
              <!-- Like Button -->
              <button onclick="toggleLikePost('${post.post_id}', this)" class="flex items-center gap-1.5 hover:text-rose-400 transition cursor-pointer group" title="Like">
                <i data-lucide="heart" class="w-5 h-5 ${hasLiked ? 'text-rose-500 fill-rose-500' : 'text-gray-300 group-hover:scale-110'} transition"></i>
                <span class="text-xs font-bold ${hasLiked ? 'text-rose-400' : 'text-gray-400'}" id="like-count-${post.post_id}">${likeCount}</span>
              </button>

              <!-- Comment Button (Open Modal Drawer) -->
              <button onclick="openCommentsDrawer('${post.post_id}')" class="flex items-center gap-1.5 hover:text-emerald-400 transition cursor-pointer group" title="Comments">
                <i data-lucide="message-circle" class="w-5 h-5 text-gray-300 group-hover:scale-110 transition"></i>
                <span class="text-xs font-bold text-gray-400" id="comment-count-${post.post_id}">${commentCount}</span>
              </button>

              <!-- Share Button -->
              <button onclick="copyPostLink('${post.post_id}')" class="hover:text-blue-400 transition cursor-pointer" title="Share">
                <i data-lucide="send" class="w-5 h-5"></i>
              </button>
            </div>

            <!-- Direct Sawer Debater Button -->
            <button onclick="openUserProfile('${post.user_id}', '${post.author_name}', '${post.author_avatar}', 'debater')" class="px-2.5 py-1 rounded-lg bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/30 text-amber-300 font-bold text-[11px] transition flex items-center gap-1 cursor-pointer">
              <i data-lucide="gift" class="w-3.5 h-3.5 text-amber-400"></i>
              <span>${dict.sawer_btn || 'Sawer'}</span>
            </button>
          </div>

          <!-- Post Content & Caption -->
          <div class="px-3.5 pb-3 text-xs space-y-1.5">
            <p class="text-gray-200 leading-relaxed break-words">
              <strong class="text-white mr-1.5 cursor-pointer hover:underline" onclick="openUserProfile('${post.user_id}', '${post.author_name}', '${post.author_avatar}', 'debater')">${post.author_name}</strong>
              ${formattedCaption}
            </p>

            ${post.tags ? `
              <div class="flex flex-wrap gap-1.5 pt-0.5">
                ${post.tags.split(' ').map(tag => tag ? `<span class="text-indigo-400 hover:underline cursor-pointer text-[11px] font-medium">${tag.startsWith('#') ? tag : '#' + tag}</span>` : '').join('')}
              </div>
            ` : ''}

            <!-- Inline Comments Preview (Instagram Style) -->
            ${(post.top_comments && post.top_comments.length > 0) ? `
              <div class="pt-2 border-t border-white/5 space-y-1">
                ${commentCount > post.top_comments.length ? `
                  <button onclick="openCommentsDrawer('${post.post_id}')" class="text-[11px] text-gray-400 hover:text-gray-300 cursor-pointer font-medium">
                    ${(dict.view_all_comments || 'View all {count} comments...').replace('{count}', commentCount)}
                  </button>
                ` : ''}
                ${post.top_comments.map(c => `
                  <div class="text-[11px] text-gray-300">
                    <strong class="text-white">${c.user_name || c.author_name}:</strong> ${c.content || c.comment}
                  </div>
                `).join('')}
              </div>
            ` : ''}

            <!-- Quick Inline Comment Box -->
            <div class="pt-2 flex items-center gap-2">
              <input 
                type="text" 
                id="inline-comment-${post.post_id}" 
                placeholder="${dict.quick_comment_placeholder || 'Write a quick comment...'}" 
                class="flex-1 bg-white/5 border border-white/10 rounded-lg px-2.5 py-1 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400"
                onkeydown="if(event.key==='Enter') submitInlineComment('${post.post_id}')"
              >
              <button onclick="submitInlineComment('${post.post_id}')" class="text-emerald-400 hover:text-emerald-300 font-bold text-xs p-1 cursor-pointer">
                ${dict.send_btn || 'Send'}
              </button>
            </div>
          </div>
        </article>
      `;
    }

    // 6. Post Likes & Double-tap Interaction
    async function toggleLikePost(postId, btnEl) {
      ensureUser();
      try {
        const res = await fetch(`/api/feed/like/${postId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: currentUser.user_id })
        });
        const data = await res.json();
        if (data.success) {
          const countEl = document.getElementById(`like-count-${postId}`);
          if (countEl) countEl.innerText = data.like_count;

          // Re-render like heart icon on the card
          if (btnEl) {
            const icon = btnEl.querySelector('i');
            const span = btnEl.querySelector('span');
            if (data.action === 'liked') {
              icon.classList.add('text-rose-500', 'fill-rose-500');
              span.classList.add('text-rose-400');
              span.classList.remove('text-gray-400');
            } else {
              icon.classList.remove('text-rose-500', 'fill-rose-500');
              span.classList.remove('text-rose-400');
              span.classList.add('text-gray-400');
            }
          }
        }
      } catch (err) {
        console.error("Like toggle error:", err);
      }
    }

    function handlePostDoubleTap(postId) {
      const heartBurst = document.getElementById(`heart-burst-${postId}`);
      if (heartBurst) {
        heartBurst.classList.remove('opacity-0', 'scale-50');
        heartBurst.classList.add('opacity-100', 'scale-125');
        setTimeout(() => {
          heartBurst.classList.remove('opacity-100', 'scale-125');
          heartBurst.classList.add('opacity-0', 'scale-50');
        }, 600);
      }
      toggleLikePost(postId);
    }

    function copyPostLink(postId) {
      const url = `${window.location.origin}/#post-${postId}`;
      navigator.clipboard.writeText(url).then(() => {
        alert("🔗 Tautan postingan disalin ke papan klip!");
      });
    }

    // 7. Background Music Controller for Feed Posts
    function togglePostMusic(postId, musicUrl, musicTitle) {
      initAudioContext();
      if (activeFeedMusicAudio && activeFeedMusicPostId === postId) {
        if (!activeFeedMusicAudio.paused) {
          activeFeedMusicAudio.pause();
          activeFeedMusicPostId = null;
        } else {
          activeFeedMusicAudio.play();
          activeFeedMusicPostId = postId;
        }
      } else {
        if (activeFeedMusicAudio) {
          activeFeedMusicAudio.pause();
          activeFeedMusicAudio = null;
        }
        activeFeedMusicAudio = new Audio(musicUrl);
        activeFeedMusicAudio.volume = 0.7;
        activeFeedMusicAudio.loop = true;
        activeFeedMusicAudio.play().catch(e => console.warn("Music play blocked:", e));
        activeFeedMusicPostId = postId;
      }
      // Re-render feed to sync spinning vinyl state
      loadSocialFeed(currentFeedTab);
    }

    // 8. Comments Modal Drawer & Inline Submissions
    async function openCommentsDrawer(postId) {
      ensureUser();
      activeCommentsDrawerPostId = postId;
      const modal = document.getElementById('comments-modal');
      const list = document.getElementById('modal-comments-list');
      list.innerHTML = '<p class="text-gray-500 italic text-center py-6">Memuat komentar...</p>';
      modal.classList.remove('hidden');
      lucide.createIcons();

      try {
        const res = await fetch(`/api/feed/comments/${postId}`);
        const data = await res.json();
        const comments = data.comments || [];

        if (comments.length === 0) {
          list.innerHTML = '<p class="text-gray-500 italic text-center py-6">Belum ada komentar. Jadilah yang pertama berkomentar!</p>';
          return;
        }

        list.innerHTML = comments.map(c => `
          <div class="flex items-start gap-2.5 p-2 rounded-xl bg-white/5 border border-white/5">
            <img src="${c.user_avatar}" class="w-7 h-7 rounded-full border border-white/10 flex-shrink-0 cursor-pointer" onclick="openUserProfile('${c.user_id}', '${c.user_name}', '${c.user_avatar}', 'visitor')">
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <span class="font-bold text-white text-xs cursor-pointer hover:underline" onclick="openUserProfile('${c.user_id}', '${c.user_name}', '${c.user_avatar}', 'visitor')">${c.user_name}</span>
                <span class="text-[9px] text-gray-500">${c.timestamp}</span>
              </div>
              <p class="text-gray-300 text-xs mt-0.5 leading-relaxed break-words">${c.content}</p>
            </div>
          </div>
        `).join('');
      } catch (err) {
        list.innerHTML = '<p class="text-red-400 text-center py-4">Gagal memuat komentar</p>';
      }
    }

    function closeCommentsModal() {
      activeCommentsDrawerPostId = null;
      document.getElementById('comments-modal').classList.add('hidden');
    }

    async function submitCommentFromModal() {
      ensureUser();
      if (!activeCommentsDrawerPostId) return;
      const input = document.getElementById('modal-comment-input');
      const text = input.value.trim();
      if (!text) return;

      try {
        const payload = {
          user_id: currentUser.user_id,
          user_name: currentUser.name,
          user_avatar: currentUser.avatar_url,
          content: text
        };
        const res = await fetch(`/api/feed/comments/${activeCommentsDrawerPostId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          input.value = '';
          await openCommentsDrawer(activeCommentsDrawerPostId);
          // Update comment count on post card
          const cntEl = document.getElementById(`comment-count-${activeCommentsDrawerPostId}`);
          if (cntEl) {
            cntEl.innerText = (parseInt(cntEl.innerText) || 0) + 1;
          }
        }
      } catch (err) {
        alert("Gagal mengirim komentar: " + err);
      }
    }

    async function submitInlineComment(postId) {
      ensureUser();
      const input = document.getElementById(`inline-comment-${postId}`);
      const text = input ? input.value.trim() : '';
      if (!text) return;

      try {
        const payload = {
          user_id: currentUser.user_id,
          user_name: currentUser.name,
          user_avatar: currentUser.avatar_url,
          content: text
        };
        const res = await fetch(`/api/feed/comments/${postId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          input.value = '';
          await loadSocialFeed(currentFeedTab);
        }
      } catch (err) {
        alert("Gagal mengirim komentar: " + err);
      }
    }

    // =========================================================================
    // OFFICIAL DEBATE ARENA 3-VS-3 ENGINE INTEGRATION (PROMPT 16)
    // =========================================================================
    let activeArenaState = null;
    let arenaWs = null;
    let arenaKnownEventIds = new Set();
    let currentArenaView = 'live';

    // View Switching in Arena
    function switchArenaView(viewName) {
      currentArenaView = viewName;
      document.querySelectorAll('.arena-view-container').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.arena-view-tab').forEach(el => {
        el.classList.remove('bg-blue-600', 'text-white', 'font-bold');
        el.classList.add('text-slate-400');
      });

      const targetView = document.getElementById(`view-${viewName}`);
      const targetTab = document.getElementById(`tab-${viewName}`);
      if (targetView) targetView.classList.remove('hidden');
      if (targetTab) {
        targetTab.classList.add('bg-blue-600', 'text-white', 'font-bold');
        targetTab.classList.remove('text-slate-400');
      }
      if (window.lucide) lucide.createIcons();
    }

    // Connect Authoritative Arena WebSocket
    function connectArenaWS() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/api/arena/ws`;
      
      try {
        arenaWs = new WebSocket(wsUrl);
        arenaWs.onopen = () => {
          console.log('[Official Arena WS] Connected to live engine.');
        };
        arenaWs.onmessage = (event) => {
          try {
            const packet = JSON.parse(event.data);
            if (packet.type === 'STATE_UPDATE' && packet.data) {
              renderAuthoritativeState(packet.data);
            }
          } catch (e) {
            console.warn('[Official Arena WS] Parse error:', e);
          }
        };
        arenaWs.onclose = () => {
          console.log('[Official Arena WS] Reconnecting in 3s...');
          setTimeout(connectArenaWS, 3000);
        };
      } catch (err) {
        console.warn('[Official Arena WS] Connection error:', err);
      }
    }

    // Fetch REST Full State
    async function fetchArenaState() {
      try {
        const res = await fetch('/api/arena/state');
        if (res.ok) {
          const state = await res.json();
          renderAuthoritativeState(state);
        }
      } catch (err) {
        console.warn('[Official Arena REST] Error fetching state:', err);
      }
    }

    // Send Operator Action to Backend
    async function sendArenaAction(action, payload = {}) {
      const speakerId = activeArenaState?.speaker?.active_id || 'P1';
      const body = { action, speaker_id: speakerId, payload };
      
      if (arenaWs && arenaWs.readyState === WebSocket.OPEN) {
        arenaWs.send(JSON.stringify(body));
      } else {
        const res = await fetch('/api/arena/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.ok) {
          const json = await res.json();
          if (json.state) renderAuthoritativeState(json.state);
        }
      }
    }

    // Load Golden Match 001 Fixture
    async function loadGoldenMatch() {
      try {
        const res = await fetch('/api/arena/golden_match', { method: 'POST' });
        if (res.ok) {
          const json = await res.json();
          if (json.state) {
            renderAuthoritativeState(json.state);
            switchArenaView('verdict');
          }
        }
      } catch (err) {
        console.warn('Error loading Golden Match:', err);
      }
    }

    // Submit Speech Simulation
    function submitSimSpeech() {
      const input = document.getElementById('simSpeechInput');
      if (!input) return;
      const text = input.value.trim();
      if (!text) return;
      sendArenaAction('SUBMIT_SPEECH', { text, register_argument: true });
      input.value = '';
    }

    // Toggle Degraded State Simulator
    async function toggleDegradedSimulation() {
      const isDegradedNow = activeArenaState?.degraded?.is_degraded || false;
      await fetch('/api/arena/degraded', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ component: 'analytics', enabled: !isDegradedNow })
      });
      fetchArenaState();
    }

    // Reset Match
    async function resetArenaMatch() {
      await fetch('/api/arena/reset', { method: 'POST' });
      fetchArenaState();
    }

    // MASTER AUTHORITATIVE STATE RENDERER
    function renderAuthoritativeState(state) {
      if (!state) return;
      activeArenaState = state;

      // 1. Topic & Match Status
      const headlineEl = document.getElementById('topicHeadline');
      const descEl = document.getElementById('topicDescription');
      const statusEl = document.getElementById('matchStatusText');
      if (headlineEl) headlineEl.innerText = state.topic || 'Debate Arena';
      if (descEl) descEl.innerText = state.topic_description || '';
      if (statusEl) statusEl.innerText = state.status || 'SETUP';

      // 2. Round Info
      const roundEl = document.getElementById('roundNameDisplay');
      if (roundEl && state.round) {
        roundEl.innerText = `${state.round.name || state.round.phase}`;
      }

      // 3. Master Timer
      const timerDisplayEl = document.getElementById('timerDisplay');
      const tStateBadge = document.getElementById('timerStateBadge');
      if (timerDisplayEl && state.timer) {
        timerDisplayEl.innerText = state.timer.formatted || '00:00';
      }
      if (tStateBadge && state.timer) {
        tStateBadge.innerText = state.timer.state;
        if (state.timer.state === 'CRITICAL') {
          tStateBadge.className = 'text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-red-500/30 text-red-300 border border-red-500/50 animate-pulse';
        } else if (state.timer.state === 'WARNING') {
          tStateBadge.className = 'text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-yellow-500/30 text-yellow-300 border border-yellow-500/50';
        } else if (state.timer.state === 'EXPIRED') {
          tStateBadge.className = 'text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-red-900 text-white border border-red-500';
        } else {
          tStateBadge.className = 'text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 border border-blue-500/30';
        }
      }

      // 4. Active Speaker & Teams Presentation (6 Human Debaters)
      const currentSpkId = state.speaker?.active_id;
      const isPropSpeaker = currentSpkId && currentSpkId.startsWith('P');
      const isOppSpeaker = currentSpkId && currentSpkId.startsWith('C');

      const spkNameEl = document.getElementById('activeSpeakerName');
      const spkRoleEl = document.getElementById('activeSpeakerRole');
      const spkAvatarEl = document.getElementById('speakerAvatar');
      const spkTeamBadge = document.getElementById('activeSpeakerTeamBadge');

      if (spkNameEl && state.speaker) spkNameEl.innerText = state.speaker.name || 'NO ACTIVE SPEAKER';
      if (spkRoleEl && state.speaker) spkRoleEl.innerText = state.speaker.role || '';
      if (spkAvatarEl) {
        spkAvatarEl.innerText = currentSpkId || '--';
        if (isPropSpeaker) {
          spkAvatarEl.className = 'w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-600 border-2 border-blue-400 flex items-center justify-center font-black text-white text-xl shadow-xl shadow-blue-500/20';
        } else if (isOppSpeaker) {
          spkAvatarEl.className = 'w-14 h-14 rounded-2xl bg-gradient-to-tr from-red-700 to-rose-600 border-2 border-red-400 flex items-center justify-center font-black text-white text-xl shadow-xl shadow-red-500/20';
        } else {
          spkAvatarEl.className = 'w-14 h-14 rounded-2xl bg-gradient-to-tr from-slate-700 to-slate-800 border-2 border-slate-500 flex items-center justify-center font-black text-white text-xl shadow-xl';
        }
      }

      if (spkTeamBadge) {
        if (isPropSpeaker) {
          spkTeamBadge.className = 'px-2.5 py-0.5 text-[9px] font-black uppercase rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/40 tracking-wider';
          spkTeamBadge.innerText = 'PROPOSITION';
        } else if (isOppSpeaker) {
          spkTeamBadge.className = 'px-2.5 py-0.5 text-[9px] font-black uppercase rounded-full bg-red-500/20 text-red-300 border border-red-500/40 tracking-wider';
          spkTeamBadge.innerText = 'OPPOSITION';
        } else {
          spkTeamBadge.className = 'px-2.5 py-0.5 text-[9px] font-black uppercase rounded-full bg-slate-700 text-slate-300 tracking-wider';
          spkTeamBadge.innerText = state.speaker?.active_team || 'EVENT CONTROL';
        }
      }

      // Update Debater Names & Roles dynamically
      const allDebaters = [
        ...(state.teams?.proposition?.debaters || []),
        ...(state.teams?.opposition?.debaters || [])
      ];
      allDebaters.forEach(d => {
        const card = document.getElementById(`debater-card-${d.speaker_id}`);
        if (!card) return;
        const nameEl = card.querySelector('.debater-name');
        const roleEl = card.querySelector('.debater-role');
        if (nameEl && d.name) nameEl.innerText = `${d.speaker_id} (${d.name})`;
        if (roleEl && d.role) roleEl.innerText = d.role;
        if (d.speaker_id === 'P1') {
          const btnUser = document.getElementById('donate-btn-user-P1');
          if (btnUser && d.name) btnUser.innerText = `${d.speaker_id} — ${d.name}`;
        }
        if (d.speaker_id === 'C1') {
          const btnUser = document.getElementById('donate-btn-user-C1');
          if (btnUser && d.name) btnUser.innerText = `${d.speaker_id} — ${d.name}`;
        }
      });

      // Update Debater Cards Spotlight & Subdued States
      ['P1', 'P2', 'P3', 'C1', 'C2', 'C3'].forEach(spkId => {
        const card = document.getElementById(`debater-card-${spkId}`);
        if (!card) return;
        const isSpeaking = (spkId === currentSpkId);
        const isProp = spkId.startsWith('P');
        const badge = card.querySelector('.speaker-state-badge');
        
        if (isSpeaking) {
          card.classList.remove('subdued-debater');
          card.classList.add(isProp ? 'live-speaking-prop' : 'live-speaking-opp');
          if (badge) badge.classList.remove('hidden');
        } else {
          card.classList.add('subdued-debater');
          card.classList.remove('live-speaking-prop', 'live-speaking-opp');
          if (badge) badge.classList.add('hidden');
        }
      });

      // Update Live Speech Transcript
      const activeSpeechEl = document.getElementById('activeSpeechText');
      const wordCountEl = document.getElementById('liveSpeechWordCount');
      const activeDebaterObj = state.teams?.proposition?.debaters?.find(d => d.speaker_id === currentSpkId) ||
                               state.teams?.opposition?.debaters?.find(d => d.speaker_id === currentSpkId);
      if (activeSpeechEl && activeDebaterObj && activeDebaterObj.last_speech) {
        activeSpeechEl.innerText = `"${activeDebaterObj.last_speech}"`;
      }
      if (wordCountEl) {
        if (activeDebaterObj && activeDebaterObj.last_speech) {
          const words = activeDebaterObj.last_speech.trim().split(/\s+/).filter(Boolean).length;
          wordCountEl.innerText = `● ${words} WORDS`;
        } else {
          wordCountEl.innerText = currentSpkId ? '● SPEAKING LIVE' : '● IDLE';
        }
      }

      // 5. Active Strategic Argument
      if (state.active_argument) {
        const argIdEl = document.getElementById('argId');
        const argClaimEl = document.getElementById('argClaimText');
        const argStatusEl = document.getElementById('argStatusBadge');
        const argResEl = document.getElementById('argResilience');
        const argAttEl = document.getElementById('argAttacksCount');
        if (argIdEl) argIdEl.innerText = state.active_argument.argument_id;
        if (argClaimEl) argClaimEl.innerText = state.active_argument.claim;
        if (argStatusEl) argStatusEl.innerText = state.active_argument.status;
        if (argResEl) argResEl.innerText = `Resilience: ${state.active_argument.resilience}`;
        if (argAttEl) argAttEl.innerText = `Attacks: ${state.active_argument.attacks_count} | Defenses: ${state.active_argument.defenses_count}`;
      }

      // 6. Active Critical Clash
      if (state.active_clashes && state.active_clashes.length > 0) {
        const topClash = state.active_clashes[0];
        const clashTitleEl = document.getElementById('clashTitle');
        const clashQEl = document.getElementById('clashQuestion');
        const clashStatusEl = document.getElementById('clashStatus');
        const clashAdvEl = document.getElementById('clashAdvantageBadge');
        if (clashTitleEl) clashTitleEl.innerText = topClash.title;
        if (clashQEl) clashQEl.innerText = topClash.question;
        if (clashStatusEl) clashStatusEl.innerText = `Status: ${topClash.status}`;
        if (clashAdvEl) clashAdvEl.innerText = topClash.advantage.replace('_', ' ');
      }

      // 7. Evidence & Fact Checks
      if (state.active_evidence && state.active_evidence.length > 0) {
        const topEv = state.active_evidence[state.active_evidence.length - 1];
        const evTitleEl = document.getElementById('evidenceSourceTitle');
        const evQuoteEl = document.getElementById('evidenceQuotedText');
        const evAuthorEl = document.getElementById('evidenceAuthor');
        const evConfEl = document.getElementById('evidenceConfidence');
        const evStatusEl = document.getElementById('evidenceStatusBadge');
        const evCountEl = document.getElementById('evidenceCountBadge');
        if (evTitleEl) evTitleEl.innerText = topEv.source_title;
        if (evQuoteEl) evQuoteEl.innerText = `"${topEv.quoted_text}"`;
        if (evAuthorEl) evAuthorEl.innerText = `${topEv.author} (${topEv.year})`;
        if (evConfEl) evConfEl.innerText = `Confidence: ${topEv.confidence}`;
        if (evStatusEl) evStatusEl.innerText = topEv.status;
        if (evCountEl) evCountEl.innerText = `${state.active_evidence.length} VERIFIED SOURCES`;
      }

      // 8. Momentum Bar
      if (state.momentum) {
        const score = state.momentum.score || 0;
        const propPercent = Math.min(Math.max(50 + (score * 2), 5), 95);
        const oppPercent = 100 - propPercent;
        const propBar = document.getElementById('propMomentumBar');
        const oppBar = document.getElementById('oppMomentumBar');
        const propVal = document.getElementById('propMomentumVal');
        const oppVal = document.getElementById('oppMomentumVal');
        const leaderText = document.getElementById('momentumLeaderText');
        
        if (propBar) propBar.style.width = `${propPercent}%`;
        if (oppBar) oppBar.style.width = `${oppPercent}%`;
        if (propVal) propVal.innerText = score > 0 ? `+${score}` : '0.0';
        if (oppVal) oppVal.innerText = score < 0 ? `${score}` : '-0.0';
        if (leaderText) leaderText.innerText = `${state.momentum.leader} CONTROL`;
      }

      // 9. AI Moderator & Referee Feed
      if (state.ai_event_control) {
        const modEl = document.getElementById('modLastMessage');
        const refCountEl = document.getElementById('refereeViolationsCount');
        if (modEl && state.ai_event_control.moderator) {
          modEl.innerText = `"${state.ai_event_control.moderator.last_message}"`;
        }
        if (refCountEl && state.ai_event_control.referee) {
          const violationsCount = state.ai_event_control.referee.violations?.length || 0;
          refCountEl.innerText = `${violationsCount} FLAGS`;
        }
      }

      // 10. Commentary Stream
      if (state.ai_event_control?.commentary?.feed) {
        const cFeed = document.getElementById('commentaryFeed');
        if (cFeed) {
          cFeed.innerHTML = '';
          state.ai_event_control.commentary.feed.forEach(c => {
            const div = document.createElement('div');
            div.className = 'p-1.5 rounded bg-studio-900/80 border border-studio-700 text-xs';
            div.innerHTML = `<span class="text-indigo-400 font-bold uppercase text-[8px] block">${c.type}</span>${c.text}`;
            cFeed.appendChild(div);
          });
        }
      }

      // 11. Immutable Event Log
      if (state.event_log) {
        const logFeed = document.getElementById('liveEventFeed');
        if (logFeed) {
          state.event_log.forEach(e => {
            if (!arenaKnownEventIds.has(e.event_id)) {
              arenaKnownEventIds.add(e.event_id);
              const row = document.createElement('div');
              row.className = 'flex items-center justify-between py-0.5 border-b border-studio-800 text-[10px]';
              row.innerHTML = `
                <span class="text-slate-400">${new Date(e.timestamp * 1000).toLocaleTimeString()}</span>
                <span class="text-indigo-300 font-bold">[${e.event_type}]</span>
                <span class="text-slate-300 truncate max-w-xs sm:max-w-md">${e.summary}</span>
              `;
              logFeed.insertBefore(row, logFeed.firstChild);
            }
          });
        }
      }

      // 12. Verdict View
      if (state.verdict) {
        const winBanner = document.getElementById('verdictWinnerBanner');
        const marginEl = document.getElementById('verdictMarginText');
        const pScoreEl = document.getElementById('verdictPropScore');
        const oScoreEl = document.getElementById('verdictOppScore');
        if (winBanner) winBanner.innerText = `${state.verdict.winner} WINS`;
        if (marginEl) marginEl.innerText = `Victory Margin: +${state.verdict.margin} Points`;
        if (pScoreEl) pScoreEl.innerText = state.verdict.proposition_total;
        if (oScoreEl) oScoreEl.innerText = state.verdict.opposition_total;

        const whyList = document.getElementById('verdictWhyList');
        if (whyList && state.verdict.why_they_won) {
          whyList.innerHTML = '';
          state.verdict.why_they_won.forEach(w => {
            const item = document.createElement('div');
            item.className = 'p-2 rounded bg-studio-900/80 border border-studio-700';
            item.innerHTML = `<div class="font-bold text-emerald-400 text-xs">${w.title}</div><div class="text-slate-300 text-[10px] mt-0.5">${w.description}</div>`;
            whyList.appendChild(item);
          });
        }
      }

      // Awards List
      if (state.awards) {
        const awardsList = document.getElementById('verdictAwardsList');
        if (awardsList) {
          awardsList.innerHTML = '';
          state.awards.forEach(a => {
            const card = document.createElement('div');
            card.className = 'p-2 rounded bg-studio-900/80 border border-studio-700';
            card.innerHTML = `<div class="text-[8px] uppercase font-bold text-yellow-400">${a.award}</div><div class="text-white font-bold text-xs mt-0.5">${a.recipient}</div>`;
            awardsList.appendChild(card);
          });
        }
      }

      // 13. Forensics & ZUMA
      if (state.forensics?.zuma_persona) {
        const zScore = document.getElementById('zumaAlignmentScore');
        if (zScore) zScore.innerText = `${state.forensics.zuma_persona.alignment_percentage}% ALIGNED`;
      }

      // 14. Battle Map Canvas
      if (state.forensics?.battle_map?.nodes) {
        const canvas = document.getElementById('battleMapCanvas');
        if (canvas) {
          canvas.innerHTML = '';
          state.forensics.battle_map.nodes.forEach(n => {
            const div = document.createElement('div');
            const isProp = n.team === 'PROPOSITION';
            div.className = `p-2.5 rounded-lg border ${isProp ? 'bg-blue-950/40 border-blue-500/40' : 'bg-red-950/40 border-red-500/40'} flex items-center justify-between text-xs`;
            div.innerHTML = `
              <div>
                <span class="font-mono font-bold ${isProp ? 'text-blue-400' : 'text-red-400'}">${n.id}</span>
                <span class="text-slate-200 ml-2 font-semibold">${n.label}</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-studio-900 border border-studio-700 text-slate-300">${n.status}</span>
            `;
            canvas.appendChild(div);
          });
        }
      }

      // 15. Degraded Banner
      const degBanner = document.getElementById('degradedBanner');
      if (degBanner) {
        if (state.degraded?.is_degraded) {
          degBanner.classList.remove('hidden');
        } else {
          degBanner.classList.add('hidden');
        }
      }

      if (window.lucide) lucide.createIcons();
    }

    // Auto-init feed, stories, and Official Arena on load
    document.addEventListener('DOMContentLoaded', () => {
      setAppTheme(currentAppTheme);
      loadStories();
      loadSocialFeed();
      fetchArenaState();
      connectArenaWS();
      setInterval(fetchArenaState, 4000);
      if (window.lucide) lucide.createIcons();
    });
    // In case DOM is already loaded
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setAppTheme(currentAppTheme);
      loadStories();
      loadSocialFeed();
      fetchArenaState();
      connectArenaWS();
      if (window.lucide) lucide.createIcons();
    }
  </script>
</body>
</html>
