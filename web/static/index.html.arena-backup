    // 5 Theme Color Presets Engine
    const themeConfigs = {
      1: { name: "1. Neon Obsidian", class: "theme-1", activeBtnClass: "bg-emerald-500/20 text-emerald-300 border-emerald-500/40" },
      2: { name: "2. Sapphire Titanium", class: "theme-2", activeBtnClass: "bg-sky-500/20 text-sky-300 border-sky-500/40" },
      3: { name: "3. Royal Gold & Onyx", class: "theme-3", activeBtnClass: "bg-amber-500/20 text-amber-300 border-amber-500/40" },
      4: { name: "4. Forest Matrix", class: "theme-4", activeBtnClass: "bg-emerald-600/20 text-emerald-300 border-emerald-600/40" },
      5: { name: "5. Crimson Eclipse", class: "theme-5", activeBtnClass: "bg-rose-500/20 text-rose-300 border-rose-500/40" }
    };

    let currentAppTheme = parseInt(localStorage.getItem('polya_theme') || '1');

    function setAppTheme(num) {
      if (!themeConfigs[num]) num = 1;
      currentAppTheme = num;
      localStorage.setItem('polya_theme', num);

      document.body.classList.remove('theme-1', 'theme-2', 'theme-3', 'theme-4', 'theme-5');
      document.body.classList.add(`theme-${num}`);

      const label = document.getElementById('theme-active-label');
      if (label) label.innerText = themeConfigs[num].name;

      for (let i = 1; i <= 5; i++) {
        const btn = document.getElementById(`theme-btn-${i}`);
        if (!btn) continue;
        if (i === num) {
          btn.className = `py-1 rounded-lg text-center font-bold text-xs ${themeConfigs[i].activeBtnClass} border hover:scale-105 transition cursor-pointer`;
        } else {
          btn.className = "py-1 rounded-lg text-center font-bold text-xs bg-white/5 text-gray-400 border border-white/10 hover:scale-105 transition cursor-pointer";
        }
      }
    }

