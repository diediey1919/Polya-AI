    function openLanguageModal() {
      const modal = document.getElementById('language-modal');
      if (modal) modal.classList.remove('hidden');
      updateLangModalUI();
      lucide.createIcons();
    }

    function closeLanguageModal() {
      const modal = document.getElementById('language-modal');
      if (modal) modal.classList.add('hidden');
    }

    function setLanguage(lang) {
      currentLanguage = lang;
      localStorage.setItem('polya_lang', lang);
      applyTranslations(lang);
      updateLangModalUI();
      closeLanguageModal();
    }

    function updateLangModalUI() {
      const langs = ['en', 'id', 'es', 'fr', 'de', 'pt', 'ru', 'ja', 'ko', 'zh', 'hi', 'tr', 'ar', 'el', 'he'];
      langs.forEach(l => {
        const optBtn = document.getElementById(`lang-opt-${l}`);
        const checkIcon = document.getElementById(`lang-check-${l}`);
        if (optBtn && checkIcon) {
          if (l === currentLanguage) {
            optBtn.className = "w-full flex items-center justify-between p-2.5 rounded-xl border border-indigo-500/50 bg-indigo-500/10 transition text-left cursor-pointer group";
            checkIcon.classList.remove('hidden');
          } else {
            optBtn.className = "w-full flex items-center justify-between p-2.5 rounded-xl border border-white/10 hover:border-indigo-400 bg-white/5 transition text-left cursor-pointer group";
            checkIcon.classList.add('hidden');
          }
        }
      });
      const navBadge = document.getElementById('nav-lang-badge');
      if (navBadge) {
        const langMap = { 
          en: '🌐 English (EN)', 
          id: '🇮🇩 Indonesia (ID)', 
          es: '🇪🇸 Español (ES)',
          fr: '🇫🇷 Français (FR)',
          de: '🇩🇪 Deutsch (DE)',
          pt: '🇧🇷 Português (PT)',
          ru: '🇷🇺 Русский (RU)',
          ja: '🇯🇵 日本語 (JA)',
          ko: '🇰🇷 한국어 (KO)',
          zh: '🇨🇳 中文 (ZH)',
          hi: '🇮🇳 हिन्दी (HI)',
          tr: '🇹🇷 Türkçe (TR)',
          ar: '🇸🇦 العربية (AR)', 
          el: '🇬🇷 Ελληνικά (EL)', 
          he: '🇮🇱 עברית (HE)' 
        };
        navBadge.innerText = langMap[currentLanguage] || '🌐 English (EN)';
      }
    }

    function applyTranslations(lang = currentLanguage) {
      const dict = i18nDict[lang] || i18nDict['en'];
      
      document.documentElement.lang = lang;
      if (lang === 'ar' || lang === 'he') {
        document.documentElement.setAttribute('dir', 'rtl');
      } else {
        document.documentElement.removeAttribute('dir');
      }

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) {
          el.innerText = dict[key];
        }
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (dict[key]) {
          el.placeholder = dict[key];
        }
      });

      document.querySelectorAll('[data-i18n-title]').forEach(el => {
        const key = el.getAttribute('data-i18n-title');
        if (dict[key]) {
          el.title = dict[key];
        }
      });

      const freeModeText = document.getElementById('free-mode-btn-text');
      if (freeModeText) {
        const isFree = freeModeText.innerText.includes('ON') || freeModeText.innerText.includes('♾️');
        freeModeText.innerText = isFree ? dict.free_mode_on : dict.free_mode_off;
      }

      const audioToggleText = document.getElementById('audio-toggle-text');
      if (audioToggleText) {
        audioToggleText.innerText = audioMasterEnabled ? dict.sound_on : dict.sound_mute;
      }

      const micText = document.getElementById('mic-status-text');
      if (micText && !isMicActive) {
        micText.innerText = dict.mic_off;
      }

      updateLangModalUI();
      if (typeof renderStageGrid === 'function' && currentSeats && currentSeats.length > 0) {
        renderStageGrid(currentSeats, true);
      }
    }

    // -------------------------------------------------------------------------
    // Web Audio Synthesizer & TTS Engine (Visitor Audio Unlock & Mixer)
    // -------------------------------------------------------------------------
    let isAudioEngineUnlocked = false;

    function initAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      isAudioEngineUnlocked = true;
      hideAudioUnlockBanner();
    }

    function unlockAudioEngine() {
      initAudioContext();
      // Resume any queued audio for visitors
      speakerQueues.forEach((speaker, senderId) => {
        if (!speaker.isPlaying && speaker.queue.length > 0) {
          playNextInSpeakerQueue(senderId);
        }
      });
    }

    function showAudioUnlockBanner() {
      const banner = document.getElementById('visitor-audio-unlock-banner');
      if (banner && !isAudioEngineUnlocked) {
        banner.classList.remove('hidden');
      }
    }

    function hideAudioUnlockBanner() {
      const banner = document.getElementById('visitor-audio-unlock-banner');
      if (banner) {
        banner.classList.add('hidden');
      }
    }

    // Auto-unlock audio on any user gesture across window
    ['click', 'touchstart', 'touchend', 'mousedown', 'keydown'].forEach(evt => {
      window.addEventListener(evt, () => unlockAudioEngine(), { passive: true });
    });

    function toggleAudioMaster() {
      unlockAudioEngine();
      audioMasterEnabled = !audioMasterEnabled;
      const btnText = document.getElementById('audio-toggle-text');
      const btnIcon = document.getElementById('audio-toggle-icon');
      const btn = document.getElementById('audio-toggle-btn');
      const dict = i18nDict[currentLanguage] || i18nDict['en'];

      if (audioMasterEnabled) {
        btnText.innerText = dict.sound_on;
        btnIcon.setAttribute('data-lucide', 'volume-2');
        btnIcon.className = "w-3.5 h-3.5 text-emerald-400";
        btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-xs text-emerald-400 font-medium transition cursor-pointer";
        playPopSound();
      } else {
        btnText.innerText = dict.sound_mute;
        btnIcon.setAttribute('data-lucide', 'volume-x');
        btnIcon.className = "w-3.5 h-3.5 text-red-400";
        btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 text-xs text-red-400 font-medium transition cursor-pointer";
        if (currentPlayingAudio) {
          try {
            currentPlayingAudio.pause();
            currentPlayingAudio = null;
          } catch (e) {}
        }
      }
      lucide.createIcons();
    }

    // All synthetic beep/oscillator sounds completely disabled per user instruction
    function playSawerChime() {}
    function playPopSound() {}
    function playMicOnSound() {}
    function playMicOffSound() {}
    function playPingSound() {}

    // =========================================================================
    // Gapless Web Audio API Simultaneous Mixer (Sample-Accurate Zero Gap)
    // =========================================================================
    const speakerTimelines = new Map(); // senderId -> nextScheduledTime
    const speakerPcmTimelines = new Map(); // senderId -> nextScheduledTime

    function playPcmStreamChunk(speakerId, pcmBase64, sampleRate) {
      if (!audioMasterEnabled || !pcmBase64) return;
      initAudioContext();
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      try {
        const binaryString = window.atob(pcmBase64);
        const len = binaryString.length;
        const bytes = new Uint8Array(len);
        for (let i = 0; i < len; i++) {
          bytes[i] = binaryString.charCodeAt(i);
        }
        const int16 = new Int16Array(bytes.buffer);
        const float32 = new Float32Array(int16.length);
        for (let i = 0; i < int16.length; i++) {
          float32[i] = int16[i] / 32768.0;
        }

        const rate = sampleRate || (audioCtx ? audioCtx.sampleRate : 44100);
        const buffer = audioCtx.createBuffer(1, float32.length, rate);
        buffer.copyToChannel(float32, 0, 0);

        const now = audioCtx.currentTime;
        let nextTime = speakerPcmTimelines.get(speakerId) || 0;

        if (nextTime < now) {
          nextTime = now + 0.02; // Minimal 20ms jitter buffer for seamless voice continuity
        }

        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.connect(audioCtx.destination);
        source.start(nextTime);

        speakerPcmTimelines.set(speakerId, nextTime + buffer.duration);
      } catch (e) {
        console.warn("PCM play notice:", e);
      }
    }

    function base64ToArrayBuffer(base64) {
      const clean = base64.includes(',') ? base64.split(',')[1] : base64;
      const binaryString = window.atob(clean);
      const len = binaryString.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) {
        bytes[i] = binaryString.charCodeAt(i);
      }
      return bytes.buffer;
    }

    async function enqueueAndPlaySpeakerAudio(senderId, base64Audio) {
      if (!audioMasterEnabled || !base64Audio) return;
      initAudioContext();

      const key = senderId || 'default_speaker';

      try {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (AudioContextClass) audioCtx = new AudioContextClass();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          await audioCtx.resume();
        }

        const arrayBuffer = base64ToArrayBuffer(base64Audio);
        // Decode audio data to raw PCM buffer
        const audioBuffer = await new Promise((resolve, reject) => {
          audioCtx.decodeAudioData(arrayBuffer, resolve, reject);
        });

        const currentTime = audioCtx.currentTime;
        let nextTime = speakerTimelines.get(key) || 0;

        // If timeline lagged behind or starting fresh, add minimal 30ms jitter buffer
        if (nextTime < currentTime) {
          nextTime = currentTime + 0.03;
        }

        const sourceNode = audioCtx.createBufferSource();
        sourceNode.buffer = audioBuffer;

        const gainNode = audioCtx.createGain();
        gainNode.gain.setValueAtTime(1.0, audioCtx.currentTime);

        sourceNode.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        sourceNode.start(nextTime);
        speakerTimelines.set(key, nextTime + audioBuffer.duration);

      } catch (err) {
        console.warn("Web Audio API gapless decode fallback notice:", err);
        // Fallback to basic audio element if decode failed
        fallbackAudioPlay(base64Audio);
      }
    }

    function fallbackAudioPlay(base64Audio) {
      try {
        const audio = new Audio(base64Audio);
        audio.volume = 1.0;
        audio.play().catch(e => {
          showAudioUnlockBanner();
        });
      } catch (e) {}
    }

    function playRawVoiceAudio(base64Audio) {
      enqueueAndPlaySpeakerAudio('direct_audio', base64Audio);
    }

    async function fetchGeminiTTSAndPlay(text) {
      if (!audioMasterEnabled || !text) return;
      initAudioContext();
      try {
        const res = await fetch('/api/tts/gemini', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: text, voice: 'Kore' })
        });
        const data = await res.json();
        if (data.success && data.audio_base64) {
          enqueueAndPlaySpeakerAudio('polya_tts', data.audio_base64);
        }
      } catch (e) {
        console.warn("Gemini TTS fetch error:", e);
      }
    }

    // Direct Trigger ZUMA to speak
    async function triggerZumaSpeak() {
      initAudioContext();
      try {
        await fetch('/api/zuma/speak', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt: 'Open this live debate arena with a forensic analysis of Isaiah 43:10 and 1 Corinthians 8:6.' })
        });
      } catch (e) {
        console.error("Trigger Zuma speak error", e);
      }
    }

    // Initialize Icons & Language
    lucide.createIcons();
    applyTranslations(currentLanguage);

    // Check Local Storage for Auth safely
    try {
      const savedUser = localStorage.getItem('polya_user');
      if (savedUser) {
        currentUser = JSON.parse(savedUser);
        renderAuthUI();
      }
    } catch (err) {
      console.warn("Could not parse saved user from localStorage:", err);
      currentUser = null;
    }

    // Connect WebSocket
    function connectWS() {
      const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${window.location.host}/ws/arena`;
      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        console.log("WebSocket connected to Dialectical Arena");
      };

      ws.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          handleWSEvent(data);
        } catch (e) {
          console.error("WS Parse error", e);
        }
      };

      ws.onclose = () => {
        console.log("WS closed, reconnecting in 2s...");
        setTimeout(connectWS, 2000);
      };
    }
    connectWS();

    function toggleVerticalMenu() {
      const drawer = document.getElementById('vertical-menu-drawer');
      const backdrop = document.getElementById('vertical-menu-drawer-backdrop');
      if (!drawer || !backdrop) return;
      const isHidden = drawer.classList.contains('pointer-events-none');
      if (isHidden) {
        backdrop.classList.remove('hidden');
        drawer.classList.remove('scale-95', 'opacity-0', 'pointer-events-none');
        drawer.classList.add('scale-100', 'opacity-100', 'pointer-events-auto');
      } else {
        backdrop.classList.add('hidden');
        drawer.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
        drawer.classList.remove('scale-100', 'opacity-100', 'pointer-events-auto');
      }
    }

    function scrollToArena() {
      const arena = document.getElementById('arena-section');
      if (arena) {
        arena.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      updateNavTabs(true);
    }

    function scrollToFeed() {
      const feed = document.getElementById('social-feed-section');
      if (feed) {
        feed.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      updateNavTabs(false);
    }

    function updateNavTabs(isArenaActive) {
      const tabArena = document.getElementById('nav-tab-arena');
      const tabFeed = document.getElementById('nav-tab-feed');
      if (tabArena && tabFeed) {
        if (isArenaActive) {
          tabArena.className = "px-2 sm:px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[11px] sm:text-xs font-bold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer shadow-sm";
          tabFeed.className = "px-2 sm:px-3 py-1.5 rounded-lg hover:bg-white/5 text-gray-400 hover:text-white text-[11px] sm:text-xs font-semibold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer";
        } else {
          tabFeed.className = "px-2 sm:px-3 py-1.5 rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-[11px] sm:text-xs font-bold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer shadow-sm";
          tabArena.className = "px-2 sm:px-3 py-1.5 rounded-lg hover:bg-white/5 text-gray-400 hover:text-white text-[11px] sm:text-xs font-semibold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer";
        }
      }
    }

    // Handle WebSocket Incoming Events
    function handleWSEvent(data) {
      const dict = i18nDict[currentLanguage] || i18nDict['en'];
      if (data.type === 'ARENA_STATE_SYNC') {
        currentSeats = data.seats || [];
        document.getElementById('viewer-count').innerText = data.viewers.toLocaleString('en-US');
        document.getElementById('queue-btn-text').innerText = dict.request_stage.replace('{count}', data.queue_count || 0);
        if (data.evidence) {
          document.getElementById('hud-verse').innerText = data.evidence.verse;
          document.getElementById('hud-greek').innerText = data.evidence.hebrew_greek;
        }
        
        // Sync Referee & Moderator Booth (Polya AI)
        if (data.referee) {
          const refRing = document.getElementById('referee-avatar-ring');
          const refDot = document.getElementById('referee-speaking-dot');
          const refStatus = document.getElementById('referee-status-text');
          if (data.referee.is_speaking) {
            if (refRing) refRing.className = "w-12 h-12 rounded-full overflow-hidden border-2 border-emerald-400 p-0.5 bg-black/60 shadow-lg shadow-emerald-500/50 animate-pulse-glow scale-105 transition-all duration-300";
            if (refDot) refDot.classList.remove('hidden');
            if (refStatus) {
              refStatus.innerText = "🔊 Wasit Sedang Memberikan Putusan / Ruling...";
              refStatus.className = "text-[11px] text-emerald-300 font-bold animate-pulse";
            }
          } else {
            if (refRing) refRing.className = "w-12 h-12 rounded-full overflow-hidden border-2 border-emerald-400 p-0.5 bg-black/60 shadow-lg shadow-emerald-500/20 transition-all duration-300";
            if (refDot) refDot.classList.add('hidden');
            if (refStatus) {
              refStatus.innerText = "🎧 Mode Bebas (Mendengarkan Diskusi Debater Tanpa Jeda)";
              refStatus.className = "text-[11px] text-emerald-400/90 font-medium";
            }
          }
        }

        // Render Free Mode Indicator
        const isFreeMode = data.is_free_mode !== false;
        const freeModeBtn = document.getElementById('free-mode-toggle-btn');
        const freeModeText = document.getElementById('free-mode-btn-text');
        const freeModeDot = document.getElementById('free-mode-dot');
        
        if (freeModeBtn && freeModeText) {
          if (isFreeMode) {
            freeModeBtn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-xs text-emerald-300 font-bold transition cursor-pointer shadow-lg shadow-emerald-500/10";
            freeModeText.innerText = dict.free_mode_on;
            if (freeModeDot) freeModeDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
            document.getElementById('pk-timer').innerText = "♾️ Bebas";
          } else {
            freeModeBtn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-gray-300 font-semibold transition cursor-pointer";
            freeModeText.innerText = dict.free_mode_off;
            if (freeModeDot) freeModeDot.className = "w-2 h-2 rounded-full bg-gray-500";
          }
        }

        // Render PK State 3 vs 3 (Total Nilai Donate)
        if (data.pk_state) {
          const leftDonate = data.pk_state.left_donations !== undefined ? data.pk_state.left_donations : (data.pk_state.left_score || 350000);
          const rightDonate = data.pk_state.right_donations !== undefined ? data.pk_state.right_donations : (data.pk_state.right_score || 275000);
          const totalDonate = (leftDonate + rightDonate) || 1;
          const leftPct = Math.min(Math.max(Math.round((leftDonate / totalDonate) * 100), 10), 90);
          const rightPct = 100 - leftPct;

          const leftBarEl = document.getElementById('pk-bar-left');
          const rightBarEl = document.getElementById('pk-bar-right');
          const leftScoreEl = document.getElementById('pk-left-score');
          const rightScoreEl = document.getElementById('pk-right-score');
          const leftDonateEl = document.getElementById('pk-left-donate');
          const rightDonateEl = document.getElementById('pk-right-donate');

          if (leftBarEl) leftBarEl.style.width = `${leftPct}%`;
          if (rightBarEl) rightBarEl.style.width = `${rightPct}%`;
          if (leftScoreEl) leftScoreEl.innerText = `Rp ${leftDonate.toLocaleString('id-ID')}`;
          if (rightScoreEl) rightScoreEl.innerText = `Rp ${rightDonate.toLocaleString('id-ID')}`;
          if (leftDonateEl) leftDonateEl.innerText = `Rp ${leftDonate.toLocaleString('id-ID')}`;
          if (rightDonateEl) rightDonateEl.innerText = `Rp ${rightDonate.toLocaleString('id-ID')}`;
          if (document.getElementById('pk-topic')) {
            document.getElementById('pk-topic').innerText = isFreeMode ? '🎙️ Debat 3 vs 3 (Wasit: Polya AI)' : data.pk_state.topic;
          }

          // Format Live PK Round Timer (MM:SS)
          if (!isFreeMode && data.pk_state.seconds_remaining !== undefined) {
            const sec = Math.max(0, data.pk_state.seconds_remaining);
            const m = Math.floor(sec / 60).toString().padStart(2, '0');
            const s = (sec % 60).toString().padStart(2, '0');
            document.getElementById('pk-timer').innerText = `${m}:${s}`;
          }
        }

        // Render 6 Seats Stage Grid (3 vs 3)
        renderStageGrid(data.seats, isFreeMode);

      } else if (data.type === 'NEW_CHAT_MESSAGE') {
        appendChatMessage(data.chat);
        if (data.chat) {
          if (data.chat.audio_base64) {
            playRawVoiceAudio(data.chat.audio_base64);
          } else if (data.chat.user_id === 'polya_referee' || data.chat.user_id === 'zuma_ai') {
            fetchGeminiTTSAndPlay(data.chat.message);
          }
        }

      } else if (data.type === 'USER_PCM_AUDIO') {
        // Pure Continuous Raw PCM Streaming (100% Zero Gap & Zero Cutoff)
        if (currentUser && data.user_id === currentUser.user_id) return; // Anti self-echo
        if (!audioMasterEnabled || !data.pcm_data) return;
        initAudioContext();
        const senderKey = data.user_id || (`speaker_seat_${data.seat_id}`);
        playPcmStreamChunk(senderKey, data.pcm_data, data.sample_rate);

      } else if (data.type === 'USER_VOICE_AUDIO') {
        // Fallback WebM audio stream in real-time (Anti self-echo + Simultaneous Mixing)
        if (data.audio && data.audio.audio_base64) {
          if (currentUser && data.audio.sender_id === currentUser.user_id) {
            return; // Never play back own voice to the speaker
          }
          const senderKey = data.audio.sender_id || (`speaker_seat_${data.audio.seat_id}`);
          enqueueAndPlaySpeakerAudio(senderKey, data.audio.audio_base64);
        }

      } else if (data.type === 'LIVE_DONATION_ALERT') {
        playSawerChime();
        showSawerBanner(data.alert);

      } else if (data.type === 'TAP_REACTION') {
        playPopSound();
        spawnFloatingEmoji(data.reaction);
      }
    }

    function toggleFreeMode() {
      initAudioContext();
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'TOGGLE_FREE_MODE' }));
      }
    }

    // Render 6-Seat Stage Grid (Left: Tim Biru P1..P3 vs Right: Tim Merah C1..C3)
    function renderStageGrid(seats, isFreeMode = true) {
      if (!seats || !seats.length) return;
      const dict = i18nDict[currentLanguage] || i18nDict['en'];
      const seatIdMap = ['P1', 'P2', 'P3', 'C1', 'C2', 'C3'];

      seats.forEach((seat, idx) => {
        const spkId = seatIdMap[idx] || (idx < 3 ? `P${idx+1}` : `C${idx-2}`);
        const isTeamA = idx < 3;
        const card = document.getElementById(`debater-card-${spkId}`);
        if (!card) return;

        const isSpeaking = !!seat.is_speaking;
        const nameEl = card.querySelector('.debater-name') || document.getElementById(`debater-name-${spkId}`);
        const imgEl = card.querySelector('img');
        const scoreEl = document.getElementById(`debater-score-${spkId}`);

        if (nameEl && seat.name) nameEl.innerText = seat.name;
        if (spkId === 'P1' && seat.name) {
          const btnUser = document.getElementById('donate-btn-user-P1');
          if (btnUser) btnUser.innerText = seat.name;
        }
        if (spkId === 'C1' && seat.name) {
          const btnUser = document.getElementById('donate-btn-user-C1');
          if (btnUser) btnUser.innerText = seat.name;
        }
        if (imgEl && seat.avatar) imgEl.src = seat.avatar;

        if (isSpeaking) {
          card.classList.remove('subdued-debater');
          if (imgEl) {
            imgEl.parentElement.classList.add('animate-pulse-glow');
            imgEl.parentElement.classList.remove('border-blue-400/40', 'border-red-400/40');
            imgEl.parentElement.classList.add(isTeamA ? 'border-cyan-400' : 'border-rose-400');
          }
        } else {
          card.classList.add('subdued-debater');
          if (imgEl) {
            imgEl.parentElement.classList.remove('animate-pulse-glow', 'border-cyan-400', 'border-rose-400');
            imgEl.parentElement.classList.add(isTeamA ? 'border-blue-400/40' : 'border-red-400/40');
          }
        }
      });

      if (window.lucide) lucide.createIcons();
    }
    // Initial immediate render so stage is always visible
    renderStageGrid(currentSeats, true);

    // Append Chat Message with Scripture Citation Highlight
    function appendChatMessage(chat) {
      const stream = document.getElementById('chat-stream');
      const div = document.createElement('div');
      
      if (chat.is_system) {
        div.className = "p-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 font-medium text-[11px] shadow-sm";
        div.innerHTML = `<strong>${chat.user_name}:</strong> ${chat.message}`;
      } else {
        div.className = "flex items-start gap-2 p-1.5 rounded-lg hover:bg-white/5 transition";
        
        // Auto-Highlight Scripture verses in message
        let highlightedMsg = chat.message.replace(
          /(Yohanes\s+\d+:\d+|1\s+Korintus\s+\d+:\d+|Yesaya\s+\d+:\d+|Matius\s+\d+:\d+|1\s+Timotius\s+\d+:\d+)/gi,
          '<span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold border border-emerald-500/30">$1</span>'
        );

        div.innerHTML = `
          <img src="${chat.user_avatar}" class="w-6 h-6 rounded-full flex-shrink-0 cursor-pointer" onclick="openUserProfile('${chat.user_id}', '${chat.user_name}', '${chat.user_avatar}', 'visitor')">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-gray-300 cursor-pointer hover:underline" onclick="openUserProfile('${chat.user_id}', '${chat.user_name}', '${chat.user_avatar}', 'visitor')">${chat.user_name}</span>
              <span class="text-[9px] text-gray-500">${chat.timestamp}</span>
            </div>
            <p class="text-gray-200 text-xs break-words leading-relaxed">${highlightedMsg}</p>
          </div>
        `;
      }

      stream.appendChild(div);
      stream.scrollTop = stream.scrollHeight;
    }

    // Send Chat
    function handleSendChat(e) {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text || !ws) return;

      const payload = {
        type: 'SEND_CHAT',
        user_id: currentUser ? currentUser.user_id : 'guest_' + Math.floor(Math.random()*1000),
        user_name: currentUser ? currentUser.name : 'Visitor_' + Math.floor(Math.random()*100),
        user_avatar: currentUser ? currentUser.avatar_url : 'https://api.dicebear.com/7.x/avataaars/svg?seed=guest',
        message: text
      };
      ws.send(JSON.stringify(payload));
      input.value = '';
    }

    function sendQuickPrompt(promptText) {
      document.getElementById('chat-input').value = promptText;
      document.getElementById('chat-form').dispatchEvent(new Event('submit'));
    }

    // Quick Tap-to-Talk for Chat Input (100% Silent MediaRecorder + Groq Whisper)
    let isChatMicActive = false;
    let chatMediaRecorder = null;
    let chatAudioChunks = [];
    let chatStream = null;

    async function toggleVoiceInputQuick() {
      initAudioContext();
      ensureUser();
      const input = document.getElementById('chat-input');
      const micBtn = document.getElementById('chat-mic-btn');

      if (isChatMicActive) {
        // Stop recording and transcribe
        if (chatMediaRecorder && chatMediaRecorder.state !== 'inactive') {
          chatMediaRecorder.stop();
        }
        return;
      }

      try {
        chatStream = await getAudioStream();
        const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
          ? 'audio/webm;codecs=opus'
          : MediaRecorder.isTypeSupported('audio/webm')
          ? 'audio/webm'
          : 'audio/ogg';

        chatAudioChunks = [];
        chatMediaRecorder = new MediaRecorder(chatStream, { mimeType });

        chatMediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) {
            chatAudioChunks.push(e.data);
          }
        };

        chatMediaRecorder.onstop = async () => {
          isChatMicActive = false;
          micBtn.className = "p-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-400 transition flex items-center justify-center cursor-pointer";
          input.placeholder = "⏳ Memproses suara (Groq Whisper)...";

          if (chatStream) {
            chatStream.getTracks().forEach(t => t.stop());
            chatStream = null;
          }

          if (chatAudioChunks.length > 0) {
            const audioBlob = new Blob(chatAudioChunks, { type: mimeType });
            chatAudioChunks = [];

            if (audioBlob.size > 200) {
              try {
                const formData = new FormData();
                formData.append('file', audioBlob, 'chat_voice.webm');
                const res = await fetch('/api/voice/transcribe', {
                  method: 'POST',
                  body: formData
                });
                const result = await res.json();
                if (result.success && result.text && result.text.trim()) {
                  input.value = result.text.trim();
                  input.placeholder = "Tulis atau klik mic untuk bicara...";
                  // Auto submit to chat
                  document.getElementById('chat-form').dispatchEvent(new Event('submit'));
                } else {
                  input.placeholder = "Tulis atau klik mic untuk bicara...";
                }
              } catch (err) {
                console.error("Transcription error:", err);
                input.placeholder = "Tulis atau klik mic untuk bicara...";
              }
            } else {
              input.placeholder = "Tulis atau klik mic untuk bicara...";
            }
          } else {
            input.placeholder = "Tulis atau klik mic untuk bicara...";
          }
        };

        isChatMicActive = true;
        micBtn.className = "p-2 rounded-xl bg-red-500/30 border border-red-500 text-red-400 transition flex items-center justify-center cursor-pointer animate-pulse";
        input.placeholder = "🔴 Merekam suara (senyap)... Klik lagi mic untuk kirim";
        chatMediaRecorder.start();

      } catch (err) {
        console.error("Chat mic access error:", err);
        alert("Tidak dapat mengakses mikrofon: " + err.message);
        isChatMicActive = false;
        micBtn.className = "p-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-400 transition flex items-center justify-center cursor-pointer";
        input.placeholder = "Tulis atau klik mic untuk bicara...";
      }
    }

    // Join / Leave Queue
    function handleJoinQueue() {
      if (!currentUser) {
        openAuthModal();
        return;
      }
      if (!ws) return;

      const payload = {
        type: 'JOIN_QUEUE',
        user_id: currentUser.user_id,
        name: currentUser.name,
        avatar_url: currentUser.avatar_url
      };
      ws.send(JSON.stringify(payload));
      alert("Permintaan naik panggung telah dikirim ke antrean!");
    }

    // -------------------------------------------------------------------------
    // Realtime Continuous PCM Streaming Engine (Zero Cutoff & Zero Delay)
    // -------------------------------------------------------------------------
    let mediaStream = null;
    let audioContextVAD = null;
    let pcmProcessorNode = null;
    let pcmMuteGain = null;
    let isUserSpeakingNow = false;
    let speechStartTimestamp = null;
    let silenceStartTimestamp = null;
    let lastSpokenVolume = 0;

    function ensureUser() {
      if (!currentUser) {
        const randId = Math.floor(Math.random() * 8999 + 1000);
        currentUser = {
          user_id: 'usr_' + randId,
          name: 'Debater_' + randId,
          email: 'debater' + randId + '@polya.arena',
          avatar_url: `https://api.dicebear.com/7.x/avataaars/svg?seed=Debater${randId}`,
          role: 'debater'
        };
        localStorage.setItem('polya_user', JSON.stringify(currentUser));
        renderAuthUI();
      }
      return currentUser;
    }

    async function getAudioStream() {
      if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
        return await navigator.mediaDevices.getUserMedia({
          audio: {
            echoCancellation: true,
            noiseSuppression: true,
            autoGainControl: true,
            channelCount: 1
          }
        });
      }
      const legacyGetUserMedia = navigator.getUserMedia || navigator.webkitGetUserMedia || navigator.mozGetUserMedia || navigator.msGetUserMedia;
      if (legacyGetUserMedia) {
        return new Promise((resolve, reject) => {
          legacyGetUserMedia.call(navigator, { audio: true }, resolve, reject);
        });
      }
      throw new Error("Browser memblokir microphone pada HTTP biasa. Silakan buka versi HTTPS resmi.");
    }

    function getUserCurrentSeatId() {
      if (!currentUser || !currentSeats) return 0;
      const found = currentSeats.find(s => s.status === 'occupied' && s.user_id === currentUser.user_id);
      return found ? found.seat_id : 0;
    }

    async function startRealVAD() {
      ensureUser();
      try {
        mediaStream = await getAudioStream();

        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioContextVAD = new AudioContextClass();
        if (audioContextVAD.state === 'suspended') {
          await audioContextVAD.resume();
        }

        const source = audioContextVAD.createMediaStreamSource(mediaStream);

        // Vocal Bandpass Filter (High-pass 100Hz + Low-pass 4000Hz)
        const highPassFilter = audioContextVAD.createBiquadFilter();
        highPassFilter.type = 'highpass';
        highPassFilter.frequency.setValueAtTime(100, audioContextVAD.currentTime);

        const lowPassFilter = audioContextVAD.createBiquadFilter();
        lowPassFilter.type = 'lowpass';
        lowPassFilter.frequency.setValueAtTime(4000, audioContextVAD.currentTime);

        source.connect(highPassFilter);
        highPassFilter.connect(lowPassFilter);

        // ScriptProcessor for continuous ultra-low latency PCM streaming (2048 samples = ~45ms)
        const bufferSize = 2048;
        pcmProcessorNode = audioContextVAD.createScriptProcessor(bufferSize, 1, 1);

        pcmProcessorNode.onaudioprocess = (e) => {
          if (!isMicActive) return;

          const inputData = e.inputBuffer.getChannelData(0);
          const len = inputData.length;

          // 1. Calculate RMS volume
          let sumSquares = 0;
          for (let i = 0; i < len; i++) {
            sumSquares += inputData[i] * inputData[i];
          }
          const rms = Math.sqrt(sumSquares / len);
          lastSpokenVolume = rms;

          // 2. Update visual VU meter and equalizer
          const vuText = document.getElementById('mic-status-text');
          const eqBars = document.getElementById('mic-eq-bars');
          const vuFill = document.getElementById('mic-vu-fill');
          const b1 = document.getElementById('eq-bar-1');
          const b2 = document.getElementById('eq-bar-2');
          const b3 = document.getElementById('eq-bar-3');
          const b4 = document.getElementById('eq-bar-4');
          const b5 = document.getElementById('eq-bar-5');

          if (isMicActive) {
            if (eqBars) eqBars.classList.remove('hidden');
            const pct = Math.min(100, Math.round(rms * 700));
            if (vuFill) vuFill.style.width = `${pct}%`;

            if (b1 && b2 && b3 && b4 && b5) {
              const h = Math.max(3, Math.min(16, Math.round(rms * 220)));
              b1.style.height = `${Math.max(3, Math.round(h * 0.5))}px`;
              b2.style.height = `${Math.max(3, Math.round(h * 0.85))}px`;
              b3.style.height = `${Math.max(3, Math.round(h * 1.0))}px`;
              b4.style.height = `${Math.max(3, Math.round(h * 0.75))}px`;
              b5.style.height = `${Math.max(3, Math.round(h * 0.45))}px`;
            }

            if (vuText) {
              const bars = rms > 0.06 ? ' ▂▃▄▅▆▇ (Bicara 🔥)' : rms > 0.015 ? ' ▂▃▄▅ (Bicara 🎙️)' : rms > 0.005 ? ' ▂▃ (Mendengar)' : ' ▂ (Standby)';
              vuText.innerText = `Mic ON: ${bars}`;
            }
          }

          // 3. Update Speaking State Visuals
          const now = Date.now();
          if (rms > 0.012) {
            silenceStartTimestamp = null;
            if (!isUserSpeakingNow) {
              isUserSpeakingNow = true;
              if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(JSON.stringify({ 
                  type: 'TRIGGER_SPEAKING', 
                  seat_id: getUserCurrentSeatId(), 
                  user_id: currentUser ? currentUser.user_id : null,
                  is_speaking: true 
                }));
              }
            }
          } else {
            if (isUserSpeakingNow) {
              if (!silenceStartTimestamp) {
                silenceStartTimestamp = now;
              } else if (now - silenceStartTimestamp > 1800) {
                isUserSpeakingNow = false;
                silenceStartTimestamp = null;
                if (ws && ws.readyState === WebSocket.OPEN) {
                  ws.send(JSON.stringify({ 
                    type: 'TRIGGER_SPEAKING', 
                    seat_id: getUserCurrentSeatId(), 
                    user_id: currentUser ? currentUser.user_id : null,
                    is_speaking: false 
                  }));
                }
              }
            }
          }

          // 4. Convert Float32 to 16-bit PCM and Stream Instantly!
          // Stream whenever volume is active or in speaking window (continuous uninterrupted stream)
          if (isUserSpeakingNow || rms > 0.006) {
            const int16 = new Int16Array(len);
            for (let i = 0; i < len; i++) {
              let s = Math.max(-1, Math.min(1, inputData[i]));
              int16[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
            }

            // Fast Uint8 byte to Base64 conversion
            const bytes = new Uint8Array(int16.buffer);
            let binary = '';
            const byteLen = bytes.byteLength;
            for (let i = 0; i < byteLen; i++) {
              binary += String.fromCharCode(bytes[i]);
            }
            const pcmBase64 = window.btoa(binary);

            if (ws && ws.readyState === WebSocket.OPEN) {
              ws.send(JSON.stringify({
                type: 'VOICE_PCM_STREAM',
                user_id: currentUser ? currentUser.user_id : 'debater_1',
                user_name: currentUser ? currentUser.name : 'Debater Panggung',
                seat_id: getUserCurrentSeatId(),
                sample_rate: audioContextVAD.sampleRate,
                pcm_data: pcmBase64
              }));
            }
          }
        };

        // Mute local loopback to prevent speaker hearing own voice locally
        pcmMuteGain = audioContextVAD.createGain();
        pcmMuteGain.gain.setValueAtTime(0, audioContextVAD.currentTime);

        lowPassFilter.connect(pcmProcessorNode);
        pcmProcessorNode.connect(pcmMuteGain);
        pcmMuteGain.connect(audioContextVAD.destination);

        // Auto claim seat or join queue only if not yet on stage
        const isAlreadyOnStage = (currentSeats || []).some(s => s.status === 'occupied' && s.user_id === currentUser.user_id);
        if (!isAlreadyOnStage && ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify({
            type: 'JOIN_QUEUE',
            user_id: currentUser.user_id,
            name: currentUser.name,
            avatar_url: currentUser.avatar_url
          }));
        }

      } catch (err) {
        console.error("Microphone access error:", err);
        alert("Tidak dapat mengakses mikrofon: " + err.message);
        isMicActive = false;
        renderMicButtonState();
      }
    }

    function stopRealVAD() {
      if (pcmProcessorNode) {
        try {
          pcmProcessorNode.disconnect();
        } catch (e) {}
        pcmProcessorNode = null;
      }
      if (mediaStream) {
        mediaStream.getTracks().forEach(track => track.stop());
        mediaStream = null;
      }
      if (audioContextVAD) {
        try { audioContextVAD.close(); } catch (e) {}
        audioContextVAD = null;
      }
      isUserSpeakingNow = false;

      // Hide equalizer & reset VU fill
      const eqBars = document.getElementById('mic-eq-bars');
      const vuFill = document.getElementById('mic-vu-fill');
      if (eqBars) eqBars.classList.add('hidden');
      if (vuFill) vuFill.style.width = '0%';

      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ 
          type: 'TRIGGER_SPEAKING', 
          seat_id: getUserCurrentSeatId(), 
          user_id: currentUser ? currentUser.user_id : null,
          is_speaking: false 
        }));
      }
    }

    function renderMicButtonState() {
      const icon = document.getElementById('mic-icon');
      const text = document.getElementById('mic-status-text');
      const btn = document.getElementById('mic-btn');
      if (isMicActive) {
        icon.setAttribute('data-lucide', 'mic');
        icon.className = "w-4 h-4 text-emerald-400 animate-pulse";
        text.innerText = "Mic Aktif (Groq VAD Live)";
        btn.className = "flex-1 py-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-semibold text-xs transition flex items-center justify-between px-3 cursor-pointer shadow-lg shadow-emerald-500/10 relative overflow-hidden";
      } else {
        icon.setAttribute('data-lucide', 'mic-off');
        icon.className = "w-4 h-4 text-red-400";
        text.innerText = "Mic Nonaktif (Klik untuk Bicara)";
        btn.className = "flex-1 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 font-semibold text-xs transition flex items-center justify-between px-3 cursor-pointer relative overflow-hidden";
      }
      lucide.createIcons();
    }

    // Live Mic & VAD Toggle
    async function toggleMic() {
      ensureUser();
      initAudioContext();
      isMicActive = !isMicActive;
      renderMicButtonState();

      if (isMicActive) {
        playMicOnSound();
        await startRealVAD();
      } else {
        playMicOffSound();
        stopRealVAD();
      }
    }

    // Tap-to-React Floating Emoji (TikTok Style)
    function sendTapReaction(emoji) {
      if (ws) ws.send(JSON.stringify({ type: 'TAP_REACTION', reaction: emoji }));
    }

    function spawnFloatingEmoji(emoji) {
      const container = document.getElementById('floating-reaction-container');
      const el = document.createElement('div');
      el.className = 'text-3xl animate-float-up pointer-events-none select-none';
      el.innerText = emoji;
      el.style.position = 'absolute';
      el.style.right = `${Math.random() * 40}px`;
      container.appendChild(el);
      setTimeout(() => el.remove(), 2500);
    }

    function votePK(side) {
      if (ws) ws.send(JSON.stringify({ type: 'PK_VOTE', side }));
    }

    // Sawer Banner Animation
    function showSawerBanner(alertData) {
      const container = document.getElementById('sawer-banner-container');
      document.getElementById('sawer-banner-donor').innerText = '@' + alertData.donor_name;
      document.getElementById('sawer-banner-amount').innerText = `Rp ${alertData.gross_amount.toLocaleString('id-ID')}`;
      document.getElementById('sawer-banner-recipient').innerText = alertData.recipient_name;
      document.getElementById('sawer-banner-msg').innerText = alertData.message ? `"${alertData.message}"` : `via ${alertData.payment_method}`;
      document.getElementById('sawer-banner-avatar').src = alertData.donor_avatar;

      container.classList.remove('hidden');
      setTimeout(() => {
        container.classList.add('hidden');
      }, 4000);
    }

    // Profile Card Modal
    function openUserProfile(userId, name, avatar, role, seatId) {
      currentSelectedUserForDonate = { userId, name, avatar, role, seatId };
      document.getElementById('profile-modal-name').innerText = name;
      document.getElementById('profile-modal-avatar').src = avatar;
      document.getElementById('profile-modal-role').innerText = role === 'host_ai' ? '👑 Host AI (Polya ZUMA)' : '🎙️ Debater di Panggung';
      
      const kickBtn = document.getElementById('profile-modal-kick-btn');
      if (seatId !== undefined && seatId !== 0) {
        kickBtn.classList.remove('hidden');
      } else {
        kickBtn.classList.add('hidden');
      }

      document.getElementById('profile-modal').classList.remove('hidden');
      lucide.createIcons();
    }

    function kickCurrentSeatFromProfile() {
      if (!currentSelectedUserForDonate || currentSelectedUserForDonate.seatId === undefined) return;
      const sId = currentSelectedUserForDonate.seatId;
      if (ws) {
        ws.send(JSON.stringify({ type: 'KICK_SEAT', seat_id: sId }));
      }
      closeProfileModal();
    }

    function closeProfileModal() {
      document.getElementById('profile-modal').classList.add('hidden');
    }

    // Donate Modal
    function openDonateModal(userId, name, avatar) {
      currentSelectedUserForDonate = { userId, name, avatar };
      document.getElementById('donate-recipient-name').innerText = name || 'Debater';
      document.getElementById('donate-recipient-avatar').src = avatar || ('https://api.dicebear.com/7.x/avataaars/svg?seed=' + userId);
      updateSplitPreview();
      document.getElementById('donate-modal').classList.remove('hidden');
      if (window.lucide) lucide.createIcons();
    }

    function openDonateModalFromProfile() {
      closeProfileModal();
      if (!currentSelectedUserForDonate) return;
      document.getElementById('donate-recipient-name').innerText = currentSelectedUserForDonate.name;
      document.getElementById('donate-recipient-avatar').src = currentSelectedUserForDonate.avatar;
      updateSplitPreview();
      document.getElementById('donate-modal').classList.remove('hidden');
    }
    function closeDonateModal() {
      document.getElementById('donate-modal').classList.add('hidden');
    }

    function setDonationAmount(amount) {
      document.getElementById('custom-amount-input').value = amount;
      updateSplitPreview();
    }

    function updateSplitPreview() {
      const amount = parseInt(document.getElementById('custom-amount-input').value) || 0;
      const fee = Math.floor(amount * 0.10);
      const net = amount - fee;
      document.getElementById('split-fee-preview').innerText = `Rp ${fee.toLocaleString('id-ID')}`;
      document.getElementById('split-net-preview').innerText = `Rp ${net.toLocaleString('id-ID')}`;
    }

    async function submitDonation() {
      if (!currentUser) {
        closeDonateModal();
        openAuthModal();
        return;
      }
      const amount = parseInt(document.getElementById('custom-amount-input').value) || 0;
      const method = document.querySelector('input[name="payment_method"]:checked').value;
      const msg = document.getElementById('donate-message-input').value;

      if (amount <= 0) {
        alert("Nominal donasi harus lebih dari 0");
        return;
      }

      try {
        const res = await fetch('/api/donate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            donor_user_id: currentUser.user_id,
            donor_name: currentUser.name,
            donor_avatar: currentUser.avatar_url,
            recipient_user_id: currentSelectedUserForDonate.userId,
            gross_amount: amount,
            payment_method: method,
            message: msg
          })
        });
        const data = await res.json();
        if (data.status === 'ok') {
          closeDonateModal();
          alert(`Donasi Rp ${amount.toLocaleString('id-ID')} via ${method} berhasil! (90% Diterima Debater: Rp ${data.recipient_net_90pct.toLocaleString('id-ID')})`);
        }
      } catch (err) {
        alert("Gagal memproses donasi: " + err);
      }
    }

    // User Wallet Modal
    async function openWalletModal() {
      if (!currentUser) {
        openAuthModal();
        return;
      }
      try {
        const res = await fetch(`/api/user/${currentUser.user_id}/wallet`);
        const data = await res.json();
        document.getElementById('wallet-modal-balance').innerText = `Rp ${data.balance_net.toLocaleString('id-ID')}`;
        document.getElementById('header-wallet-balance').innerText = `Rp ${data.balance_net.toLocaleString('id-ID')}`;
        document.getElementById('wallet-treasury-preview').innerText = `Rp ${data.platform_treasury_pool.toLocaleString('id-ID')}`;
        
        const list = document.getElementById('wallet-trx-list');
        if (data.transactions && data.transactions.length > 0) {
          list.innerHTML = data.transactions.map(t => `
            <div class="p-2 rounded bg-white/5 flex justify-between items-center text-[11px]">
              <div>
                <p class="font-bold text-white">+Rp ${t.recipient_net_90pct.toLocaleString('id-ID')} <span class="text-[9px] text-gray-400">(${t.payment_method})</span></p>
                <p class="text-gray-400">${t.donor_name}: "${t.message || '-'}"</p>
              </div>
              <span class="text-emerald-400 font-semibold text-[10px]">${t.timestamp.split(' ')[0]}</span>
            </div>
          `).join('');
        }
      } catch (e) {
        console.error(e);
      }
      document.getElementById('wallet-modal').classList.remove('hidden');
    }
