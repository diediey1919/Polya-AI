<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Polya ARENA | TikTok-Style Multi-Guest Stage</title>
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            arena: {
              bg: '#08090C',
              card: '#10141E',
              border: '#1E2536',
              emerald: '#10B981',
              blurple: '#5865F2',
              gold: '#F59E0B'
            },
            studio: {
              950: '#06090e',
              900: '#0b111a',
              850: '#101826',
              800: '#172236',
              700: '#23324d',
              600: '#354a70'
            },
            prop: {
              900: '#0c2444',
              800: '#10396b',
              500: '#2563eb',
              400: '#3b82f6',
              300: '#60a5fa',
              glow: 'rgba(59, 130, 246, 0.4)'
            },
            opp: {
              900: '#450a0a',
              800: '#781515',
              500: '#dc2626',
              400: '#ef4444',
              300: '#f87171',
              glow: 'rgba(239, 68, 68, 0.4)'
            },
            referee: {
              gold: '#f59e0b',
              amber: '#d97706'
            }
          },
          animation: {
            'pulse-glow': 'pulseGlow 2s infinite',
            'float-up': 'floatUp 2.5s ease-out forwards',
            'sawer-slide': 'sawerSlide 4s ease-in-out forwards',
            'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'glow-prop': 'glowProp 2s infinite alternate',
            'glow-opp': 'glowOpp 2s infinite alternate',
            'waveform': 'waveform 1.2s ease-in-out infinite'
          },
          keyframes: {
            pulseGlow: {
              '0%, 100%': { boxShadow: '0 0 15px rgba(16, 185, 129, 0.4)' },
              '50%': { boxShadow: '0 0 30px rgba(16, 185, 129, 0.8)' }
            },
            floatUp: {
              '0%': { transform: 'translateY(0) scale(0.8)', opacity: '1' },
              '100%': { transform: 'translateY(-200px) scale(1.4)', opacity: '0' }
            },
            sawerSlide: {
              '0%': { transform: 'translateY(-100%) scale(0.9)', opacity: '0' },
              '15%': { transform: 'translateY(0) scale(1)', opacity: '1' },
              '85%': { transform: 'translateY(0) scale(1)', opacity: '1' },
              '100%': { transform: 'translateY(-120%) scale(0.9)', opacity: '0' }
            },
            glowProp: {
              '0%': { boxShadow: '0 0 10px rgba(37, 99, 235, 0.3)' },
              '100%': { boxShadow: '0 0 25px rgba(59, 130, 246, 0.8), 0 0 5px #3b82f6' }
            },
            glowOpp: {
              '0%': { boxShadow: '0 0 10px rgba(220, 38, 38, 0.3)' },
              '100%': { boxShadow: '0 0 25px rgba(239, 68, 68, 0.8), 0 0 5px #ef4444' }
            },
            waveform: {
              '0%, 100%': { height: '6px' },
              '50%': { height: '24px' }
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Full Mobile Width Reset */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
      margin: 0;
      padding: 0;
    }
    img, video {
      max-width: 100%;
      height: auto;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #1E2536; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #2E384D; }
    
    /* 5 DYNAMIC THEME COLOR PRESETS */
    :root, body, body.theme-1 {
      --bg-main: #08090C;
      --bg-header: rgba(11, 14, 20, 0.94);
      --bg-glass: rgba(16, 24, 38, 0.90);
      --bg-card: rgba(23, 34, 54, 0.65);
      --border-glass: rgba(255, 255, 255, 0.08);
      --border-card: rgba(255, 255, 255, 0.05);
      --accent-color: #10B981;
      --accent-badge: rgba(16, 185, 129, 0.2);
    }
    body.theme-2 {
      --bg-main: #050B16;
      --bg-header: rgba(7, 16, 34, 0.94);
      --bg-glass: rgba(10, 22, 46, 0.92);
      --bg-card: rgba(15, 32, 64, 0.70);
      --border-glass: rgba(56, 189, 248, 0.18);
      --border-card: rgba(56, 189, 248, 0.10);
      --accent-color: #38BDF8;
      --accent-badge: rgba(56, 189, 248, 0.2);
    }
    body.theme-3 {
      --bg-main: #0B0A0E;
      --bg-header: rgba(18, 16, 26, 0.94);
      --bg-glass: rgba(24, 20, 34, 0.92);
      --bg-card: rgba(34, 28, 48, 0.70);
      --border-glass: rgba(245, 158, 11, 0.20);
      --border-card: rgba(245, 158, 11, 0.10);
      --accent-color: #F59E0B;
      --accent-badge: rgba(245, 158, 11, 0.2);
    }
    body.theme-4 {
      --bg-main: #030D08;
      --bg-header: rgba(6, 20, 14, 0.94);
      --bg-glass: rgba(9, 28, 19, 0.92);
      --bg-card: rgba(14, 42, 28, 0.70);
      --border-glass: rgba(16, 185, 129, 0.20);
      --border-card: rgba(16, 185, 129, 0.10);
      --accent-color: #10B981;
      --accent-badge: rgba(16, 185, 129, 0.2);
    }
    body.theme-5 {
      --bg-main: #0E060A;
      --bg-header: rgba(24, 10, 18, 0.94);
      --bg-glass: rgba(30, 14, 22, 0.92);
      --bg-card: rgba(44, 20, 32, 0.70);
      --border-glass: rgba(244, 63, 94, 0.20);
      --border-card: rgba(244, 63, 94, 0.10);
      --accent-color: #F43F5E;
      --accent-badge: rgba(244, 63, 94, 0.2);
    }

    body {
      background-color: var(--bg-main) !important;
      transition: background-color 0.4s ease, border-color 0.4s ease;
    }

    .glass-panel {
      background: var(--bg-glass) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-glass) !important;
      transition: background 0.4s ease, border-color 0.4s ease;
    }

    .glass-card {
      background: var(--bg-card) !important;
      backdrop-filter: blur(8px);
      border: 1px solid var(--border-card) !important;
      transition: background 0.4s ease, border-color 0.4s ease;
    }

    .komal-guest-tile {
      background: var(--bg-glass) !important;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-glass) !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .live-speaking-prop {
      border: 2px solid #3b82f6 !important;
      box-shadow: 0 0 25px rgba(59, 130, 246, 0.7), inset 0 0 15px rgba(59, 130, 246, 0.15) !important;
      transform: scale(1.02);
      opacity: 1 !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .live-speaking-opp {
      border: 2px solid #ef4444 !important;
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.7), inset 0 0 15px rgba(239, 68, 68, 0.15) !important;
      transform: scale(1.02);
      opacity: 1 !important;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .subdued-debater {
      opacity: 0.75;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .subdued-debater:hover {
      opacity: 1;
    }

    /* Waveform Animation Bars */
    .mic-bar {
      display: inline-block;
      width: 3px;
      border-radius: 2px;
      margin: 0 1px;
      animation: micWave 0.8s ease-in-out infinite;
    }
    .mic-bar:nth-child(2) { animation-delay: 0.15s; }
    .mic-bar:nth-child(3) { animation-delay: 0.3s; }
    .mic-bar:nth-child(4) { animation-delay: 0.45s; }

    @keyframes micWave {
      0%, 100% { height: 4px; }
      50% { height: 18px; }
    }
  </style>
</head>
<body class="bg-[#08090C] text-gray-100 min-h-screen flex flex-col font-sans overflow-x-hidden selection:bg-emerald-500/30">

  <!-- ===================================================================== -->
  <!-- TOP BAR: TELEMETRY, VIEWER COUNT, PROFILE, WALLET, LANGUAGE -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-40 h-14 bg-[#0B0E14]/90 backdrop-blur-md border-b border-white/5 px-2.5 sm:px-4 flex items-center justify-between gap-1 w-full max-w-full">
    <!-- Brand & Live Indicator -->
    <div class="flex items-center gap-1.5 sm:gap-3 flex-shrink-0">
      <div class="flex items-center gap-1.5 sm:gap-2 px-2 sm:px-2.5 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold tracking-wide">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
        <span class="text-[11px] sm:text-xs">LIVE</span>
      </div>
      <div class="flex items-center gap-1 text-xs text-gray-400 font-medium">
        <i data-lucide="users" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-400"></i>
        <span id="viewer-count" class="font-bold text-white tracking-wide">15,480</span>
      </div>
      <div class="hidden xl:flex items-center gap-1.5 text-xs text-emerald-400/90 font-mono bg-emerald-500/5 px-2.5 py-0.5 rounded border border-emerald-500/10">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        ZUMA AI: ONLINE
      </div>
    </div>

    <!-- Center Navigation Tabs: Live Debate Arena vs Community Feed (2 MAIN BUTTONS ONLY) -->
    <div class="flex items-center gap-1 bg-[#10141E] p-0.5 sm:p-1 rounded-xl border border-white/10 shadow-inner">
      <button onclick="scrollToArena()" id="nav-tab-arena" class="px-2 sm:px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[11px] sm:text-xs font-bold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer shadow-sm">
        <i data-lucide="swords" class="w-3.5 h-3.5 text-emerald-400"></i>
        <span data-i18n="nav_debate_arena">ARENA</span>
      </button>
      <button onclick="scrollToFeed()" id="nav-tab-feed" class="px-2 sm:px-3 py-1.5 rounded-lg hover:bg-white/5 text-gray-400 hover:text-white text-[11px] sm:text-xs font-semibold transition flex items-center gap-1 sm:gap-1.5 cursor-pointer">
        <i data-lucide="layout-grid" class="w-3.5 h-3.5 text-indigo-400"></i>
        <span data-i18n="nav_community_feed">Feed</span>
      </button>
    </div>

    <!-- Top-Right Floating Vertical Drawer Trigger Button -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <button onclick="toggleVerticalMenu()" id="menu-drawer-toggle-btn" class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-200 hover:text-white font-bold text-xs flex items-center gap-1.5 transition cursor-pointer shadow-sm relative" title="Open Settings & Menu">
        <i data-lucide="menu" class="w-4 h-4 text-emerald-400"></i>
        <span class="hidden md:inline" data-i18n="menu_btn">Menu</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      </button>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- TOP-RIGHT VERTICAL FLOATING SLIDE-OUT DRAWER -->
  <!-- ===================================================================== -->
  <div id="vertical-menu-drawer-backdrop" onclick="toggleVerticalMenu()" class="fixed inset-0 z-40 bg-black/50 backdrop-blur-xs hidden transition-opacity"></div>
  
  <div id="vertical-menu-drawer" class="fixed top-14 right-2 sm:right-4 z-50 w-72 sm:w-80 max-w-[calc(100vw-1rem)] glass-panel p-4 rounded-2xl border border-white/10 shadow-2xl backdrop-blur-2xl transition-all duration-300 transform scale-95 opacity-0 pointer-events-none flex flex-col gap-3">
    <!-- Header of Drawer -->
    <div class="flex items-center justify-between pb-2.5 border-b border-white/10">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
        <span class="text-xs font-bold text-white uppercase tracking-wider" data-i18n="drawer_settings_title">Settings & Tools</span>
      </div>
      <button onclick="toggleVerticalMenu()" class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-white/5 cursor-pointer">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Vertical List of Controls -->
    <div class="flex flex-col gap-2 text-xs">
      <!-- 1. Google Sign-In / User Profile -->
      <div id="auth-container-drawer">
        <div id="auth-container">
          <button onclick="openAuthModal(); toggleVerticalMenu();" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-white text-gray-950 font-bold hover:bg-gray-200 transition shadow cursor-pointer">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
              <span data-i18n="google_signin">Google Sign-In</span>
            </div>
            <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-gray-500"></i>
          </button>
        </div>
      </div>

      <!-- 2. Language Selection Trigger -->
      <button onclick="openLanguageModal(); toggleVerticalMenu();" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/30 text-indigo-300 font-bold transition cursor-pointer">
        <div class="flex items-center gap-2">
          <i data-lucide="globe" class="w-4 h-4 text-indigo-400"></i>
          <span id="nav-lang-badge">🌐 English (EN)</span>
        </div>
        <span class="text-[10px] bg-indigo-500/20 px-1.5 py-0.5 rounded text-indigo-200" data-i18n="change_btn">Change</span>
      </button>

      <!-- 2B. Theme Preset Selector (5 Themes) -->
      <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 flex flex-col gap-1.5">
        <div class="flex items-center justify-between text-gray-300 font-bold">
          <div class="flex items-center gap-1.5 text-xs">
            <i data-lucide="palette" class="w-3.5 h-3.5 text-indigo-400"></i>
            <span>Theme Preset:</span>
          </div>
          <span id="theme-active-label" class="text-[10px] text-emerald-400 font-mono">1. Neon Obsidian</span>
        </div>
        <div class="grid grid-cols-5 gap-1 pt-1">
          <button onclick="setAppTheme(1)" id="theme-btn-1" class="py-1 rounded-lg text-center font-bold text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 hover:scale-105 transition cursor-pointer" title="1. Cyberpunk Neon Obsidian">1</button>
          <button onclick="setAppTheme(2)" id="theme-btn-2" class="py-1 rounded-lg text-center font-bold text-xs bg-sky-500/10 text-sky-400 border border-white/10 hover:scale-105 transition cursor-pointer" title="2. Midnight Sapphire & Titanium">2</button>
          <button onclick="setAppTheme(3)" id="theme-btn-3" class="py-1 rounded-lg text-center font-bold text-xs bg-amber-500/10 text-amber-400 border border-white/10 hover:scale-105 transition cursor-pointer" title="3. Royal Obsidian & Gold">3</button>
          <button onclick="setAppTheme(4)" id="theme-btn-4" class="py-1 rounded-lg text-center font-bold text-xs bg-emerald-600/10 text-emerald-400 border border-white/10 hover:scale-105 transition cursor-pointer" title="4. Deep Forest Matrix">4</button>
          <button onclick="setAppTheme(5)" id="theme-btn-5" class="py-1 rounded-lg text-center font-bold text-xs bg-rose-500/10 text-rose-400 border border-white/10 hover:scale-105 transition cursor-pointer" title="5. Crimson Eclipse">5</button>
        </div>
      </div>

      <!-- 3. Video Corpus Search Button -->
      <button onclick="openCorpusModal(); toggleVerticalMenu();" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-200 transition cursor-pointer">
        <div class="flex items-center gap-2">
          <i data-lucide="database" class="w-4 h-4 text-indigo-400"></i>
          <span data-i18n="corpus_btn">2,638 Video Corpus</span>
        </div>
        <i data-lucide="search" class="w-3.5 h-3.5 text-gray-400"></i>
      </button>

      <!-- 4. User Wallet Button -->
      <button onclick="openWalletModal(); toggleVerticalMenu();" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-semibold transition cursor-pointer">
        <div class="flex items-center gap-2">
          <i data-lucide="wallet" class="w-4 h-4 text-emerald-400"></i>
          <span data-i18n="wallet_btn">Wallet:</span>
          <span id="header-wallet-balance" class="font-bold">Rp 0</span>
        </div>
        <span class="text-[10px] bg-emerald-500/20 px-1.5 py-0.5 rounded text-emerald-300" data-i18n="open_btn">Open</span>
      </button>

      <!-- 5. Free Mode Toggle Button -->
      <button id="free-mode-toggle-btn" onclick="toggleFreeMode()" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 font-bold transition cursor-pointer shadow-sm">
        <div class="flex items-center gap-2">
          <span id="free-mode-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="free-mode-btn-text" data-i18n="free_mode_on">🎙️ Free Mode: ON ♾️</span>
        </div>
        <span class="text-[10px] bg-emerald-500/20 px-1.5 py-0.5 rounded text-emerald-200">Toggle</span>
      </button>

      <!-- 6. Master Audio & TTS Toggle Button -->
      <button id="audio-toggle-btn" onclick="toggleAudioMaster()" class="w-full flex items-center justify-between p-2.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-medium transition cursor-pointer">
        <div class="flex items-center gap-2">
          <i id="audio-toggle-icon" data-lucide="volume-2" class="w-4 h-4 text-emerald-400"></i>
          <span id="audio-toggle-text" data-i18n="sound_on">Sound: ON</span>
        </div>
        <span class="text-[10px] bg-white/5 px-1.5 py-0.5 rounded text-gray-300">Mute/Play</span>
      </button>
    </div>
  </div>

  <!-- FLOATING LIVE VISITOR AUDIO UNLOCK BANNER -->
  <!-- ===================================================================== -->
  <div id="visitor-audio-unlock-banner" onclick="unlockAudioEngine()" class="fixed bottom-20 left-1/2 transform -translate-x-1/2 z-50 px-4 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 border border-cyan-300/60 rounded-full shadow-2xl flex items-center gap-2.5 cursor-pointer text-white text-xs font-bold animate-bounce transition-all hidden">
    <i data-lucide="volume-2" class="w-4 h-4 text-cyan-200 animate-pulse"></i>
    <span>🔊 Click Here to Enable Debate Audio</span>
  </div>

  <!-- ===================================================================== -->
  <!-- FLOATING LIVE SAWER BANNER ALERT -->
  <!-- ===================================================================== -->
  <div id="sawer-banner-container" class="fixed top-16 left-1/2 transform -translate-x-1/2 z-50 pointer-events-none w-full max-w-sm px-3 hidden">
    <div class="bg-gradient-to-r from-amber-500/95 via-yellow-600/95 to-amber-700/95 backdrop-blur-md p-3 rounded-2xl border-2 border-amber-300/80 shadow-2xl text-gray-950 flex items-center gap-3 animate-sawer-slide">
      <img id="sawer-banner-avatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Budi" class="w-11 h-11 rounded-full border-2 border-amber-400 flex-shrink-0">
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-1">
          <p class="text-xs font-bold text-amber-400 truncate" id="sawer-banner-donor">@Budi_Visitor</p>
          <span class="px-2 py-0.5 rounded-full bg-amber-400/20 text-amber-300 font-extrabold text-[11px]" id="sawer-banner-amount">Rp 50,000</span>
        </div>
        <p class="text-[11px] text-gray-300 font-medium"><span data-i18n="sawer_for">Gave donation for</span> <span class="text-white font-bold" id="sawer-banner-recipient">Markus_P</span></p>
        <p class="text-[11px] text-amber-200/90 italic truncate" id="sawer-banner-msg">"Great scripture analysis! 🔥"</p>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MAIN ARENA CONTENT: PK GAUGE + 6 SEAT STAGE + CHAT OVERLAY (ORIGINAL TIKTOK/KOMAL STAGE) -->
  <!-- ===================================================================== -->
  <main id="arena-section" class="flex-1 max-w-7xl w-full mx-auto p-3 sm:p-4 flex flex-col gap-3 relative">

    <!-- 1. PK BATTLE MODE GAUGE (1v1 Dialectical Clash / Official Arena Header) -->
    <div class="glass-panel p-2.5 sm:p-3 rounded-xl flex flex-col gap-1.5 border border-white/5 bg-[#10141E]/90">
      <div class="flex items-center justify-between text-xs">
        <div class="flex items-center gap-2 min-w-0">
          <span class="hidden">OFFICIAL ARENA 3-VS-3</span>
          <h1 id="topicHeadline" class="hidden"></h1>
          <span id="pk-topic" class="hidden"></span>
          <span id="matchStatusBadge" class="px-2.5 py-0.5 text-[9px] font-bold uppercase rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center gap-1.5 flex-shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="matchStatusText">SETUP</span>
          </span>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <div id="roundNameDisplay" class="text-[10px] font-bold text-indigo-300 hidden md:inline">ROUND 1 — OPENING</div>
          <div id="timerContainer" class="flex items-center gap-1.5 font-mono text-emerald-400 font-bold">
            <i data-lucide="timer" class="w-3.5 h-3.5"></i>
            <span id="timerDisplay">04:00</span>
            <span id="pk-timer" class="hidden">04:00</span>
          </div>
        </div>
      </div>

      <!-- Dynamic PK Bar / Momentum (Driven by Total Donate) -->
      <div class="relative w-full h-4 bg-gray-800 rounded-full overflow-hidden flex items-center shadow-inner">
        <div id="pk-bar-left" style="width: 56%;" class="h-full bg-gradient-to-r from-blue-700 via-blue-600 to-blue-400 transition-all duration-500 flex items-center justify-start px-2">
          <span id="pk-left-score" class="text-[10px] font-black text-white font-mono">Rp 350.000</span>
        </div>
        <div id="pk-bar-right" style="width: 44%;" class="h-full bg-gradient-to-l from-red-700 via-red-600 to-red-400 transition-all duration-500 flex items-center justify-end px-2">
          <span id="pk-right-score" class="text-[10px] font-black text-white font-mono">Rp 275.000</span>
        </div>
      </div>
      <!-- Hidden telemetry hooks for momentum -->
      <div class="hidden">
        <div id="propMomentumBar"></div>
        <div id="oppMomentumBar"></div>
      </div>

      <!-- Quick Donate Buttons & View Switcher -->
      <div class="flex flex-col gap-2.5 pt-1.5 text-xs">
        <!-- Two Donate Buttons (P1 on Left, C1 on Right) with User Below Donate -->
        <div class="flex items-center justify-between gap-3">
          <!-- Debater P1 Donate Button (Left) -->
          <button onclick="openDonateModal('P1', document.getElementById('donate-btn-user-P1')?.innerText || 'P1 — Prime Minister', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P1')" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 border border-blue-400/50 text-white transition flex flex-col items-start justify-center shadow-md shadow-blue-900/30 cursor-pointer min-w-[110px] sm:min-w-[130px]">
            <div class="flex items-center gap-1.5 text-xs font-bold">
              <i data-lucide="gift" class="w-3.5 h-3.5 text-amber-300"></i>
              <span>Donate</span>
            </div>
            <span id="donate-btn-user-P1" class="text-[10px] text-blue-200 font-normal truncate max-w-[120px] sm:max-w-[140px]">P1 — Prime Minister</span>
          </button>

          <!-- Debater C1 Donate Button (Right) -->
          <button onclick="openDonateModal('C1', document.getElementById('donate-btn-user-C1')?.innerText || 'C1 — Opposition Leader', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C1')" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 border border-red-400/50 text-white transition flex flex-col items-end justify-center shadow-md shadow-red-900/30 cursor-pointer min-w-[110px] sm:min-w-[130px]">
            <div class="flex items-center gap-1.5 text-xs font-bold">
              <span>Donate</span>
              <i data-lucide="gift" class="w-3.5 h-3.5 text-amber-300"></i>
            </div>
            <span id="donate-btn-user-C1" class="text-[10px] text-red-200 font-normal truncate max-w-[120px] sm:max-w-[140px]">C1 — Opposition Leader</span>
          </button>
        </div>

        <!-- Views Switcher (Live, Verdict, Replay, Forensics) Centered Under Support Buttons -->
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 pt-0.5">
          <button onclick="switchArenaView('live')" class="px-3 py-1 rounded-lg text-[11px] sm:text-xs font-bold bg-white/15 hover:bg-white/25 text-white transition border border-white/10 shadow-sm">Live</button>
          <button onclick="switchArenaView('verdict')" class="px-3 py-1 rounded-lg text-[11px] sm:text-xs font-bold bg-white/5 hover:bg-white/20 text-slate-400 hover:text-slate-200 transition border border-white/5">Verdict</button>
          <button onclick="switchArenaView('replay')" class="px-3 py-1 rounded-lg text-[11px] sm:text-xs font-bold bg-white/5 hover:bg-white/20 text-slate-400 hover:text-slate-200 transition border border-white/5">Replay</button>
          <button onclick="switchArenaView('forensics')" class="px-3 py-1 rounded-lg text-[11px] sm:text-xs font-bold bg-white/5 hover:bg-white/20 text-slate-400 hover:text-slate-200 transition border border-white/5">Forensics</button>
        </div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- VIEW 1: LIVE BROADCAST & STAGE (DEFAULT VIEW)                      -->
    <!-- ================================================================= -->
    <div id="view-live" class="arena-view-container flex flex-col gap-3">

      <!-- 2. SCRIPTURE & FORENSIC TELEPROMPTER HUD (ACTIVE SPEAKER PODIUM) -->
      <div id="activeSpeakerPodium" class="glass-panel p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs shadow-lg">
        <div class="flex items-center gap-3 min-w-0">
          <div class="relative flex-shrink-0">
            <img id="speakerAvatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=SpeakerP1" class="w-10 h-10 rounded-full border-2 border-amber-400 object-cover shadow">
            <span class="absolute -bottom-1 -right-1 p-0.5 rounded-full bg-amber-500 text-gray-950">
              <i data-lucide="mic" class="w-2.5 h-2.5"></i>
            </span>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-amber-300 truncate" id="activeSpeakerName">P1 — Prime Minister</span>
              <span id="activeSpeakerRole" class="text-[9px] px-1.5 py-0.2 rounded bg-amber-400/20 text-amber-300 font-semibold uppercase">LIVE ON STAGE</span>
              <span id="hud-verse" class="text-xs text-amber-200 font-bold hidden sm:inline">Yohanes 1:1 & 1 Korintus 8:6</span>
            </div>
            <p class="text-gray-200 text-xs italic truncate mt-0.5 font-medium" id="activeSpeechText">
              "Menyampaikan argumen pembuka terkait dasar naskah kuno dan integritas eksegesis..."
            </p>
            <p class="text-gray-400 text-[10px] font-serif truncate hidden" id="hud-greek">
              Ἐν ἀρχῇ ἦν ὁ λόγος ... καὶ θεὸς ἦν ὁ λόγος / εἷς θεὸς ὁ πατήρ
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 self-end sm:self-center flex-shrink-0">
          <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-gray-300 text-[10px]">
            📜 Manuskrip: <strong class="text-emerald-400">א, B, 𝔓⁶⁶</strong>
          </span>
        </div>
      </div>

      <!-- 3. THE 6-SEAT DIALECTICAL STAGE (2-COLUMN PK STAGE: LEFT BLUE vs RIGHT RED) -->
      <div class="grid grid-cols-2 gap-2.5 sm:gap-3.5 min-h-[300px]" id="stage-grid">
        
        <!-- ROW 1 - LEFT: P1 (Proposition 1 - Prime Minister) - LARGER FEATURED SEAT -->
        <div id="debater-card-P1" class="glass-panel p-4 sm:p-5 rounded-2xl border-2 border-blue-500/50 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-blue-400 transition shadow-xl min-h-[220px] sm:min-h-[250px]">
          <div class="w-full flex items-center justify-between text-xs text-blue-400 font-bold mb-1">
            <span class="px-2 py-0.5 rounded bg-blue-500/20 text-[11px] font-extrabold tracking-wide">P1 • PM</span>
            <span id="debater-score-P1" class="font-mono text-emerald-400 font-bold">Score: 0.0</span>
          </div>
          <div class="relative my-2.5 cursor-pointer" onclick="openUserProfile('P1', 'P1 — Prime Minister', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P1', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=P1" class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-blue-400 object-cover shadow-2xl group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1.5 rounded-full bg-blue-600 text-white shadow-lg">
              <i data-lucide="mic" class="w-4 h-4"></i>
            </span>
          </div>
          <p id="debater-name-P1" class="text-sm sm:text-base font-extrabold text-white truncate max-w-[160px]">P1 — Prime Minister</p>
          <span class="text-xs text-blue-300 font-semibold tracking-wide">PROPOSITION TEAM</span>
          <button onclick="openDonateModal('P1', 'P1 — Prime Minister', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P1')" class="mt-2.5 w-full py-1.5 rounded-xl bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer shadow">
            <i data-lucide="gift" class="w-3.5 h-3.5"></i> Sawer
          </button>
        </div>

        <!-- ROW 1 - RIGHT: C1 (Opposition 1 - Leader of Opposition) - LARGER FEATURED SEAT -->
        <div id="debater-card-C1" class="glass-panel p-4 sm:p-5 rounded-2xl border-2 border-red-500/50 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-red-400 transition subdued-debater shadow-xl min-h-[220px] sm:min-h-[250px]">
          <div class="w-full flex items-center justify-between text-xs text-red-400 font-bold mb-1">
            <span class="px-2 py-0.5 rounded bg-red-500/20 text-[11px] font-extrabold tracking-wide">C1 • LO</span>
            <span id="debater-score-C1" class="font-mono text-emerald-400 font-bold">Score: 0.0</span>
          </div>
          <div class="relative my-2.5 cursor-pointer" onclick="openUserProfile('C1', 'C1 — Opposition Leader', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C1', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=C1" class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-red-400/80 object-cover shadow-2xl group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1.5 rounded-full bg-gray-700 text-gray-400 shadow-lg">
              <i data-lucide="mic-off" class="w-4 h-4"></i>
            </span>
          </div>
          <p id="debater-name-C1" class="text-sm sm:text-base font-extrabold text-white truncate max-w-[160px]">C1 — Opposition Leader</p>
          <span class="text-xs text-red-300 font-semibold tracking-wide">OPPOSITION TEAM</span>
          <button onclick="openDonateModal('C1', 'C1 — Opposition Leader', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C1')" class="mt-2.5 w-full py-1.5 rounded-xl bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer shadow">
            <i data-lucide="gift" class="w-3.5 h-3.5"></i> Sawer
          </button>
        </div>

        <!-- ROW 2 - LEFT: P2 (Proposition 2 - Deputy PM) -->
        <div id="debater-card-P2" class="glass-panel p-3 rounded-2xl border border-blue-500/30 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-blue-400 transition subdued-debater">
          <div class="w-full flex items-center justify-between text-[10px] text-blue-400 font-bold mb-1">
            <span class="px-1.5 py-0.5 rounded bg-blue-500/20">P2 • DPM</span>
            <span id="debater-score-P2" class="font-mono text-emerald-400">Score: 0.0</span>
          </div>
          <div class="relative my-2 cursor-pointer" onclick="openUserProfile('P2', 'P2 — Deputy PM', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P2', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=P2" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-blue-400/60 object-cover shadow-lg group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1 rounded-full bg-gray-700 text-gray-400 shadow">
              <i data-lucide="mic-off" class="w-3 h-3"></i>
            </span>
          </div>
          <p id="debater-name-P2" class="text-xs font-bold text-white truncate max-w-[120px]">P2 — Deputy PM</p>
          <span class="text-[10px] text-blue-300">PROPOSITION TEAM</span>
          <button onclick="openDonateModal('P2', 'P2 — Deputy PM', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P2')" class="mt-2 w-full py-1 rounded-lg bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-[10px] font-bold transition flex items-center justify-center gap-1 cursor-pointer">
            <i data-lucide="gift" class="w-3 h-3"></i> Sawer
          </button>
        </div>

        <!-- ROW 2 - RIGHT: C2 (Opposition 2 - Deputy LO) -->
        <div id="debater-card-C2" class="glass-panel p-3 rounded-2xl border border-red-500/30 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-red-400 transition subdued-debater">
          <div class="w-full flex items-center justify-between text-[10px] text-red-400 font-bold mb-1">
            <span class="px-1.5 py-0.5 rounded bg-red-500/20">C2 • DLO</span>
            <span id="debater-score-C2" class="font-mono text-emerald-400">Score: 0.0</span>
          </div>
          <div class="relative my-2 cursor-pointer" onclick="openUserProfile('C2', 'C2 — Deputy LO', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C2', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=C2" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-red-400/60 object-cover shadow-lg group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1 rounded-full bg-gray-700 text-gray-400 shadow">
              <i data-lucide="mic-off" class="w-3 h-3"></i>
            </span>
          </div>
          <p id="debater-name-C2" class="text-xs font-bold text-white truncate max-w-[120px]">C2 — Deputy LO</p>
          <span class="text-[10px] text-red-300">OPPOSITION TEAM</span>
          <button onclick="openDonateModal('C2', 'C2 — Deputy LO', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C2')" class="mt-2 w-full py-1 rounded-lg bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-[10px] font-bold transition flex items-center justify-center gap-1 cursor-pointer">
            <i data-lucide="gift" class="w-3 h-3"></i> Sawer
          </button>
        </div>

        <!-- ROW 3 - LEFT: P3 (Proposition 3 - Whip) -->
        <div id="debater-card-P3" class="glass-panel p-3 rounded-2xl border border-blue-500/30 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-blue-400 transition subdued-debater">
          <div class="w-full flex items-center justify-between text-[10px] text-blue-400 font-bold mb-1">
            <span class="px-1.5 py-0.5 rounded bg-blue-500/20">P3 • Whip</span>
            <span id="debater-score-P3" class="font-mono text-emerald-400">Score: 0.0</span>
          </div>
          <div class="relative my-2 cursor-pointer" onclick="openUserProfile('P3', 'P3 — Gov Whip', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P3', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=P3" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-blue-400/60 object-cover shadow-lg group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1 rounded-full bg-gray-700 text-gray-400 shadow">
              <i data-lucide="mic-off" class="w-3 h-3"></i>
            </span>
          </div>
          <p id="debater-name-P3" class="text-xs font-bold text-white truncate max-w-[120px]">P3 — Gov Whip</p>
          <span class="text-[10px] text-blue-300">PROPOSITION TEAM</span>
          <button onclick="openDonateModal('P3', 'P3 — Gov Whip', 'https://api.dicebear.com/7.x/avataaars/svg?seed=P3')" class="mt-2 w-full py-1 rounded-lg bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-[10px] font-bold transition flex items-center justify-center gap-1 cursor-pointer">
            <i data-lucide="gift" class="w-3 h-3"></i> Sawer
          </button>
        </div>

        <!-- ROW 3 - RIGHT: C3 (Opposition 3 - Opp Whip) -->
        <div id="debater-card-C3" class="glass-panel p-3 rounded-2xl border border-red-500/30 bg-[#121622] flex flex-col items-center justify-between text-center relative group hover:border-red-400 transition subdued-debater">
          <div class="w-full flex items-center justify-between text-[10px] text-red-400 font-bold mb-1">
            <span class="px-1.5 py-0.5 rounded bg-red-500/20">C3 • Whip</span>
            <span id="debater-score-C3" class="font-mono text-emerald-400">Score: 0.0</span>
          </div>
          <div class="relative my-2 cursor-pointer" onclick="openUserProfile('C3', 'C3 — Opp Whip', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C3', 'debater')">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=C3" class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-red-400/60 object-cover shadow-lg group-hover:scale-105 transition">
            <span class="absolute bottom-0 right-0 p-1 rounded-full bg-gray-700 text-gray-400 shadow">
              <i data-lucide="mic-off" class="w-3 h-3"></i>
            </span>
          </div>
          <p id="debater-name-C3" class="text-xs font-bold text-white truncate max-w-[120px]">C3 — Opp Whip</p>
          <span class="text-[10px] text-red-300">OPPOSITION TEAM</span>
          <button onclick="openDonateModal('C3', 'C3 — Opp Whip', 'https://api.dicebear.com/7.x/avataaars/svg?seed=C3')" class="mt-2 w-full py-1 rounded-lg bg-amber-400/20 hover:bg-amber-400/30 border border-amber-400/40 text-amber-300 text-[10px] font-bold transition flex items-center justify-center gap-1 cursor-pointer">
            <i data-lucide="gift" class="w-3 h-3"></i> Sawer
          </button>
        </div>

      </div>

      <!-- 4. LIVE PUBLIC CHAT STREAM & ACTION BAR (TIKTOK LIVE 2-COLUMN LAYOUT) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-3">
        
        <!-- Live Chat Area (2 Columns on Large Screens) -->
        <div class="lg:col-span-2 glass-panel p-3 rounded-2xl flex flex-col h-[280px] border border-white/10 relative">
          <div class="flex items-center justify-between pb-2 border-b border-white/5 text-xs text-gray-400">
            <div class="flex items-center gap-2 font-semibold text-white">
              <i data-lucide="message-square" class="w-3.5 h-3.5 text-emerald-400"></i>
              <span>Live Chat Komentar Publik</span>
            </div>
            <span class="text-[10px] bg-white/5 px-2 py-0.5 rounded">Auto-Citation Active</span>
          </div>

          <!-- Scrollable Messages Stream -->
          <div id="chat-stream" class="flex-1 overflow-y-auto space-y-2 py-2 text-xs pr-1">
            <!-- Initial Welcome Chat -->
            <div class="p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs">
              <strong>🛡️ Sistem Polya:</strong> Selamat datang di arena perdebatan live. Format sitasi Bible (contoh: <em>Yohanes 1:1</em>, <em>1 Korintus 8:6</em>, <em>Yesaya 43:10</em>) akan otomatis ter-highlight. Klik foto profil debater untuk memberi sawer donasi (DANA, GoPay, ShopeePay, OVO).
            </div>
          </div>

          <!-- Chat Input Form -->
          <form id="chat-form" onsubmit="handleSendChat(event)" class="pt-2 flex items-center gap-2 border-t border-white/5">
            <input 
              type="text" 
              id="chat-input" 
              placeholder="Tulis argumen atau tanggapan publik..." 
              class="flex-1 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400 transition"
            >
            <button type="submit" class="px-3.5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-gray-950 font-bold text-xs transition flex items-center gap-1 cursor-pointer">
              <span>Kirim</span>
              <i data-lucide="send" class="w-3.5 h-3.5"></i>
            </button>
          </form>
        </div>

        <!-- Action Panel: Topic Chips, Stage Request, Floating React Emojis -->
        <div class="glass-panel p-3 rounded-2xl flex flex-col justify-between gap-3 border border-white/10">
          
          <!-- Quick Prompts / Topics -->
          <div>
            <p class="text-xs font-semibold text-gray-300 mb-2 flex items-center gap-1.5">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
              Topik Pintasan Debat:
            </p>
            <div class="flex flex-wrap gap-1.5">
              <button onclick="sendQuickPrompt('Bagaimana bedah gramatika Yohanes 1:1 tanpa artikel pada kata Theos?')" class="px-2 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-gray-300 transition text-left cursor-pointer">
                💡 Yohanes 1:1 (Anarthrous)
              </button>
              <button onclick="sendQuickPrompt('Bagaimana keselarasan Yesaya 43:10 dengan 1 Korintus 8:6?')" class="px-2 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-gray-300 transition text-left cursor-pointer">
                💡 Monoteisme Yesaya 43:10
              </button>
              <button onclick="sendQuickPrompt('Periksa varian naskah 1 Timotius 3:16 antara kata hos vs theos!')" class="px-2 py-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-gray-300 transition text-left cursor-pointer">
                💡 1 Timotius 3:16 Varian
              </button>
            </div>
          </div>

          <!-- Stage Request Button & Mic Controls -->
          <div class="flex flex-col gap-2 pt-2 border-t border-white/5">
            <button id="join-queue-btn" onclick="handleJoinQueue()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-gray-950 font-bold text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer">
              <i data-lucide="hand" class="w-4 h-4"></i>
              <span id="queue-btn-text">🖐️ Minta Naik Panggung (Antrean: 0)</span>
            </button>

            <div class="flex items-center justify-between gap-2">
              <!-- Simulated Mic Toggle -->
              <button id="mic-btn" onclick="toggleMic()" class="flex-1 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-gray-300 font-semibold text-xs transition flex items-center justify-center gap-1.5 cursor-pointer">
                <i data-lucide="mic-off" class="w-3.5 h-3.5 text-red-400" id="mic-icon"></i>
                <span id="mic-status-text">Mic Nonaktif</span>
              </button>

              <!-- Floating React Tap Buttons (TikTok Style) -->
              <div class="flex items-center gap-1">
                <button onclick="sendTapReaction('🔥')" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-base transition transform active:scale-125 cursor-pointer" title="Kirim Api">🔥</button>
                <button onclick="sendTapReaction('📜')" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-base transition transform active:scale-125 cursor-pointer" title="Kirim Naskah">📜</button>
                <button onclick="sendTapReaction('🛡️')" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-base transition transform active:scale-125 cursor-pointer" title="Kirim Perisai">🛡️</button>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- 5. AI EVENT CONTROL & TELEMETRY PANEL -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <!-- AI Referee & Fact Checker Alerts -->
        <div class="glass-panel p-3 rounded-xl border border-rose-500/20 bg-rose-950/10 flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-rose-400 flex items-center gap-1.5">
              <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i> AI REFEREE & FACT CHECK
            </span>
            <span id="refereeViolationsCount" class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 text-[10px] font-bold">0 Flags</span>
          </div>
          <div id="factCheckAlert" class="text-xs text-slate-300 bg-black/40 p-2 rounded-lg border border-white/5">
            <span class="text-emerald-400 font-bold">✓ VERIFIED:</span> Naskah primer konsisten dengan P66 dan Codex Sinaiticus.
          </div>
          <div id="refereeStatus" class="text-[11px] text-slate-400 italic">Referee status: Monitoring speech turns and fallacy rules.</div>
          <div id="refereeActionList" class="flex flex-col gap-1 text-[11px]"></div>
        </div>

        <!-- Active Evidence Card -->
        <div class="glass-panel p-3 rounded-xl border border-amber-500/20 bg-amber-950/10 flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-amber-400 flex items-center gap-1.5">
              <i data-lucide="file-text" class="w-3.5 h-3.5"></i> ACTIVE EVIDENCE
            </span>
            <span class="text-[10px] text-amber-300 font-mono">PRIMARY SOURCE</span>
          </div>
          <div id="activeEvidenceCard" class="text-xs text-slate-200 bg-black/40 p-2 rounded-lg border border-white/5 flex flex-col gap-1">
            <div class="font-bold text-amber-300">Codex Sinaiticus & Vaticanus B</div>
            <p class="text-[11px] text-slate-300">Rujukan naskah abad ke-4 menunjukkan keselarasan bacaan monoteistik tanpa varian interpolasi.</p>
          </div>
        </div>

        <!-- AI Commentary Feed & Clashes -->
        <div class="glass-panel p-3 rounded-xl border border-indigo-500/20 bg-indigo-950/10 flex flex-col gap-2">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-indigo-400 flex items-center gap-1.5">
              <i data-lucide="activity" class="w-3.5 h-3.5"></i> AI COMMENTARY FEED
            </span>
            <span class="text-[10px] text-indigo-300 font-mono">LIVE INTEL</span>
          </div>
          <div id="commentaryFeed" class="max-h-28 overflow-y-auto flex flex-col gap-1.5 text-[11px] text-slate-300 pr-1">
            <div class="bg-black/30 p-1.5 rounded border border-white/5">
              <span class="text-indigo-400 font-bold">[AI Host]:</span> Pembicara P1 membuka perdebatan dengan fokus pada hermeneutika gramatikal.
            </div>
          </div>
          <div id="activeClashesContainer" class="hidden"></div>
        </div>
      </div>

    </div>

    <!-- ================================================================= -->
    <!-- VIEW 2: FINAL VERDICT & AWARDS CEREMONY                           -->
    <!-- ================================================================= -->
    <div id="view-verdict" class="arena-view-container hidden flex flex-col gap-4">
      <div class="glass-panel p-6 rounded-2xl border-2 border-amber-500/50 text-center shadow-xl relative overflow-hidden">
        <div class="w-16 h-16 mx-auto mb-2 rounded-full bg-gradient-to-tr from-amber-600 to-yellow-400 p-0.5 flex items-center justify-center shadow-xl">
          <div class="w-full h-full rounded-full bg-studio-950 flex items-center justify-center">
            <i data-lucide="trophy" class="w-8 h-8 text-amber-400"></i>
          </div>
        </div>
        <div class="text-[10px] font-black tracking-widest uppercase text-amber-400 mb-1">OFFICIAL ADJUDICATION VERDICT</div>
        <h2 id="verdictWinnerBanner" class="text-2xl sm:text-4xl font-black tracking-tight text-white mb-1">
          PROPOSITION WINS
        </h2>
        <p id="verdictMarginText" class="text-sm font-mono text-amber-300 font-bold mb-3">
          Victory Margin: +10.93 Points
        </p>
        <div class="flex justify-center items-center gap-6 text-xs sm:text-sm font-bold font-mono">
          <div class="px-4 py-1.5 rounded-xl bg-blue-950/80 border border-blue-500/40 text-blue-300">
            PROPOSITION: <span id="verdictPropScore" class="text-white font-black">68.91</span>
          </div>
          <div class="text-slate-500">VS</div>
          <div class="px-4 py-1.5 rounded-xl bg-red-950/80 border border-red-500/40 text-red-300">
            OPPOSITION: <span id="verdictOppScore" class="text-white font-black">51.00</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="glass-panel p-3.5 rounded-xl border border-studio-700">
          <h3 class="text-xs font-black uppercase text-amber-400 mb-2 flex items-center gap-1.5">
            <i data-lucide="award" class="w-3.5 h-3.5"></i> DECISIVE FACTORS
          </h3>
          <div id="verdictWhyList" class="flex flex-col gap-2"></div>
        </div>
        <div class="glass-panel p-3.5 rounded-xl border border-studio-700">
          <h3 class="text-xs font-black uppercase text-yellow-400 mb-2 flex items-center gap-1.5">
            <i data-lucide="star" class="w-3.5 h-3.5"></i> PERFORMANCE HONORS
          </h3>
          <div id="verdictAwardsList" class="grid grid-cols-2 gap-2"></div>
        </div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- VIEW 3: REPLAY TIMELINE MAP                                       -->
    <!-- ================================================================= -->
    <div id="view-replay" class="arena-view-container hidden flex flex-col gap-3">
      <div class="glass-panel p-3.5 rounded-xl border border-studio-700">
        <h3 class="text-xs font-black uppercase text-indigo-300 mb-2 flex items-center gap-1.5">
          <i data-lucide="history" class="w-3.5 h-3.5"></i> EVENT REPLAY SCRUBBER
        </h3>
        <p class="text-xs text-slate-300">
          Turn-by-turn playback of speech turns, evidence submissions, referee flags, and judge evaluations.
        </p>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- VIEW 4: FORENSIC & ZUMA TELEMETRY                                -->
    <!-- ================================================================= -->
    <div id="view-forensics" class="arena-view-container hidden flex flex-col gap-3">
      <div class="glass-panel p-3.5 rounded-xl border border-studio-700">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-xs font-black uppercase text-purple-400 flex items-center gap-1.5">
            <i data-lucide="microscope" class="w-3.5 h-3.5"></i> ZUMA PERSONA ALIGNMENT & BATTLE MAP
          </h3>
          <span id="zumaAlignmentScore" class="text-xs font-mono font-bold text-purple-300 bg-purple-950/60 px-2 py-0.5 rounded border border-purple-500/30">
            94% ALIGNED
          </span>
        </div>
        <div id="battleMapCanvas" class="flex flex-col gap-1.5"></div>
      </div>
    </div>

    <!-- ================================================================= -->
    <!-- OPERATOR & EVENT CONTROL DOCK                                     -->
    <!-- ================================================================= -->
    <div id="operatorDock" class="glass-panel border border-studio-700 p-2.5 rounded-xl shadow-xl flex flex-wrap items-center justify-between gap-2">
      <!-- Quick Match Actions -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-[9px] font-black uppercase text-amber-400 tracking-wider flex items-center gap-1">
          <i data-lucide="sliders" class="w-3 h-3"></i> CONTROLS:
        </span>
        <button onclick="sendArenaAction('START_MATCH')" class="px-2 py-1 text-[11px] font-bold rounded bg-emerald-600 hover:bg-emerald-500 text-white transition">
          Start Match
        </button>
        <button onclick="sendArenaAction('ADVANCE_TURN')" class="px-2 py-1 text-[11px] font-bold rounded bg-blue-600 hover:bg-blue-500 text-white transition">
          Advance Turn
        </button>
        <button onclick="sendArenaAction('PAUSE')" class="px-2 py-1 text-[11px] font-bold rounded bg-amber-600 hover:bg-amber-500 text-white transition">
          Pause
        </button>
        <button onclick="sendArenaAction('RESUME')" class="px-2 py-1 text-[11px] font-bold rounded bg-teal-600 hover:bg-teal-500 text-white transition">
          Resume
        </button>
        <button onclick="sendArenaAction('DELIBERATE')" class="px-2 py-1 text-[11px] font-bold rounded bg-purple-600 hover:bg-purple-500 text-white transition">
          Deliberate
        </button>
        <button onclick="sendArenaAction('ISSUE_VERDICT')" class="px-2 py-1 text-[11px] font-bold rounded bg-yellow-600 hover:bg-yellow-500 text-white transition">
          Final Verdict
        </button>
      </div>

      <!-- Live Speech Simulation Input -->
      <div class="flex items-center gap-1.5 flex-1 max-w-md min-w-[200px]">
        <input type="text" id="simSpeechInput" placeholder="Ketik pernyataan pembicara aktif..." class="w-full bg-studio-900 border border-studio-700 rounded-lg px-2.5 py-1 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:border-blue-500">
        <button onclick="submitSimSpeech()" class="px-2.5 py-1 text-xs font-bold rounded bg-blue-600 hover:bg-blue-500 text-white whitespace-nowrap">
          Send
        </button>
      </div>

      <!-- Reset & Fallback Simulator -->
      <div class="flex items-center gap-1.5">
        <button onclick="toggleDegradedSimulation()" class="px-2 py-1 text-[10px] font-bold rounded bg-studio-800 hover:bg-studio-700 text-slate-300 border border-studio-600">
          Fallback
        </button>
        <button onclick="resetArenaMatch()" class="px-2 py-1 text-[10px] font-bold rounded bg-red-900/60 hover:bg-red-800 text-red-200 border border-red-500/40">
          Reset
        </button>
      </div>
    </div>

  </main>

  <!-- Container for Floating Reaction Emojis -->
  <div id="floating-reaction-container" class="fixed right-6 bottom-20 z-40 pointer-events-none"></div>



  <!-- ===================================================================== -->
  <!-- INSTAGRAM & TIKTOK STYLE SOCIAL MEDIA FEED SECTION -->
  <!-- ===================================================================== -->
  <section id="social-feed-section" class="max-w-2xl w-full mx-auto px-3 sm:px-4 py-4 flex flex-col gap-5 relative">
    
    <!-- 1. STORIES / STATUS ROW (Instagram/TikTok Stories Bar) -->
    <div class="glass-panel p-3 rounded-2xl border border-white/5 flex flex-col gap-2">
      <div class="flex items-center justify-between px-1">
        <span class="text-xs font-bold text-gray-300 flex items-center gap-1.5">
          <i data-lucide="flame" class="w-3.5 h-3.5 text-orange-400"></i>
          <span data-i18n="stories_title">Debater Stories & Status</span>
        </span>
        <button onclick="openCreateStoryModal()" class="text-[11px] text-indigo-400 hover:text-indigo-300 font-medium cursor-pointer flex items-center gap-1">
          <i data-lucide="plus" class="w-3 h-3"></i> <span data-i18n="add_story">Add Story</span>
        </button>
      </div>
      
      <div id="stories-container" class="flex items-center gap-3 overflow-x-auto pb-1 pt-1">
        <!-- Add Story Circle -->
        <div onclick="openCreateStoryModal()" class="flex flex-col items-center gap-1 flex-shrink-0 cursor-pointer group">
          <div class="relative w-14 h-14 rounded-full p-0.5 bg-gradient-to-tr from-purple-500 via-pink-500 to-amber-400 flex items-center justify-center">
            <div class="w-full h-full rounded-full bg-[#10141E] p-0.5 flex items-center justify-center relative overflow-hidden">
              <img id="my-story-avatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=user" class="w-full h-full rounded-full object-cover">
              <div class="absolute inset-0 bg-black/40 flex items-center justify-center group-hover:bg-black/20 transition">
                <i data-lucide="plus" class="w-5 h-5 text-white font-bold"></i>
              </div>
            </div>
          </div>
          <span class="text-[10px] text-gray-400 font-medium truncate w-14 text-center" data-i18n="your_story">Your Story</span>
        </div>
        <!-- Rendered stories dynamically populated here -->
      </div>
    </div>

    <!-- 2. QUICK POST CREATION PROMPT (Instagram Style) -->
    <div class="glass-panel p-3.5 rounded-2xl border border-white/5 flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <img id="feed-user-avatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=user" class="w-9 h-9 rounded-full border border-emerald-400 flex-shrink-0">
        <button onclick="openCreatePostModal()" class="flex-1 text-left bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl px-3.5 py-2 text-xs text-gray-400 hover:text-gray-200 transition cursor-pointer" data-i18n="quick_post_placeholder">
          Share manuscript photos, debate videos, rational arguments, or audio...
        </button>
      </div>
      <div class="flex items-center justify-around pt-2 border-t border-white/5 text-xs text-gray-400">
        <button onclick="openCreatePostModal('photo')" class="flex items-center gap-1.5 hover:text-emerald-400 transition cursor-pointer py-1 px-2 rounded-lg hover:bg-white/5">
          <i data-lucide="image" class="w-4 h-4 text-emerald-400"></i>
          <span class="text-[11px] font-medium" data-i18n="tab_photo_compress">Photo (Auto-Compress)</span>
        </button>
        <button onclick="openCreatePostModal('video')" class="flex items-center gap-1.5 hover:text-purple-400 transition cursor-pointer py-1 px-2 rounded-lg hover:bg-white/5">
          <i data-lucide="video" class="w-4 h-4 text-purple-400"></i>
          <span class="text-[11px] font-medium" data-i18n="tab_video">Video / Reels</span>
        </button>
        <button onclick="openCreatePostModal('audio')" class="flex items-center gap-1.5 hover:text-amber-400 transition cursor-pointer py-1 px-2 rounded-lg hover:bg-white/5">
          <i data-lucide="music" class="w-4 h-4 text-amber-400"></i>
          <span class="text-[11px] font-medium" data-i18n="tab_music">Music / Audio</span>
        </button>
        <button onclick="openCreatePostModal('text')" class="flex items-center gap-1.5 hover:text-blue-400 transition cursor-pointer py-1 px-2 rounded-lg hover:bg-white/5">
          <i data-lucide="message-square" class="w-4 h-4 text-blue-400"></i>
          <span class="text-[11px] font-medium" data-i18n="tab_status">Text Status</span>
        </button>
      </div>
    </div>

    <!-- 3. FEED FILTER TABS -->
    <div class="sticky top-14 z-30 bg-[#08090C]/90 backdrop-blur-md py-1.5 flex items-center justify-between border-b border-white/5">
      <div class="flex items-center gap-1 overflow-x-auto py-1">
        <button onclick="switchFeedTab('all')" id="tab-btn-all" class="feed-tab-btn px-3 py-1 rounded-full text-xs font-bold transition bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          <span data-i18n="filter_all">🔥 All Feed</span>
        </button>
        <button onclick="switchFeedTab('media')" id="tab-btn-media" class="feed-tab-btn px-3 py-1 rounded-full text-xs font-medium text-gray-400 hover:text-gray-200 transition bg-white/5 border border-white/5">
          <span data-i18n="filter_media">📷 Photos & Evidence</span>
        </button>
        <button onclick="switchFeedTab('video')" id="tab-btn-video" class="feed-tab-btn px-3 py-1 rounded-full text-xs font-medium text-gray-400 hover:text-gray-200 transition bg-white/5 border border-white/5">
          <span data-i18n="filter_video">🎥 Videos & Reels</span>
        </button>
        <button onclick="switchFeedTab('status')" id="tab-btn-status" class="feed-tab-btn px-3 py-1 rounded-full text-xs font-medium text-gray-400 hover:text-gray-200 transition bg-white/5 border border-white/5">
          <span data-i18n="filter_status">💬 Discussion Status</span>
        </button>
      </div>
      <button onclick="loadSocialFeed()" class="p-1.5 text-gray-400 hover:text-white rounded-lg hover:bg-white/5 transition cursor-pointer" title="Refresh Feed">
        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
      </button>
    </div>

    <!-- 4. DYNAMIC FEED POSTS STREAM -->
    <div id="feed-posts-container" class="flex flex-col gap-6">
      <!-- Loading Skeleton -->
      <div class="glass-panel p-4 rounded-2xl border border-white/5 animate-pulse flex flex-col gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white/10"></div>
          <div class="flex-1">
            <div class="h-3.5 bg-white/10 rounded w-1/3 mb-1.5"></div>
            <div class="h-2.5 bg-white/5 rounded w-1/4"></div>
          </div>
        </div>
        <div class="h-64 bg-white/5 rounded-xl"></div>
      </div>
    </div>

    <!-- Infinite Scroll Sentinel -->
    <div id="feed-end-indicator" class="text-center py-6 text-xs text-gray-500">
      <span data-i18n="feed_end">✨ You have reached the end of the Polya Community Feed ✨</span>
    </div>

  </section>

  <!-- ===================================================================== -->
  <!-- FLOATING ACTION BUTTON: BACK TO DEBATE ARENA (PANAH KE ATAS) -->
  <!-- ===================================================================== -->
  <button 
    id="back-to-arena-btn" 
    onclick="scrollToArena()" 
    class="fixed bottom-6 right-6 z-40 px-4 py-3 rounded-full bg-gradient-to-r from-emerald-500 via-teal-500 to-indigo-600 hover:from-emerald-400 hover:to-indigo-500 text-gray-950 font-extrabold text-xs shadow-2xl shadow-emerald-500/30 flex items-center gap-2 transition-all transform hover:scale-105 active:scale-95 cursor-pointer opacity-0 pointer-events-none transition-opacity duration-300 border border-emerald-400/40"
    title="Back to ARENA on Top"
  >
    <i data-lucide="arrow-up" class="w-4 h-4 animate-bounce text-gray-950 font-bold"></i>
    <span data-i18n="back_to_arena">ARENA</span>
  </button>

  <!-- ===================================================================== -->
  <!-- SOCIAL MEDIA MODALS: CREATE POST, CREATE STORY, STORY VIEWER, COMMENTS -->
  <!-- ===================================================================== -->

  <!-- ===================================================================== -->
  <!-- SOCIAL MEDIA MODALS: CREATE POST, CREATE STORY, STORY VIEWER, COMMENTS -->
  <!-- ===================================================================== -->

  <!-- A. CREATE SOCIAL POST MODAL (Photo with Auto-Compress, Video, Status, Music) -->
  <div id="create-post-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden p-3">
    <div class="relative w-full max-w-lg p-5 sm:p-6 rounded-2xl bg-[#10141E] border border-white/10 shadow-2xl flex flex-col gap-4 max-h-[90vh] overflow-y-auto">
      <button onclick="closeCreatePostModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <div class="flex items-center gap-2 pb-2 border-b border-white/5">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center">
          <i data-lucide="plus-square" class="w-4 h-4 text-white"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-white" data-i18n="create_post_title">Create New Post</h3>
          <p class="text-[11px] text-gray-400" data-i18n="create_post_subtitle">Share manuscript photos, debate clips, or status with audio</p>
        </div>
      </div>

      <!-- Post Media Type Tabs -->
      <div class="grid grid-cols-3 gap-1.5 p-1 bg-white/5 rounded-xl text-xs">
        <button type="button" onclick="setPostType('photo')" id="post-type-btn-photo" class="py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center justify-center gap-1">
          <i data-lucide="image" class="w-3.5 h-3.5"></i> <span data-i18n="post_tab_photo">Photo</span>
        </button>
        <button type="button" onclick="setPostType('video')" id="post-type-btn-video" class="py-1.5 rounded-lg font-medium text-gray-400 hover:text-white flex items-center justify-center gap-1">
          <i data-lucide="video" class="w-3.5 h-3.5"></i> <span data-i18n="post_tab_video">Video</span>
        </button>
        <button type="button" onclick="setPostType('text')" id="post-type-btn-text" class="py-1.5 rounded-lg font-medium text-gray-400 hover:text-white flex items-center justify-center gap-1">
          <i data-lucide="message-square" class="w-3.5 h-3.5"></i> <span data-i18n="post_tab_status">Status</span>
        </button>
      </div>

      <!-- File Upload Area (with Auto-Compress info for images) -->
      <div id="post-upload-container">
        <label class="block text-xs font-semibold text-gray-300 mb-1.5" id="post-file-label" data-i18n="post_file_label">Select Photo (Auto-Compressed):</label>
        <div class="border-2 border-dashed border-white/10 hover:border-emerald-500/50 rounded-xl p-4 text-center cursor-pointer transition bg-white/5 relative">
          <input type="file" id="post-file-input" onchange="handlePostFileSelected(event)" class="absolute inset-0 opacity-0 cursor-pointer">
          <div id="post-file-empty-preview" class="flex flex-col items-center gap-2">
            <i data-lucide="upload-cloud" class="w-8 h-8 text-emerald-400"></i>
            <p class="text-xs text-gray-300 font-medium" data-i18n="drag_drop_files">Click or drag & drop files here</p>
            <p class="text-[10px] text-emerald-400/90 font-mono" data-i18n="auto_compress_active">⚡ Auto-Compression Active (Optimized for Mobile)</p>
          </div>
          <!-- Live Preview Container -->
          <div id="post-file-preview-wrap" class="hidden flex flex-col items-center gap-2">
            <img id="post-image-preview" src="" class="max-h-48 rounded-lg object-contain hidden border border-white/10">
            <video id="post-video-preview" src="" controls class="max-h-48 rounded-lg hidden border border-white/10"></video>
            <p id="post-compression-info" class="text-[11px] text-emerald-300 font-mono bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20"></p>
          </div>
        </div>
      </div>

      <!-- Caption Input -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-1" data-i18n="caption_label">Caption & Arguments:</label>
        <textarea id="post-caption-input" rows="3" placeholder="Write theological argument, scripture reference, or manuscript notes..." data-i18n-placeholder="caption_placeholder" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400"></textarea>
      </div>

      <!-- Background Music / Audio Selector (IG Reels & TikTok style) -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-1 flex items-center gap-1.5">
          <i data-lucide="music" class="w-3.5 h-3.5 text-amber-400"></i>
          <span data-i18n="music_selector_label">Select Background Music (Reels/TikTok style):</span>
        </label>
        <select id="post-music-select" class="w-full bg-[#121622] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-amber-400">
          <option value="" data-i18n="no_music_opt">🚫 No Music (Original Audio)</option>
          <option value="🎵 ZUMA Ambient Dialectics • Voice of Reason|https://actions.google.com/sounds/v1/ambiences/humming_meditation.ogg">🎵 ZUMA Ambient Dialectics • Voice of Reason</option>
          <option value="🎵 Epic Middle Eastern Oud • Sound of Truth|https://actions.google.com/sounds/v1/science_fiction/deep_pulse_drone.ogg">🎵 Epic Middle Eastern Oud • Sound of Truth</option>
          <option value="🎵 Ancient Temple Strings • Scripture Meditation|https://actions.google.com/sounds/v1/ambiences/gentle_rain.ogg">🎵 Ancient Temple Strings • Scripture Meditation</option>
          <option value="🎵 Lo-Fi Dialectics • Study Focus|https://actions.google.com/sounds/v1/science_fiction/space_ambience.ogg">🎵 Lo-Fi Dialectics • Study Focus</option>
        </select>
      </div>

      <!-- Hashtags / Topic Tags -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-1" data-i18n="hashtags_label">Hashtags (#):</label>
        <input type="text" id="post-tags-input" placeholder="#John1 #Monotheism #CodexSinaiticus" data-i18n-placeholder="hashtags_placeholder" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400">
      </div>

      <!-- Submit Button -->
      <button id="post-submit-btn" onclick="submitCreatePost()" class="w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-emerald-500 hover:opacity-90 text-white font-bold text-xs shadow-lg transition flex items-center justify-center gap-2 cursor-pointer">
        <i data-lucide="send" class="w-4 h-4"></i>
        <span data-i18n="share_post_btn">Share Post Now</span>
      </button>
    </div>
  </div>

  <!-- B. CREATE STATUS / STORY MODAL -->
  <div id="create-story-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden p-3">
    <div class="relative w-full max-w-sm p-6 rounded-2xl bg-[#10141E] border border-white/10 shadow-2xl flex flex-col gap-4">
      <button onclick="closeCreateStoryModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <div class="flex items-center gap-2 pb-2 border-b border-white/5">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-pink-500 to-amber-400 flex items-center justify-center">
          <i data-lucide="plus" class="w-4 h-4 text-white"></i>
        </div>
        <div>
          <h3 class="text-sm font-bold text-white" data-i18n="add_story_title">Add Story / Status</h3>
          <p class="text-[11px] text-gray-400" data-i18n="story_visible_24h">Visible for 24 hours on the stories bar</p>
        </div>
      </div>

      <!-- Story Preview Card -->
      <div id="story-preview-card" class="h-56 rounded-2xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-blue-600 p-5 flex items-center justify-center text-center text-white font-bold text-sm shadow-inner transition-all">
        <p id="story-preview-text" data-i18n="story_preview_default">Type your status below...</p>
      </div>

      <!-- Status Text Input -->
      <textarea id="story-text-input" rows="3" oninput="document.getElementById('story-preview-text').innerText = this.value || 'Type your status below...'" placeholder="Write a short update, tonight's debate theme, or manuscript finding..." data-i18n-placeholder="story_input_placeholder" class="w-full bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-white focus:outline-none focus:border-pink-500"></textarea>

      <!-- Gradient Background Theme Selector -->
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-1.5" data-i18n="color_theme_label">Select Color Theme:</label>
        <div class="flex items-center justify-between gap-2">
          <button onclick="setStoryGradient('from-purple-600 via-indigo-600 to-blue-600')" class="w-7 h-7 rounded-full bg-gradient-to-tr from-purple-600 to-blue-600 border-2 border-white/40 cursor-pointer"></button>
          <button onclick="setStoryGradient('from-pink-600 via-rose-600 to-amber-500')" class="w-7 h-7 rounded-full bg-gradient-to-tr from-pink-600 to-amber-500 border-2 border-transparent cursor-pointer"></button>
          <button onclick="setStoryGradient('from-emerald-500 via-teal-600 to-cyan-600')" class="w-7 h-7 rounded-full bg-gradient-to-tr from-emerald-500 to-cyan-600 border-2 border-transparent cursor-pointer"></button>
          <button onclick="setStoryGradient('from-amber-500 via-orange-600 to-red-600')" class="w-7 h-7 rounded-full bg-gradient-to-tr from-amber-500 to-red-600 border-2 border-transparent cursor-pointer"></button>
          <button onclick="setStoryGradient('from-gray-900 via-slate-800 to-zinc-900')" class="w-7 h-7 rounded-full bg-gradient-to-tr from-gray-900 to-slate-800 border-2 border-transparent cursor-pointer"></button>
        </div>
      </div>

      <!-- Submit Story -->
      <button onclick="submitCreateStory()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white font-bold text-xs shadow-lg transition flex items-center justify-center gap-1.5 cursor-pointer">
        <i data-lucide="send" class="w-4 h-4"></i>
        <span data-i18n="share_story_btn">Share to Story</span>
      </button>
    </div>
  </div>

  <!-- C. FULLSCREEN STORY VIEWER MODAL (Instagram Style) -->
  <div id="story-viewer-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 backdrop-blur-lg hidden p-4">
    <div class="relative w-full max-w-sm h-[80vh] rounded-3xl overflow-hidden shadow-2xl flex flex-col justify-between p-6 transition-all" id="story-viewer-card">
      
      <!-- Story Progress Bar -->
      <div class="w-full h-1 bg-white/30 rounded-full overflow-hidden mb-4">
        <div id="story-progress-fill" class="h-full bg-white transition-all duration-100" style="width: 100%;"></div>
      </div>

      <!-- Story Author Header -->
      <div class="flex items-center justify-between z-10">
        <div class="flex items-center gap-3">
          <img id="story-viewer-avatar" src="" class="w-10 h-10 rounded-full border-2 border-white">
          <div>
            <h4 id="story-viewer-name" class="text-sm font-bold text-white">Name</h4>
            <p id="story-viewer-time" class="text-[10px] text-white/80">Just now</p>
          </div>
        </div>
        <button onclick="closeStoryViewer()" class="text-white hover:text-gray-300 p-1">
          <i data-lucide="x" class="w-6 h-6"></i>
        </button>
      </div>

      <!-- Story Content Text -->
      <div class="flex-1 flex items-center justify-center text-center px-4 py-8 z-10">
        <p id="story-viewer-content" class="text-lg sm:text-xl font-extrabold text-white leading-relaxed drop-shadow-md">
          Status Content
        </p>
      </div>

      <!-- Story Bottom Navigation -->
      <div class="flex items-center justify-between text-white text-xs z-10 pt-4 border-t border-white/10">
        <span data-i18n="story_community_footer">✨ Polya Community Story</span>
        <button onclick="closeStoryViewer()" class="px-3 py-1 rounded-full bg-white/20 hover:bg-white/30 font-semibold cursor-pointer" data-i18n="close_btn">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- D. INSTAGRAM STYLE FULL COMMENTS DRAWER MODAL -->
  <div id="comments-modal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/80 backdrop-blur-sm hidden p-0 sm:p-4">
    <div class="relative w-full max-w-md h-[75vh] rounded-t-3xl sm:rounded-2xl bg-[#10141E] border border-white/10 shadow-2xl flex flex-col">
      <!-- Drawer Header -->
      <div class="p-4 border-b border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <i data-lucide="message-circle" class="w-4 h-4 text-emerald-400"></i>
          <h3 class="text-sm font-bold text-white" data-i18n="comments_title">Post Comments</h3>
        </div>
        <button onclick="closeCommentsModal()" class="text-gray-400 hover:text-white p-1 rounded-lg cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Comments Stream -->
      <div id="modal-comments-list" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
        <p class="text-gray-500 italic text-center py-6" data-i18n="loading_comments">Loading comments...</p>
      </div>

      <!-- Comment Input Box -->
      <div class="p-3 border-t border-white/10 bg-[#0B0E14] flex items-center gap-2">
        <img id="comment-input-avatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=user" class="w-8 h-8 rounded-full border border-white/10 flex-shrink-0">
        <input 
          type="text" 
          id="modal-comment-input" 
          placeholder="Add your comment..." 
          data-i18n-placeholder="add_comment_placeholder"
          class="flex-1 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-emerald-400"
          onkeydown="if(event.key==='Enter') submitCommentFromModal()"
        >
        <button onclick="submitCommentFromModal()" class="px-3 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-gray-950 font-bold text-xs transition cursor-pointer flex items-center justify-center">
          <i data-lucide="send" class="w-3.5 h-3.5"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODALS: GOOGLE SIGN-IN, PROFILE CARD, DONATE E-WALLET, WALLET DASH -->
  <!-- ===================================================================== -->

  <!-- 1. FLOATING GOOGLE SIGN-IN MODAL -->
  <div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md transition-all duration-300 hidden">
    <div class="relative w-full max-w-md mx-4 p-7 rounded-2xl bg-[#10141E] border border-white/10 shadow-2xl shadow-emerald-500/10 text-center">
      <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Dialectical Live Arena
      </div>

      <h2 class="text-2xl font-bold text-white mb-1.5" data-i18n="auth_modal_title">Enter the Polya Arena</h2>
      <p class="text-xs text-gray-400 mb-5 leading-relaxed" data-i18n="auth_modal_subtitle">
        Engage in forensic dialectics on scripture consistency with <strong class="text-emerald-400">Persona ZUMA</strong> via interactive audio & text.
      </p>

      <button 
        onclick="simulateGoogleLogin()" 
        class="w-full flex items-center justify-center gap-3 px-5 py-3 rounded-xl bg-white hover:bg-gray-100 text-gray-900 font-semibold text-sm transition transform hover:scale-[1.01] active:scale-[0.99] shadow-lg mb-5 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
        <span data-i18n="continue_google">Continue with Google Account</span>
      </button>

      <div class="grid grid-cols-2 gap-2 text-left pt-3 border-t border-white/5 text-[11px] text-gray-400">
        <div data-i18n="feature_1">✔ 6-Seat Stage Mic Queue</div>
        <div data-i18n="feature_2">✔ Live Public Dialectics</div>
        <div data-i18n="feature_3">✔ Real-time VAD Speech</div>
        <div data-i18n="feature_4">✔ Digital Wallet Rewards</div>
      </div>
    </div>
  </div>

  <!-- 2. FLOATING USER PROFILE CARD (MODAL) -->
  <div id="profile-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
    <div class="relative w-full max-w-sm mx-4 p-6 rounded-2xl bg-[#121622] border border-white/10 shadow-2xl text-center">
      <button onclick="closeProfileModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <img id="profile-modal-avatar" src="" class="w-20 h-20 rounded-full mx-auto mb-3 border-2 border-emerald-400 shadow-lg">
      <h3 id="profile-modal-name" class="text-lg font-bold text-white mb-0.5">User Name</h3>
      <p id="profile-modal-role" class="text-xs text-emerald-400 font-medium mb-2" data-i18n="debater_on_stage">Debater on Stage</p>
      <p id="profile-modal-bio" class="text-xs text-gray-400 italic mb-5 px-2">"Forensic textual examiner & dialectician"</p>

      <button 
        id="profile-modal-donate-btn"
        onclick="openDonateModalFromProfile()" 
        class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-gray-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition flex items-center justify-center gap-2 cursor-pointer mb-2"
      >
        <i data-lucide="gift" class="w-4 h-4"></i>
        <span data-i18n="give_gift_btn">🎁 Send Support / Donation</span>
      </button>

      <!-- Kick Debater from Stage Button -->
      <button 
        id="profile-modal-kick-btn"
        onclick="kickCurrentSeatFromProfile()" 
        class="w-full py-2.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 border border-red-500/40 text-red-400 font-bold text-xs transition flex items-center justify-center gap-2 cursor-pointer hidden"
      >
        <i data-lucide="user-x" class="w-4 h-4"></i>
        <span data-i18n="kick_seat_btn">🚫 Kick from Stage</span>
      </button>

      <p class="text-[10px] text-gray-500 mt-2" data-i18n="payout_note">Supports DANA, GoPay, ShopeePay, OVO, QRIS (10% Platform Fee, 90% Net to Debater)</p>
    </div>
  </div>

  <!-- 3. MULTI E-WALLET DONATION MODAL -->
  <div id="donate-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
    <div class="relative w-full max-w-md mx-4 p-6 rounded-2xl bg-[#121622] border border-amber-500/30 shadow-2xl text-left">
      <button onclick="closeDonateModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="flex items-center gap-3 mb-4 pb-3 border-b border-white/5">
        <img id="donate-recipient-avatar" src="" class="w-12 h-12 rounded-full border border-amber-400">
        <div>
          <p class="text-xs text-gray-400" data-i18n="send_support_for">Send Support for:</p>
          <h3 id="donate-recipient-name" class="text-base font-bold text-white">Markus_P</h3>
        </div>
      </div>

      <!-- Nominal Selection Chips -->
      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-300 mb-2" data-i18n="select_amount_label">Select Donation Amount:</label>
        <div class="grid grid-cols-4 gap-2 mb-2">
          <button type="button" onclick="setDonationAmount(5000)" class="amount-btn px-2 py-2 rounded-lg bg-white/5 hover:bg-amber-400/20 border border-white/10 text-xs font-bold text-white transition text-center cursor-pointer">5k</button>
          <button type="button" onclick="setDonationAmount(10000)" class="amount-btn px-2 py-2 rounded-lg bg-white/5 hover:bg-amber-400/20 border border-white/10 text-xs font-bold text-white transition text-center cursor-pointer">10k</button>
          <button type="button" onclick="setDonationAmount(25000)" class="amount-btn px-2 py-2 rounded-lg bg-amber-400/20 border border-amber-400 text-xs font-bold text-amber-300 transition text-center cursor-pointer">25k</button>
          <button type="button" onclick="setDonationAmount(50000)" class="amount-btn px-2 py-2 rounded-lg bg-white/5 hover:bg-amber-400/20 border border-white/10 text-xs font-bold text-white transition text-center cursor-pointer">50k</button>
        </div>
        <input 
          type="number" 
          id="custom-amount-input" 
          value="25000" 
          oninput="updateSplitPreview()" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-amber-400"
          placeholder="Custom amount (Rp)..."
        >
      </div>

      <!-- Payment Method Selection -->
      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-300 mb-2" data-i18n="select_payment_method">Select Payment Method:</label>
        <div class="grid grid-cols-2 gap-2">
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-blue-500 cursor-pointer">
            <input type="radio" name="payment_method" value="DANA" checked class="text-blue-500">
            <span class="text-xs font-bold text-blue-400">🔵 DANA</span>
          </label>
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500 cursor-pointer">
            <input type="radio" name="payment_method" value="GOPAY" class="text-emerald-500">
            <span class="text-xs font-bold text-emerald-400">🟢 GoPay</span>
          </label>
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-orange-500 cursor-pointer">
            <input type="radio" name="payment_method" value="SHOPEEPAY" class="text-orange-500">
            <span class="text-xs font-bold text-orange-400">🟠 ShopeePay</span>
          </label>
          <label class="flex items-center gap-2.5 p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-purple-500 cursor-pointer">
            <input type="radio" name="payment_method" value="OVO" class="text-purple-500">
            <span class="text-xs font-bold text-purple-400">🟣 OVO</span>
          </label>
        </div>
      </div>

      <!-- Cheer Message -->
      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-300 mb-1" data-i18n="cheer_msg_label">Encouragement Message (Optional):</label>
        <input 
          type="text" 
          id="donate-message-input" 
          placeholder="Excellent grammatical analysis on John 17:3! 🔥" 
          data-i18n-placeholder="cheer_msg_placeholder"
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-amber-400"
        >
      </div>

      <!-- Revenue Split Breakdown Box -->
      <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 mb-4 text-[11px] space-y-1">
        <div class="flex justify-between text-gray-400">
          <span data-i18n="platform_split">Platform Fee (10%):</span>
          <span id="split-fee-preview" class="font-mono text-gray-300">Rp 2,500</span>
        </div>
        <div class="flex justify-between text-emerald-400 font-semibold">
          <span data-i18n="debater_split">Net Received by Debater (90%):</span>
          <span id="split-net-preview" class="font-mono font-bold">Rp 22,500</span>
        </div>
      </div>

      <!-- Submit Donate Button -->
      <button 
        onclick="submitDonation()" 
        class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-gray-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition cursor-pointer"
        data-i18n="confirm_payment_btn"
      >
        Confirm Gift Payment
      </button>
    </div>
  </div>

  <!-- 4. USER WALLET & EARNINGS DASHBOARD MODAL -->
  <div id="wallet-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
    <div class="relative w-full max-w-lg mx-4 p-6 rounded-2xl bg-[#121622] border border-white/10 shadow-2xl text-left">
      <button onclick="closeWalletModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>

      <div class="flex items-center gap-2 mb-4 pb-2 border-b border-white/5">
        <i data-lucide="wallet" class="w-5 h-5 text-emerald-400"></i>
        <h3 class="text-base font-bold text-white" data-i18n="wallet_title">My Wallet & Balances</h3>
      </div>

      <!-- Balance Card -->
      <div class="p-4 rounded-2xl bg-gradient-to-br from-emerald-500/10 to-teal-500/5 border border-emerald-500/20 mb-4 flex items-center justify-between">
        <div>
          <p class="text-xs text-gray-400 mb-0.5" data-i18n="available_balance">Available Net Balance (90% Net):</p>
          <p id="wallet-modal-balance" class="text-2xl font-black text-emerald-400">Rp 0</p>
          <p class="text-[11px] text-gray-400 mt-1"><span data-i18n="platform_treasury">Total Platform Fee Pool:</span> <span id="wallet-treasury-preview" class="text-gray-300 font-mono">Rp 0</span></p>
        </div>
        <button onclick="alert('Withdrawal request submitted successfully to your e-wallet!')" class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-gray-950 font-bold text-xs shadow transition cursor-pointer" data-i18n="withdraw_btn">
          Withdraw Funds
        </button>
      </div>

      <!-- E-Wallet Phone Numbers Settings -->
      <div class="mb-4">
        <p class="text-xs font-bold text-gray-300 mb-2" data-i18n="payout_settings">E-Wallet Receiving Numbers:</p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div>
            <label class="text-[10px] text-gray-400">DANA</label>
            <input type="text" id="wallet-input-dana" value="081234567890" class="w-full bg-white/5 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="text-[10px] text-gray-400">GoPay</label>
            <input type="text" id="wallet-input-gopay" value="081234567890" class="w-full bg-white/5 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="text-[10px] text-gray-400">ShopeePay</label>
            <input type="text" id="wallet-input-shopeepay" value="081234567890" class="w-full bg-white/5 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white">
          </div>
          <div>
            <label class="text-[10px] text-gray-400">OVO</label>
            <input type="text" id="wallet-input-ovo" value="081234567890" class="w-full bg-white/5 border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-white">
          </div>
        </div>
        <button onclick="saveWalletSettings()" class="mt-2 text-xs px-3 py-1 rounded bg-white/10 hover:bg-white/20 text-gray-200 transition" data-i18n="save_wallet_btn">Save E-Wallet Settings</button>
      </div>

      <!-- Transaction History Table -->
      <div>
        <p class="text-xs font-bold text-gray-300 mb-1.5" data-i18n="donation_history">Incoming Donations History:</p>
        <div id="wallet-trx-list" class="max-h-36 overflow-y-auto space-y-1.5 text-xs">
          <p class="text-gray-500 italic text-[11px]" data-i18n="no_transactions">No donation transactions yet.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 5. 2.638 VIDEO CORPUS SEARCH MODAL -->
  <div id="corpus-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
    <div class="relative w-full max-w-2xl mx-4 p-6 rounded-2xl bg-[#121622] border border-indigo-500/20 shadow-2xl text-left">
      <button onclick="closeCorpusModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1 rounded-lg">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>

      <div class="flex items-center gap-2 mb-3">
        <i data-lucide="database" class="w-5 h-5 text-indigo-400"></i>
        <h3 class="text-base font-bold text-white" data-i18n="corpus_title">Explore 2,638 Zuma Debate Video Corpus</h3>
      </div>

      <div class="flex gap-2 mb-4">
        <input 
          type="text" 
          id="corpus-search-input" 
          placeholder="Search debate topics, manuscripts, verses (e.g. 'Trinity', 'John 1:1', 'Matthew 5:17')..." 
          data-i18n-placeholder="corpus_placeholder"
          class="flex-1 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-400"
          onkeydown="if(event.key==='Enter') executeCorpusSearch()"
        >
        <button onclick="executeCorpusSearch()" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition cursor-pointer" data-i18n="corpus_search_btn">
          Search FTS5
        </button>
      </div>

      <div id="corpus-results" class="max-h-72 overflow-y-auto space-y-2 text-xs">
        <p class="text-gray-400 text-center py-4" data-i18n="corpus_empty_msg">Type keywords to search across the 2,638 video catalog.</p>
      </div>
    </div>
  </div>

