    // Client-Side Routing
    function navigateRoute(e, path) {
      if (e) e.preventDefault();
      window.history.pushState({}, "", path);
      dispatchRoute(path);
    }

    window.addEventListener("popstate", () => {
      dispatchRoute(window.location.pathname);
    });

    function handleInitialRoute() {
      dispatchRoute(window.location.pathname);
    }

    function dispatchRoute(path) {
      ["calculator", "dashboard", "themes", "knowledge", "persona", "pipeline", "settings", "account"].forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) el.classList.add("hidden");
      });

      document.querySelectorAll(".side-item").forEach(el => el.classList.remove("active"));

      if (path === "/" || path === "/calculator") {
        document.getElementById("view-calculator").classList.remove("hidden");
      } else if (path === "/dashboard") {
        document.getElementById("view-dashboard").classList.remove("hidden");
        document.querySelectorAll(".side-item")[0].classList.add("active");
      } else if (path.startsWith("/themes")) {
        document.getElementById("view-themes").classList.remove("hidden");
        document.querySelectorAll(".side-item")[2].classList.add("active");
        if (path.length > 7) {
          openThemeDetail("friksi-paulus-vs-petrus");
        }
      } else if (path.startsWith("/knowledge")) {
        document.getElementById("view-knowledge").classList.remove("hidden");
        document.querySelectorAll(".side-item")[3].classList.add("active");
      } else if (path.startsWith("/persona")) {
        document.getElementById("view-persona").classList.remove("hidden");
        document.querySelectorAll(".side-item")[4].classList.add("active");
      } else if (path.startsWith("/pipeline")) {
        document.getElementById("view-pipeline").classList.remove("hidden");
        document.querySelectorAll(".side-item")[5].classList.add("active");
      } else if (path.startsWith("/settings")) {
        document.getElementById("view-settings").classList.remove("hidden");
        document.querySelectorAll(".side-item")[6].classList.add("active");
      } else if (path.startsWith("/account") || path.startsWith("/checkout")) {
        document.getElementById("view-account").classList.remove("hidden");
        fetchBillingHistory();
        document.querySelectorAll(".side-item")[7].classList.add("active");
      }
    }

    // Staging GatewayFlow Dynamic Background Initialization
    (function initGatewayFlow() {
      const isStaging = window.location.hostname === "staging.apologets.com" || window.location.hostname === "localhost" || window.location.port === "8001";
      const canvas = document.getElementById('flow-canvas');
      if (!canvas || !isStaging) return;

      canvas.style.display = 'block';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let width = 0, height = 0;
      let explosions = [];

      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
      }
      window.addEventListener('resize', resize, { passive: true });
      resize();

      window.addEventListener('pointerdown', (e) => {
        explosions.push({ x: e.clientX, y: e.clientY, radius: 0, life: 1 });
      }, { passive: true });

      const paths = [];
      const numPaths = 60;
      for (let i = 0; i < numPaths; i++) {
        paths.push({
          isLeft: i % 2 === 0,
          startY: (i / numPaths) * height * 1.4 - height * 0.2,
          particles: [{
            t: Math.random(),
            speed: 0.0012 + Math.random() * 0.0018
          }]
        });
      }

      function getBezierPoint(t, p0, p1, p2, p3) {
        const u = 1 - t;
        return {
          x: (u ** 3) * p0.x + 3 * (u ** 2) * t * p1.x + 3 * u * (t ** 2) * p2.x + (t ** 3) * p3.x,
          y: (u ** 3) * p0.y + 3 * (u ** 2) * t * p1.y + 3 * u * (t ** 2) * p2.y + (t ** 3) * p3.y
        };
      }

      let animId;
      function render() {
        ctx.clearRect(0, 0, width, height);
        const centerX = width / 2;
        const centerY = height / 2;

        explosions.forEach(exp => {
          exp.radius += 12;
          exp.life -= 0.02;
        });
        explosions = explosions.filter(exp => exp.life > 0);

        paths.forEach(path => {
          const p0 = { x: path.isLeft ? 0 : width, y: path.startY };
          const p1 = { x: path.isLeft ? centerX * 0.5 : width - centerX * 0.5, y: path.startY };
          const p2 = { x: path.isLeft ? centerX * 0.8 : width - centerX * 0.8, y: centerY };
          const p3 = { x: centerX, y: centerY };

          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
          ctx.strokeStyle = 'rgba(14, 165, 233, 0.16)';
          ctx.lineWidth = 1;
          ctx.setLineDash([2, 5]);
          ctx.stroke();
          ctx.setLineDash([]);

          path.particles.forEach(p => {
            p.t += p.speed;
            if (p.t > 1) {
              p.t = 0;
              path.startY += (Math.random() - 0.5) * 12;
            }

            let pos = getBezierPoint(p.t, p0, p1, p2, p3);
            let dxTotal = 0, dyTotal = 0;

            explosions.forEach(exp => {
              const dx = pos.x - exp.x;
              const dy = pos.y - exp.y;
              const dist = Math.hypot(dx, dy);
              if (dist < exp.radius + 100 && dist > Math.max(0, exp.radius - 100)) {
                const force = (1 - Math.abs(dist - exp.radius) / 100) * exp.life;
                dxTotal += (dx / (dist || 1)) * force * 60;
                dyTotal += (dy / (dist || 1)) * force * 60;
              }
            });

            pos.x += dxTotal;
            pos.y += dyTotal;

            ctx.fillStyle = 'rgba(56, 189, 248, 0.75)';
            ctx.fillRect(pos.x - 1.5, pos.y - 1.5, 3, 3);
          });
        });

        animId = requestAnimationFrame(render);
      }

      render();
    })();
  </script>
