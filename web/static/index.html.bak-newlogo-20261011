        google.accounts.id.initialize({
          client_id: "953116755250-p8n0eqgrsb84k7tfakptmb3nuccjn6vr.apps.googleusercontent.com",
          callback: async (resp) => {
            if (!resp || !resp.credential) {
              alert("Autentikasi dibatalkan atau token tidak diterima dari Google.");
              return;
            }
            if (btn) btn.textContent = "Authenticating...";
            try {
              const res = await fetch("/api/v1/auth/session", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  credential: resp.credential,
                  is_mock: false
                })
              });
              const data = await res.json();
              if (res.ok && data.success) {
                setAuthSession(data.session_token, data.user);
                await fetchUsage();
                await fetchBillingHistory();
              } else {
                if (btn) btn.textContent = "Google Sign-In";
                alert("Login gagal (" + res.status + "): " + (data.detail || data.message || "Verifikasi ID token Google ditolak backend"));
              }
            } catch (err) {
              if (btn) btn.textContent = "Google Sign-In";
              console.error("Auth error:", err);
              alert("Koneksi ke backend gagal: " + err.message);
