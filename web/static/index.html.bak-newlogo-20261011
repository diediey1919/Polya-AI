  <script>
    let currentUserId = "guest_user";
    let userContext = {
      ui_locale: "id",
      user_perspective: "christian",
      opponent_perspective: "islam",
      debate_locale: "id",
      source_locale: "el"
    };
    let currentUsage = { used: 0, max: 5, remaining: 5, is_locked: false, is_premium: false };
    let currentLanguages = [];
    let activeOrderId = "";

    const DEMO_CLAIMS = [
      "Yesus tidak pernah secara langsung berkata, 'Aku adalah Tuhan.'",
      "Yohanes 10:30 hanya berarti Yesus dan Bapa memiliki tujuan yang sama, bukan bahwa mereka satu hakikat.",
      "Paulus menghapus kewajiban Taurat bagi orang Kristen.",
      "Jika Yesus adalah Tuhan, mengapa Yesus berdoa kepada Tuhan di Getsemani?",
      "Al-Qur’an tidak mengajarkan bahwa Yesus disalibkan.",
      "Doktrin Tritunggal adalah doktrin yang muncul kemudian dan bukan ajaran asli Yesus.",
      "Alkitab telah mengalami perubahan sehingga tidak dapat dijadikan dasar yang dapat dipercaya.",
      "Muhammad tidak pernah disebut atau dinubuatkan dalam Alkitab.",
      "Keselamatan dalam Kekristenan bertentangan dengan keadilan karena manusia dihukum akibat dosa Adam.",
      "Jika Al-Qur’an benar-benar berasal dari Tuhan, mengapa terdapat perbedaan dengan kitab-kitab sebelumnya?"
    ];

    document.addEventListener("DOMContentLoaded", async () => {
      restoreSession();
      await fetchLanguages();
      await fetchUsage();
      renderDemoClaims();
      checkOnboardingStatus();
      handleInitialRoute();

      // Keyboard shortcut Ctrl+K
      document.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "k") {
          e.preventDefault();
          openSearchModal();
        }
        if (e.key === "Escape") {
          closeSearchModal();
          closeSourceDrawer();
        }
      });
    });

    function checkOnboardingStatus() {
      const stored = localStorage.getItem("polya_onboarding_completed");
      if (!stored) {
        document.getElementById("onboarding-modal").classList.remove("hidden");
        document.getElementById("onboarding-step-1").classList.remove("hidden");
        document.getElementById("onboarding-step-2").classList.add("hidden");
      } else {
        const savedCtx = localStorage.getItem("polya_user_context");
        if (savedCtx) {
          try {
            userContext = JSON.parse(savedCtx);
            applyContextToUI();
          } catch(e){}
        }
      }
    }

    async function fetchLanguages() {
      try {
        const res = await fetch("/api/v1/meta/languages");
        const data = await res.json();
        currentLanguages = data.languages;
        renderLanguageGrid(data.languages);
      } catch (err) {
        console.error("Failed to load languages:", err);
      }
    }

    function renderLanguageGrid(languages) {
      const container = document.getElementById("language-grid");
      container.innerHTML = "";
      languages.forEach(l => {
        const btn = document.createElement("button");
        btn.className = `choice-btn ${l.code === userContext.ui_locale ? 'active' : ''}`;
        btn.innerHTML = `<span class="native-label">${l.native}</span><span class="sub-label">${l.name} (${l.dir.toUpperCase()})</span>`;
        btn.onclick = () => selectLanguage(l.code, l.dir);
        container.appendChild(btn);
      });
    }

    function selectLanguage(code, dir) {
      userContext.ui_locale = code;
      document.querySelectorAll(".choice-btn").forEach(b => b.classList.remove("active"));
      event.currentTarget.classList.add("active");
      document.documentElement.dir = dir || "ltr";
      document.getElementById("badge-lang").textContent = code.toUpperCase();
    }

    function proceedToPerspectiveStep() {
      document.getElementById("onboarding-step-1").classList.add("hidden");
      document.getElementById("onboarding-step-2").classList.remove("hidden");
    }

    function selectPerspective(perspective) {
      userContext.user_perspective = perspective;
      userContext.opponent_perspective = (perspective === "christian") ? "islam" : "christian";
      document.getElementById("persp-christian").classList.toggle("active", perspective === "christian");
      document.getElementById("persp-islam").classList.toggle("active", perspective === "islam");
      applyContextToUI();
    }

    async function completeOnboarding() {
      localStorage.setItem("polya_onboarding_completed", "true");
      localStorage.setItem("polya_user_context", JSON.stringify(userContext));
      document.getElementById("onboarding-modal").classList.add("hidden");
      applyContextToUI();

      try {
        await fetch(`/api/v1/context?user_id=${currentUserId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(userContext)
        });
      } catch(e){}
    }

    function resetOnboardingForDemo() {
      localStorage.removeItem("polya_onboarding_completed");
      checkOnboardingStatus();
    }

    function applyContextToUI() {
      const p = userContext.user_perspective;
      const label = (p === "christian") ? "✝ Kristen" : "☪ Islam";
      document.getElementById("badge-perspective").textContent = label;
      document.getElementById("badge-lang").textContent = userContext.ui_locale.toUpperCase();
      document.getElementById("dash-persp-val").textContent = (p === "christian") ? "✝ Apologetics Kristen" : "☪ Apologetics Islam";
    }

    function renderDemoClaims() {
      const container = document.getElementById("demo-claims-container");
      container.innerHTML = "";
      DEMO_CLAIMS.forEach((claim, idx) => {
        const pill = document.createElement("button");
        pill.className = "claim-pill";
        pill.textContent = `${idx + 1}. ${claim}`;
        pill.onclick = () => {
          document.getElementById("claim-input").value = claim;
          runAnalysis();
        };
        container.appendChild(pill);
      });
    }

    function focusCalculator() {
      document.getElementById("calc-anchor").scrollIntoView({ behavior: "smooth" });
      const el = document.getElementById("claim-input");
      el.focus();
      el.selectionStart = el.selectionEnd = el.value.length;
    }

    async function fetchUsage() {
      try {
        const res = await fetch(`/api/v1/entitlements/usage?user_id=${currentUserId}`);
        const data = await res.json();
        currentUsage = data;
        updateUsageUI();
      } catch (e) {
        console.error("Usage fetch failed:", e);
      }
    }

    function updateUsageUI() {
      const pill = document.getElementById("badge-quota-display");
      const calcPill = document.getElementById("calc-quota-pill");
      const dashPill = document.getElementById("dash-quota-val");
      const accUsed = document.getElementById("acc-used-count");
      const accTier = document.getElementById("acc-tier-display");

      if (currentUsage.is_premium) {
        pill.textContent = "PREMIUM";
        pill.className = "badge-pill badge-premium";
        calcPill.textContent = "Polya Premium (Unlimited)";
        calcPill.className = "badge-pill badge-premium";
        dashPill.textContent = "UNLIMITED";
        dashPill.style.color = "var(--gold)";
        document.getElementById("dash-plan-val").textContent = "PREMIUM ACTIVE";
        accTier.textContent = "PREMIUM ACTIVE";
        accUsed.textContent = "Unlimited";
      } else {
        const rem = currentUsage.remaining;
        pill.textContent = `${rem}/5 Free`;
        pill.className = "badge-pill badge-quota";
        calcPill.textContent = `${rem} analisis gratis tersisa`;
        dashPill.textContent = `${rem} / 5 Free`;
        accUsed.textContent = currentUsage.used;
        accTier.textContent = "FREE TIER";
      }
    }

    async function runAnalysis() {
      const claim = document.getElementById("claim-input").value.trim();
      if (!claim) return;

      const requestId = `req_${Date.now()}_${Math.random().toString(36).substring(7)}`;

      try {
        const res = await fetch("/api/v1/calculator/analyze", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            claim: claim,
            request_id: requestId,
            user_id: currentUserId,
            context: userContext
          })
        });

        if (res.status === 402) {
          document.getElementById("premium-gate-modal").classList.remove("hidden");
          return;
        }

        const data = await res.json();
        if (data.success && data.case_file) {
          renderCaseFile(data.case_file);
          currentUsage = data.usage;
          updateUsageUI();
        }
      } catch (err) {
        console.error("Analysis execution error:", err);
      }
    }

    function renderCaseFile(cf) {
      const resCard = document.getElementById("case-file-result");
      resCard.classList.remove("hidden");

      document.getElementById("case-id-display").textContent = cf.case_id;
      document.getElementById("case-claim-display").textContent = cf.claim;
      document.getElementById("case-context-display").textContent = cf.context;
      document.getElementById("case-argument-content").textContent = cf.argument;
      document.getElementById("case-rebuttal-content").textContent = cf.rebuttal;
      document.getElementById("case-weakness-content").textContent = cf.weakness;

      const evBox = document.getElementById("case-evidence-content");
      evBox.innerHTML = cf.evidence.map(e => `
        <div style="margin-bottom: 0.75rem;">
          <span class="evidence-badge badge-primary-source">${e.language || 'PRIMARY'}</span>
          <p class="greek-text" style="margin-top: 0.25rem;">${e.source_text}</p>
          <p style="font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono);">${e.transliteration || ''}</p>
          <p style="font-size: 0.85rem; margin-top: 0.25rem;">${e.morphology}</p>
        </div>
      `).join('');

      const sBody = document.getElementById("case-sources-body");
      sBody.innerHTML = cf.sources.map(s => `
        <tr>
          <td>${s.citation}</td>
          <td><span class="evidence-badge badge-direct">${s.type}</span></td>
          <td><button class="btn-primary" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;" onclick="openSourceDrawer()">Inspect</button></td>
        </tr>
      `).join('');

      resCard.scrollIntoView({ behavior: "smooth" });
    }

    // Source Drawer
    function openSourceDrawer() {
      document.getElementById("source-drawer").classList.add("open");
    }
    function closeSourceDrawer() {
      document.getElementById("source-drawer").classList.remove("open");
    }

    // Global Search Modal
    function openSearchModal() {
      document.getElementById("search-modal").classList.remove("hidden");
      document.getElementById("global-search-input").focus();
    }
    function closeSearchModal() {
      document.getElementById("search-modal").classList.add("hidden");
    }
    function handleGlobalSearch(e) {
      // Mock filter
    }

    // Mode Toggle
    let currentCalcMode = "debate";
    function setMode(mode) {
      currentCalcMode = mode;
      const btnDebate = document.getElementById("btn-mode-debate");
      const btnResearch = document.getElementById("btn-mode-research");
      if (btnDebate && btnResearch) {
        if (mode === "debate") {
          btnDebate.style.background = "var(--primary)";
          btnDebate.style.color = "#040914";
          btnDebate.style.fontWeight = "600";
          btnResearch.style.background = "var(--bg-card)";
          btnResearch.style.color = "var(--text-muted)";
          btnResearch.style.fontWeight = "400";
        } else {
          btnResearch.style.background = "var(--primary)";
          btnResearch.style.color = "#040914";
          btnResearch.style.fontWeight = "600";
          btnDebate.style.background = "var(--bg-card)";
          btnDebate.style.color = "var(--text-muted)";
          btnDebate.style.fontWeight = "400";
        }
      }
    }

    // Theme Tabs
    function openThemeDetail(themeId) {
      document.getElementById("theme-detail-container").classList.remove("hidden");
      document.getElementById("theme-detail-container").scrollIntoView({ behavior: "smooth" });
    }
    function closeThemeDetail() {
      document.getElementById("theme-detail-container").classList.add("hidden");
    }
    function switchThemeTab(tabName) {
      document.querySelectorAll("#theme-detail-container .tab-btn").forEach(b => b.classList.remove("active"));
      event.currentTarget.classList.add("active");

      ["overview", "narrative", "debate", "evidence", "provenance", "evaluation"].forEach(t => {
        const el = document.getElementById(`theme-tab-${t}`);
        if (el) el.classList.toggle("hidden", t !== tabName);
      });
    }

    // Knowledge Tabs
    function switchKnowledgeTab(tabName) {
      document.querySelectorAll("#view-knowledge .tab-btn").forEach(b => b.classList.remove("active"));
      event.currentTarget.classList.add("active");

      ["graph", "claims", "evidence"].forEach(t => {
        const el = document.getElementById(`knowledge-tab-${t}`);
        if (el) el.classList.toggle("hidden", t !== tabName);
      });
    }

    // Paywall & Midtrans
    function closeGateModal() {
      document.getElementById("premium-gate-modal").classList.add("hidden");
    }

    let currentSnapToken = null;

    async function openCheckoutModal() {
      closeGateModal();
      document.getElementById("checkout-modal").classList.remove("hidden");
      document.getElementById("checkout-order-id").textContent = "Membuat pesanan...";
      const payBtn = document.getElementById("btn-snap-pay");
      if (payBtn) payBtn.disabled = true;

      try {
        const res = await fetch("/api/v1/payment/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_id: currentUserId })
        });
        const tx = await res.json();
        activeOrderId = tx.order_id;
        currentSnapToken = tx.snap_token;
        document.getElementById("checkout-order-id").textContent = tx.order_id;
        if (payBtn) payBtn.disabled = false;
      } catch (e) {
        console.error("Checkout initiation failed:", e);
        document.getElementById("checkout-order-id").textContent = "Gagal membuat pesanan";
      }
    }

    function closeCheckoutModal() {
      document.getElementById("checkout-modal").classList.add("hidden");
    }

    function payWithMidtransSnap() {
      if (!currentSnapToken) {
        alert("Token transaksi Midtrans belum siap. Coba sesaat lagi.");
        return;
      }

      if (window.snap && typeof window.snap.pay === "function") {
        window.snap.pay(currentSnapToken, {
          onSuccess: async function(result) {
            console.log("Midtrans payment success:", result);
            closeCheckoutModal();
            alert("Pembayaran berhasil! Akun kamu kini POLYA PREMIUM.");
            await fetchUsage();
            await fetchBillingHistory();
          },
          onPending: async function(result) {
            console.log("Midtrans payment pending:", result);
            closeCheckoutModal();
            alert("Pembayaran sedang diproses (Pending). Silakan selesaikan pembayaran sesuai instruksi.");
            await fetchBillingHistory();
          },
          onError: function(result) {
            console.error("Midtrans payment error:", result);
            alert("Terjadi kesalahan pada pembayaran Midtrans.");
          },
          onClose: function() {
            console.log("Snap modal closed by customer.");
          }
        });
      } else {
        alert("SDK Midtrans Snap belum terhubung atau terblokir. Silakan coba sesaat lagi.");
      }
    }

    function getStoredToken() {
      return sessionStorage.getItem("polya_session_token") || localStorage.getItem("polya_session_token");
    }

    function setAuthSession(token, user) {
      if (token) {
        sessionStorage.setItem("polya_session_token", token);
        localStorage.setItem("polya_session_token", token);
      }
      if (user) {
        const userJson = JSON.stringify(user);
        sessionStorage.setItem("polya_user", userJson);
        localStorage.setItem("polya_user", userJson);
        currentUserId = user.user_id;
        updateAuthUI(user);
      }
    }

    function handleSignOut() {
      sessionStorage.removeItem("polya_session_token");
      localStorage.removeItem("polya_session_token");
      sessionStorage.removeItem("polya_user");
      localStorage.removeItem("polya_user");
      currentUserId = "guest_user";
      updateAuthUI(null);
    }

    function updateAuthUI(user) {
      const btn = document.getElementById("btn-auth-header");
      const accName = document.getElementById("acc-name");
      const accEmail = document.getElementById("acc-email");

      if (user && user.name) {
        if (btn) {
          btn.textContent = user.name + " (Logout)";
          btn.style.background = "var(--bg-card)";
          btn.style.color = "var(--primary)";
          btn.onclick = handleSignOut;
        }
        if (accName) accName.textContent = user.name;
        if (accEmail) accEmail.textContent = user.email || "";
      } else {
        if (btn) {
          btn.textContent = "Google Sign-In";
          btn.style.background = "";
          btn.style.color = "";
          btn.onclick = triggerGoogleAuth;
        }
        if (accName) accName.textContent = "Guest Researcher";
        if (accEmail) accEmail.textContent = "guest@polya.org";
      }
    }

    function restoreSession() {
      const token = getStoredToken();
      const rawUser = sessionStorage.getItem("polya_user") || localStorage.getItem("polya_user");
      if (token && rawUser) {
        try {
          const user = JSON.parse(rawUser);
          currentUserId = user.user_id || "guest_user";
          updateAuthUI(user);
        } catch (e) {
          handleSignOut();
        }
      } else {
        updateAuthUI(null);
      }
    }

    async function fetchBillingHistory() {
      try {
        const token = getStoredToken();
        const headers = {};
        if (token) {
          headers["Authorization"] = `Bearer ${token}`;
        }
        const res = await fetch(`/api/v1/account/billing?user_id=${currentUserId}`, { headers });
        if (res.status === 401) {
          handleSignOut();
          const tbody = document.getElementById("billing-ledger-body");
          if (tbody) tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; color: var(--rose);">Sesi telah kedaluwarsa. Silakan login kembali.</td></tr>`;
          return;
        }
        const data = await res.json();
        const tbody = document.getElementById("billing-ledger-body");
        if (data.transactions && data.transactions.length > 0) {
          tbody.innerHTML = data.transactions.map(t => `
            <tr>
              <td style="font-family: var(--font-mono);">${t.order_id}</td>
              <td>Rp ${t.amount.toLocaleString()}</td>
              <td>Midtrans</td>
              <td><span class="badge-pill badge-quota" style="background: rgba(16, 185, 129, 0.15); color: var(--emerald);">${t.internal_status}</span></td>
              <td>${new Date(t.created_at).toLocaleDateString()}</td>
            </tr>
          `).join('');
        }
      } catch (e){}
    }

    // Google Auth
    async function triggerGoogleAuth() {
      const btn = document.getElementById("btn-auth-header");
      const isStagingOrigin = window.location.origin === "https://staging.apologets.com";

      if (isStagingOrigin) {
        if (!window.google || !window.google.accounts || !window.google.accounts.id) {
