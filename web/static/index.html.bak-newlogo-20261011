  </script>
  <style>
    :root {
      /* Editorial Modern Monolith — Semantic Neutral Slate + Pure Cyan */
      --bg-base: #090a0f;
      --bg-surface: #10121a;
      --bg-card: #141722;
      --bg-card-hover: #1b1f2e;
      --bg-card-active: #22273b;

      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-card: rgba(255, 255, 255, 0.06);
      --border-focus: #0ea5e9;

      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;

      /* Single Sharp Accent Color Token */
      --primary: #0ea5e9;
      --primary-glow: rgba(14, 165, 233, 0.2);
      --accent: #38bdf8;
      --gold: #e2e8f0;
      --emerald: #0ea5e9;
      --rose: #f43f5e;
      --purple: #0ea5e9;

      --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-pill: 9999px;

      --shadow-card: 0 1px 3px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.04);
      --shadow-hover: 0 6px 20px -2px rgba(0,0,0,0.6), 0 0 0 1px rgba(14,165,233,0.22);
    }

    [dir="rtl"] { text-align: right; }
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      max-width: 100%;
      overflow-x: hidden;
      width: 100%;
    }

    body {
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.05), transparent 50%),
        radial-gradient(circle at 90% 20%, rgba(14, 165, 233, 0.04), transparent 40%);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      max-width: 100%;
      width: 100%;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Modal / Onboarding Overlay */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 14, 0.88);
      backdrop-filter: blur(10px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      max-width: 650px;
      width: 100%;
      padding: 2.25rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
      position: relative;
    }

    .modal-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .modal-sub {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .choice-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 0.75rem;
      max-height: 300px;
      overflow-y: auto;
      margin-bottom: 1.25rem;
      padding-right: 0.25rem;
    }

    .choice-btn {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      transition: all 0.15s ease;
    }

    .choice-btn:hover, .choice-btn.active {
      border-color: var(--primary);
      background: var(--bg-card-hover);
      box-shadow: 0 0 12px var(--primary-glow);
    }

    .choice-btn .native-label { font-weight: 600; }
    .choice-btn .sub-label { font-size: 0.7rem; color: var(--text-dim); }

    .perspective-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .perspective-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      cursor: pointer;
      text-align: center;
      transition: all 0.15s ease;
    }

    .perspective-card:hover, .perspective-card.active {
      border-color: var(--primary);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }

    .perspective-card .icon { font-size: 2rem; margin-bottom: 0.5rem; }
    .perspective-card h4 { font-size: 1.05rem; margin-bottom: 0.5rem; font-weight: 600; }
    .perspective-card p { font-size: 0.8rem; color: var(--text-muted); }

    .callout {
      background: rgba(14, 165, 233, 0.05);
      border-inline-start: 3px solid var(--primary);
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 0.825rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .btn-primary {
      background: var(--primary);
      color: #040914;
      font-weight: 600;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      font-size: 0.88rem;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      background: #5dfce7;
      box-shadow: 0 0 15px var(--primary-glow);
    }

    /* Minimal Top Command Bar (Clay + Deepgram Console) */
    .app-header {
      background: rgba(12, 16, 23, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-logo {
      height: 38px;
      width: auto;
      object-fit: contain;
      border-radius: var(--radius-sm);
      display: block;
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .brand:hover .brand-logo {
      opacity: 0.92;
      transform: scale(1.02);
    }

    .brand-mark {
      width: 30px;
      height: 30px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: var(--radius-sm);
      display: grid;
      place-items: center;
      font-family: var(--font-mono);
      font-weight: 700;
      color: #040914;
      font-size: 1rem;
    }

    .brand-text h1 { font-size: 1rem; font-weight: 700; letter-spacing: 0.05em; }
    .brand-text span { font-size: 0.65rem; color: var(--primary); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }

    .header-meta { display: flex; align-items: center; gap: 0.75rem; }

    .record-chip {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      font-weight: 500;
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      background: var(--emerald);
      border-radius: 50%;
      display: inline-block;
      box-shadow: 0 0 8px var(--emerald);
      animation: pulseAnimation 2s infinite ease-in-out;
    }

    @keyframes pulseAnimation {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.22rem 0.65rem;
      border-radius: var(--radius-pill);
      font-size: 0.72rem;
      font-family: var(--font-mono);
      font-weight: 600;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card);
    }

    .badge-quota { color: var(--primary); border-color: rgba(14, 165, 233, 0.3); }

    .kbd-shortcut {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-subtle);
      color: var(--text-dim);
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      cursor: pointer;
    }

    /* App Body & Sidebar */
    .app-body { display: flex; flex: 1; }

    .app-sidebar {
      width: 240px;
      background: var(--bg-surface);
      border-inline-end: 1px solid var(--border-subtle);
      padding: 1rem 0.65rem;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .sidebar-heading {
      font-size: 0.65rem;
      font-family: var(--font-mono);
      text-transform: uppercase;
      color: var(--text-dim);
      letter-spacing: 0.08em;
      padding: 0.5rem 0.75rem 0.25rem 0.75rem;
      font-weight: 600;
    }

    .side-item {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.5rem 0.75rem;
      border-radius: var(--radius-sm);
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.84rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.12s;
    }

    .side-item:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.04);
    }

    .side-item.active {
      color: var(--text-main);
      background: var(--bg-card);
      border-inline-start: 2px solid var(--primary);
    }

    .app-main {
      flex: 1;
      padding: 1.75rem 2.25rem;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    /* Cards & Grids */
    .case-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      padding: 1.25rem;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .case-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow: var(--shadow-hover);
    }

    .case-card h4 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--primary);
      margin-bottom: 0.4rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-top: 1rem;
    }

    .hero-container {
      text-align: center;
      max-width: 800px;
      margin: 1.5rem auto 2.5rem auto;
    }

    .hero-title {
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .hero-copy {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .calculator-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .calc-input-wrapper {
      position: relative;
      margin-bottom: 1.25rem;
      border-radius: var(--radius-md);
      transition: all 0.2s ease;
    }

    .calc-input-wrapper:focus-within {
      box-shadow: 0 0 0 2px var(--primary), 0 0 25px var(--primary-glow);
    }

    .calc-input-icon {
      position: absolute;
      left: 1.25rem;
      top: 1.25rem;
      color: var(--primary);
      font-size: 1.35rem;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    [dir="rtl"] .calc-input-icon {
      left: auto;
      right: 1.25rem;
    }

    .calc-input {
      width: 100%;
      min-height: 200px;
      max-height: 500px;
      resize: vertical;
      background: var(--bg-base);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.15rem 1.25rem 1.15rem 3.5rem;
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 1.12rem;
      font-weight: 400;
      line-height: 1.65;
      outline: none;
      white-space: pre-wrap;
      word-break: break-word;
      overflow-wrap: break-word;
      overflow-y: auto;
      box-sizing: border-box;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    [dir="rtl"] .calc-input {
      padding: 1.15rem 3.5rem 1.15rem 1.25rem;
    }

    .calc-input::placeholder {
      color: var(--text-dim);
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.5;
    }

    .calc-input:focus {
      border-color: var(--primary);
    }

    .calc-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .claim-pill-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }

    .claim-pill {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 0.4rem 0.8rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.12s ease;
      text-align: left;
    }

    .claim-pill:hover {
      border-color: var(--primary);
      color: var(--text-main);
      background: var(--bg-card-hover);
    }

    .evidence-badge {
      font-size: 0.68rem;
      font-family: var(--font-mono);
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .badge-primary-source { background: rgba(14, 165, 233, 0.12); color: var(--primary); border: 1px solid rgba(14, 165, 233, 0.35); }
    .badge-direct { background: rgba(16, 185, 129, 0.12); color: var(--emerald); border: 1px solid var(--emerald); }
    .badge-disputed { background: rgba(244, 63, 94, 0.12); color: var(--rose); border: 1px solid var(--rose); }

    /* Pipeline Step Node (Solves raw text & LaTeX bug) */
    .pipeline-flow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
      margin: 0.75rem 0;
    }

    .pipeline-node {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.75rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      font-family: var(--font-mono);
      color: var(--text-main);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }

    .pipeline-arrow {
      color: var(--primary);
      font-size: 0.82rem;
      font-weight: bold;
    }

    /* Tabs Navigation */
    .tabs-nav {
      display: flex;
      gap: 0.5rem;
      border-bottom: 1px solid var(--border-subtle);
      margin-bottom: 1.5rem;
      padding-bottom: 0.25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      white-space: nowrap;
      scrollbar-width: none;
    }

    .tabs-nav::-webkit-scrollbar {
      display: none;
    }

    .tab-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      padding: 0.5rem 1rem;
      font-family: var(--font-sans);
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: all 0.15s;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .tab-btn:hover { color: var(--text-main); }
    .tab-btn.active {
      color: var(--primary);
      border-bottom-color: var(--primary);
      font-weight: 600;
    }

    .greek-text {
      font-family: var(--font-mono);
      font-size: 1.05rem;
      color: var(--primary);
      padding: 0.75rem 1rem;
      background: rgba(14, 165, 233, 0.04);
      border-radius: var(--radius-sm);
      border: 1px solid rgba(14, 165, 233, 0.2);
    }

    /* Source Drawer */
    .source-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: 440px;
      height: 100vh;
      background: var(--bg-surface);
      border-left: 1px solid var(--border-subtle);
      box-shadow: -10px 0 30px rgba(0,0,0,0.6);
      z-index: 1200;
      padding: 2rem;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
      visibility: hidden;
      display: none;
    }

    .source-drawer.open {
      transform: translateX(0);
      visibility: visible;
      display: block;
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-top: 1rem;
    }

    .search-box {
      width: 100%;
      background: var(--bg-base);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: var(--text-main);
      font-family: var(--font-sans);
      font-size: 0.9rem;
      outline: none;
      margin-bottom: 1rem;
    }

    .search-box:focus {
      border-color: var(--primary);
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      background: var(--bg-card);
      border-radius: var(--radius-sm);
      overflow: hidden;
      font-size: 0.85rem;
    }

    .data-table th, .data-table td {
      padding: 0.75rem 1rem;
      text-align: left;
      border-bottom: 1px solid var(--border-subtle);
    }

    .data-table th {
      background: var(--bg-surface);
      color: var(--text-dim);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-family: var(--font-mono);
    }

    .hidden { display: none !important; }

    @media (max-width: 768px) {
      /* Minimal Top Command Bar mobile layout */
      .app-header {
        height: 52px;
        padding: 0 0.85rem;
        justify-content: space-between;
      }
      .header-brand-wrap {
        gap: 0.5rem !important;
      }
      .brand-logo {
        height: 32px;
      }
      .brand-mark {
        width: 28px;
        height: 28px;
        font-size: 0.85rem;
      }
      .brand-text h1 {
        font-size: 0.9rem;
      }
      .brand-text span {
        font-size: 0.55rem;
      }
      .header-divider,
      .header-breadcrumb,
      #top-breadcrumb,
      .header-search-btn,
      #badge-engine-status,
      #badge-perspective {
        display: none !important;
      }
      .header-meta {
        gap: 0.45rem;
      }
      .badge-quota {
        font-size: 0.68rem;
        padding: 0.2rem 0.45rem;
      }
      #btn-auth-header {
        font-size: 0.75rem;
        padding: 0.28rem 0.65rem;
      }

      /* Horizontal Category Pill Sidebar */
      .app-body {
        flex-direction: column;
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
      }
      .app-sidebar {
        width: 100%;
        max-width: 100vw;
        border-inline-end: none;
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 0.45rem 0.75rem;
        gap: 0.45rem;
        scrollbar-width: none;
        box-sizing: border-box;
      }
      .app-sidebar::-webkit-scrollbar {
        display: none;
      }
      .app-sidebar .sidebar-heading {
        display: none;
      }
      .side-item {
        white-space: nowrap;
        flex-shrink: 0;
        padding: 0.38rem 0.75rem;
        font-size: 0.78rem;
        border-radius: var(--radius-pill);
        background: rgba(255, 255, 255, 0.03);
