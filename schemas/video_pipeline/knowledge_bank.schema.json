{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeBankSchema",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_records",
    "entities",
    "topics",
    "relationships",
    "provenance_index"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "canonical_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "canonical_key",
          "topic",
          "claim_type",
          "content",
          "verification_status",
          "confidence",
          "provenance_chain"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "canonical_key": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "claim_type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "verification_status": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "provenance_chain": {
            "type": "object",
            "required": [
              "video_id",
              "source_url",
              "segment_id",
              "timestamp",
              "speaker"
            ],
            "properties": {
              "video_id": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "segment_id": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "canonical_name",
          "category",
          "aliases"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "name",
          "domain",
          "description"
        ],
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_id",
          "from_entity_or_record",
          "to_entity_or_record",
          "type"
        ],
        "properties": {
          "relation_id": {
            "type": "string"
          },
          "from_entity_or_record": {
            "type": "string"
          },
          "to_entity_or_record": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "provenance_index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "video_id",
          "segment_id",
          "timestamp",
          "source_url"
        ],
        "properties": {
          "video_id": {
            "type": "string"
          },
          "segment_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        }
      }
    }
  }
}