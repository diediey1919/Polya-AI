{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalVersificationManifestProductionSchema",
  "description": "Production schema for 66-book Protestant canonical versification manifests.",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "canon_id",
    "versification_system",
    "source_name",
    "source_version",
    "source_url",
    "license",
    "source_checksum_sha256",
    "manifest_checksum_sha256",
    "total_books",
    "total_chapters",
    "total_verses",
    "normalization_method",
    "books"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^MANIFEST-[A-Z0-9_-]+$"
    },
    "canon_id": {
      "type": "string",
      "enum": ["CANON-PROTESTANT-66"]
    },
    "versification_system": {
      "type": "string",
      "enum": [
        "PROTESTANT_KJV_STANDARD",
        "MASORETIC_HISTORICAL",
        "LAI_TB_INDONESIAN",
        "SEPTUAGINT_HISTORICAL"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "source_checksum_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_checksum_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "total_books": {
      "type": "integer",
      "enum": [66]
    },
    "total_chapters": {
      "type": "integer",
      "enum": [1189]
    },
    "total_verses": {
      "type": "integer",
      "minimum": 30000,
      "maximum": 33000
    },
    "normalization_method": {
      "type": "string"
    },
    "books": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": {
        "type": "object",
        "required": [
          "book_id",
          "canonical_order",
          "standard_name",
          "chapter_count",
          "total_verses",
          "chapters"
        ],
        "properties": {
          "book_id": {
            "type": "string",
            "pattern": "^[1-3]?[A-Z]{2,3}$"
          },
          "canonical_order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 66
          },
          "standard_name": {
            "type": "string"
          },
          "chapter_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          "total_verses": {
            "type": "integer",
            "minimum": 1
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chapter", "verse_count"],
              "properties": {
                "chapter": {
                  "type": "integer",
                  "minimum": 1
                },
                "verse_count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}